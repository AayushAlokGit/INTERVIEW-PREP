        </mxCell>
        <mxCell id="ed7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_pg" target="h_cdc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed7l" value="change stream" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ed7">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
