        </mxCell>
        <mxCell id="ed6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="h_s3" target="h_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed6l" value="upload-complete notification → set status=UPLOADED" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ed6">
