<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="5600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Instagram — Photo &amp; Video Sharing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_fr" value="1 — FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="fr_box" value="&lt;div style=&quot;text-align:left&quot;&gt;1. Users can upload photos and videos, with captions&lt;br&gt;2. Users can follow other users&lt;br&gt;3. Users view a home feed of chronologically sorted posts from people they follow&lt;br&gt;4. Posts can be liked and commented on&lt;br&gt;5. Per-user profile grid of their own posts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="125" width="700" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="oos_box" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Out of scope&lt;/b&gt;&lt;br&gt;1. Analytics on posts&lt;br&gt;2. Recommendation / ranking of posts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="760" y="125" width="420" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="sep1" value="" style="line;strokeWidth=1;html=1;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="20" y="295" width="2160" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_nfr" value="2 — NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="nfr_box" value="&lt;div style=&quot;text-align:left&quot;&gt;1. Highly available for post upload — 99.9% (~8.6 hrs downtime/yr)&lt;br&gt;2. Low latency feed generation — p99 &amp;lt; 200 ms&lt;br&gt;3. Eventual consistency acceptable for posts, likes, comments&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;— except read-your-own-writes needed for posts&lt;br&gt;4. Durable storage for photos and videos&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="355" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="boe_box" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Back-of-envelope&lt;/b&gt;&lt;br&gt;100M DAU · 2 posts/user/day → ~2k posts/s avg, peak 5×&lt;br&gt;Feed: 5 loads/user/day × 10 posts → ~50k post reads/s&lt;br&gt;Post size ~1 MB → ~2 GB/s ingest&lt;br&gt;Storage ≈ 60 PB / year&lt;br&gt;Likes: 20/user/day → ~20k likes/s&lt;br&gt;Comments: 5/user/day → ~5k comments/s&lt;br&gt;Storage strategy: object storage (S3) + hot/cold tiering&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF4E5;strokeColor=#B26B00;" vertex="1" parent="1">
          <mxGeometry x="760" y="355" width="620" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="sep2" value="" style="line;strokeWidth=1;html=1;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="20" y="535" width="2160" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_ent" value="3 — CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="565" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e_user" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br&gt;name&lt;br&gt;email&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="220" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e_post" value="&lt;b&gt;Post&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br&gt;userId&lt;br&gt;text&lt;br&gt;mediaS3Url&lt;br&gt;createdAt&lt;br&gt;likeCount (rolled up)&lt;br&gt;commentCount (rolled up)&lt;br&gt;status: UPLOADING_MEDIA | UPLOADED&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="280" y="600" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e_like" value="&lt;b&gt;Like&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;userId&lt;br&gt;postId&lt;br&gt;&lt;i&gt;unique(userId, postId)&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e_comment" value="&lt;b&gt;Comment&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br&gt;userId&lt;br&gt;postId&lt;br&gt;text&lt;br&gt;createdAt&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="880" y="600" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e_follow" value="&lt;b&gt;FollowRelationship&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;followingUserId&lt;br&gt;followedUserId&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1160" y="600" width="260" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="sep3" value="" style="line;strokeWidth=1;html=1;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="20" y="770" width="2160" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_api" value="4 — API DESIGN&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#666&quot;&gt;(identity taken from JWT auth token)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="api_post" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;POST /posts&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Idempotency-Key header&lt;/i&gt;&lt;br&gt;Req: { text, mediaDetails }&lt;br&gt;Res: presigned S3 URL to upload media (if media present),&lt;br&gt;else 2xx — post created&lt;br&gt;→ client uploads media directly to S3 with presigned URL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="835" width="640" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="api_feed" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;GET /posts?cursor={}&amp;amp;limit={}&lt;/b&gt;&amp;nbsp;&amp;nbsp;(home feed)&lt;br&gt;Res: { Post(id, mediaUrl, text, likeCount, commentCount, createdAt)[],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;nextCursor: &quot;&quot; }&lt;br&gt;Cursor pagination — allows dynamic insertion of posts into feed&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="700" y="835" width="640" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="api_myposts" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;GET /myPosts?page={}&amp;amp;limit={}&lt;/b&gt;&amp;nbsp;&amp;nbsp;(profile grid)&lt;br&gt;Res: Post(id, mediaUrl, text, likeCount, commentCount, createdAt)[]&lt;br&gt;Offset pagination is fine — user is reading their own posts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="1380" y="835" width="640" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="api_follow" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;POST /follow/:userId&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Idempotency-Key header&lt;/i&gt;&lt;br&gt;Res: FollowRelationship(followingUserId, userId)&lt;br&gt;&lt;br&gt;&lt;b&gt;DELETE /follows/:userId&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="975" width="640" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="api_like" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;POST /posts/:id/likes&lt;/b&gt;&lt;br&gt;Res: 2xx — post liked&lt;br&gt;No idempotency key: unique(userId, postId) makes retry fail at DB level&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /posts/:id/likes?cursor={}&amp;amp;limit={}&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;DELETE /posts/likes/userId&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="700" y="975" width="640" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="api_comment" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;POST /posts/:id/comments&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Idempotency-Key header&lt;/i&gt;&lt;br&gt;Req: { commentText }&amp;nbsp;&amp;nbsp;Res: 2xx — post commented&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /posts/:id/comments?cursor={}&amp;amp;limit={}&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;DELETE (comment)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="1380" y="975" width="640" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="sep4" value="" style="line;strokeWidth=1;html=1;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="20" y="1125" width="2160" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_hld" value="5 — HIGH LEVEL DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="1155" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="h_client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_gw" value="API Gateway&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;auth&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="1300" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_api" value="API Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="1300" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_pg" value="PostgreSQL&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Post, User, Like, Comment,&lt;br&gt;FollowRelationship, upload session&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="1180" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="h_replica" value="Read Replicas" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="960" y="1370" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="h_s3" value="S3&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;media blobs · hot/cold tiering&lt;br&gt;multipart + resumable upload&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="1540" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="h_cdc" value="CDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="1200" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_worker" value="Feed Workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1200" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_redis" value="Redis&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;precomputed feed per user&lt;br&gt;TTL 1 day&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1820" y="1180" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="h_note_coalesce" value="On Redis failure: read load falls to DB&lt;br&gt;→ request coalescing at API Service" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#FFF4E5;strokeColor=#B26B00;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="1420" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_client" target="h_gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed1l" value="POST /posts · GET /posts" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ed1">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_gw" target="h_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_api" target="h_pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed3l" value="create Post (status=UPLOADING_MEDIA)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ed3">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint x="10" y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.75;entryY=1;dashed=1;" edge="1" parent="1" source="h_api" target="h_client">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="1450"/><mxPoint x="167" y="1450"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ed4l" value="presigned S3 URL" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ed4">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_client" target="h_s3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="1590"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ed5l" value="upload media directly (presigned URL)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="ed5">
