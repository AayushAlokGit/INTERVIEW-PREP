        <mxCell id="oe10" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_transw" target="o_s3d">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe11" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_s3d" target="o_cdn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe11l" value="origin fetch" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe11">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="oe12" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=0;entryX=0.75;entryY=1;dashed=1;" edge="1" parent="1" source="o_transw" target="o_postdb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe12l" value="status → READY (post becomes feed-eligible)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe12">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint x="140" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="oe13" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_gw" target="o_feedsvc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="3375"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="oe13l" value="GET /v1/feed" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe13">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="oe14" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="o_feedsvc" target="o_feedcache">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="3260"/><mxPoint x="1875" y="3260"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="oe14l" value="ZREVRANGEBYSCORE — precomputed feed" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe14">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-260" y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="oe15" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_feedsvc" target="o_celeb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe15l" value="pull celeb posts" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe15">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="oe16" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_celeb" target="o_counter">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe17" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_counter" target="o_rebuild">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe18" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.25;entryY=1;dashed=1;" edge="1" parent="1" source="o_client" target="o_cdn">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="3500"/><mxPoint x="1440" y="3500"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="oe18l" value="client fetches media bytes straight from CDN (never through the API)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe18">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-180" y="-12" as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="o_hdr_to" value="D — KEY TRADE-OFFS (each choice vs its named alternative)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="3600" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ot1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Hybrid fan-out&lt;/b&gt; vs pure fan-out-on-write / pure fan-out-on-read&lt;br&gt;Pure write: 50M ZADDs for one celebrity post. Pure read: a 500-followee&lt;br&gt;scatter-gather on every feed load, blows the 200 ms budget.&lt;br&gt;&lt;i&gt;Cost: two code paths, a merge, and a threshold that must be tuned.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="3640" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ot2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Transactional outbox → Kafka&lt;/b&gt; vs Postgres CDC vs publish-from-app&lt;br&gt;Publish-from-app loses events if the process dies after COMMIT.&lt;br&gt;CDC works but couples the pipeline to Postgres WAL internals and&lt;br&gt;to the DB&#39;s sharding. Outbox = one txn, replayable, DB-agnostic.&lt;br&gt;&lt;i&gt;Cost: an extra table, a poller, and outbox-table write amplification.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="760" y="3640" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ot3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Redis ZSET&lt;/b&gt; vs a Redis LIST vs re-querying Postgres&lt;br&gt;ZSET scored by a time-sortable postId gives ordered range reads,&lt;br&gt;O(log n) insert, natural dedupe on merge, and a capped size via&lt;br&gt;ZREMRANGEBYRANK. A LIST gives none of that.&lt;br&gt;&lt;i&gt;Cost: more memory per entry than a raw list.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="1500" y="3640" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ot4" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Postgres (sharded)&lt;/b&gt; vs Cassandra for the post store&lt;br&gt;Posts are append-only and time-ordered — Cassandra&#39;s natural shape,&lt;br&gt;and it scales writes linearly. Postgres wins on the &lt;i&gt;follow graph&lt;/i&gt;&lt;br&gt;(secondary indexes both ways) and on transactional outbox semantics.&lt;br&gt;&lt;i&gt;Cost of PG: you own sharding and resharding yourself.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="3820" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ot5" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;CDN&lt;/b&gt; vs serving media from S3 directly&lt;br&gt;50k reads/s × 1 MB ≈ &lt;b&gt;50 GB/s egress&lt;/b&gt;. S3 direct is both slow&lt;br&gt;(one region, no edge) and the single biggest line on the bill.&lt;br&gt;CDN turns per-request S3 egress into a cached edge hit.&lt;br&gt;&lt;i&gt;Cost: invalidation on delete, signed-URL expiry management.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="760" y="3820" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ot6" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Sharded Redis counters&lt;/b&gt; vs UPDATE posts SET likeCount = likeCount + 1&lt;br&gt;20k likes/s concentrated on a viral post = row-lock contention on one&lt;br&gt;Postgres row. Sharded in-memory counters + periodic flush absorb it.&lt;br&gt;&lt;i&gt;Cost: the count is approximate for a few seconds, and you need a&lt;br&gt;reconciliation job because increments are not idempotent under retry.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1500" y="3820" width="700" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="o_hdr_dd" value="E — DEEP DIVES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="4020" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="od1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;1. The scale break, and how it is actually handled&lt;/b&gt;&lt;br&gt;Peak fan-out = 10k posts/s × 1000 followers = &lt;b&gt;10⁷ ZADDs/s&lt;/b&gt;.&lt;br&gt;Levers, in the order a senior applies them:&lt;br&gt;&amp;nbsp;• fan out only to &lt;b&gt;active&lt;/b&gt; followers (lastActiveAt &amp;lt; 7d) → −50%+&lt;br&gt;&amp;nbsp;• &lt;b&gt;batch by shard&lt;/b&gt;: group a post&#39;s followers by Redis shard, one&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;pipelined command per shard instead of N round-trips&lt;br&gt;&amp;nbsp;• &lt;b&gt;lower the celebrity threshold&lt;/b&gt; — the threshold is a &lt;i&gt;dial&lt;/i&gt;, not a&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;binary. At a 10× denser graph (10⁸/s) you move the dial down until&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;most accounts are read-path, and the system converges on&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;fan-out-on-read + a per-user merged-feed cache with a short TTL,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;so one scrolling session pays for the merge once, not per page.&lt;br&gt;&lt;i&gt;This is the answer the round was asking for at the very end.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="4060" width="700" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="od2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;2. Hot keys &amp;amp; hot partitions&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Celebrity post cache&lt;/b&gt; is read by a huge fraction of all feed loads →&lt;br&gt;&amp;nbsp;&amp;nbsp;replicate it to every Redis shard / keep it in the Feed Service&#39;s&lt;br&gt;&amp;nbsp;&amp;nbsp;local in-process cache with a 1–5 s TTL. A single hot key otherwise&lt;br&gt;&amp;nbsp;&amp;nbsp;pins one shard at 100% while the rest idle.&lt;br&gt;• &lt;b&gt;Kafka partitioned by authorId&lt;/b&gt; → a celebrity is a hot partition.&lt;br&gt;&amp;nbsp;&amp;nbsp;Mitigate by routing celebrity posts to a separate low-fan-out topic.&lt;br&gt;• &lt;b&gt;Viral post like counter&lt;/b&gt; → sharded counter (N sub-keys, sum on read).&lt;br&gt;• &lt;b&gt;Thundering herd&lt;/b&gt;: a celebrity posts and 10M dormant feeds miss at&lt;br&gt;&amp;nbsp;&amp;nbsp;once → single-flight / request coalescing keyed by userId, plus&lt;br&gt;&amp;nbsp;&amp;nbsp;jittered TTLs so keys don&#39;t expire in lockstep.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="760" y="4060" width="700" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="od3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;3. Consistency model&lt;/b&gt;&lt;br&gt;• Feed: eventually consistent, target &amp;lt; 5 s post→feed p99.&lt;br&gt;• &lt;b&gt;Read-your-own-writes&lt;/b&gt;: the author&#39;s own new post is injected&lt;br&gt;&amp;nbsp;&amp;nbsp;into their feed synchronously on the write path (or the client&lt;br&gt;&amp;nbsp;&amp;nbsp;optimistically renders it) — never wait on the fan-out worker.&lt;br&gt;• &lt;b&gt;At-least-once everywhere&lt;/b&gt;: ZADD is idempotent (same member,&lt;br&gt;&amp;nbsp;&amp;nbsp;same score) — but &lt;b&gt;counter increments are not&lt;/b&gt;. Dedupe on&lt;br&gt;&amp;nbsp;&amp;nbsp;event id, or store the absolute count rather than a delta.&lt;br&gt;• &lt;b&gt;Unfollow&lt;/b&gt; must remove the followee&#39;s posts from a cached feed,&lt;br&gt;&amp;nbsp;&amp;nbsp;or filter at read time — otherwise stale posts linger for the TTL.&lt;br&gt;• &lt;b&gt;Deleted post&lt;/b&gt; stays in N cached ZSETs → filter at hydrate time&lt;br&gt;&amp;nbsp;&amp;nbsp;(the hydrate step is the authoritative visibility check).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="1500" y="4060" width="700" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="od4" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;4. Operability &amp;amp; monitoring — with thresholds, not prose&lt;/b&gt;&lt;br&gt;&amp;nbsp;• &lt;b&gt;post→feed lag&lt;/b&gt; p99, measured end-to-end. Page at &amp;gt; 60 s sustained 5 min; warn at 10 s.&lt;br&gt;&amp;nbsp;• &lt;b&gt;Kafka consumer lag&lt;/b&gt; per partition — autoscale fan-out workers on lag, not on CPU. Backpressure plan: shed fan-out&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;to inactive users first (they will get a rebuilt feed on next open anyway) — graceful degradation, not a queue meltdown.&lt;br&gt;&amp;nbsp;• &lt;b&gt;Feed cache hit rate&lt;/b&gt; — a drop means rebuild traffic is about to hit Postgres. Alert below 90%.&lt;br&gt;&amp;nbsp;• &lt;b&gt;Transcode queue depth + DLQ rate&lt;/b&gt; — a stuck transcoder means posts silently never become visible. Alert on any DLQ growth.&lt;br&gt;&amp;nbsp;• &lt;b&gt;Correctness canary&lt;/b&gt;: a synthetic account posts every minute and a synthetic follower asserts the post appears within SLA.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;This is how you know the feed is &lt;i&gt;wrong&lt;/i&gt; rather than merely slow.&lt;br&gt;&amp;nbsp;• &lt;b&gt;Cost&lt;/b&gt;: ~5 TB Redis cluster, ~60 PB/yr S3 with lifecycle to IA/Glacier, and CDN egress as the dominant line item —&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;which is exactly why the CDN hit rate is itself a business metric worth alerting on.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="20" y="4390" width="2180" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
