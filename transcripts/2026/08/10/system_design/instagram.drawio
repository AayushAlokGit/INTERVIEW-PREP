        <mxCell id="ed8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_cdc" target="h_worker">
          <mxGeometry relative="1" as="geometry"/>
