        <mxCell id="oe6" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_fanout" target="o_feedcache">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
