        <mxCell id="sep5" value="" style="line;strokeWidth=1;html=1;strokeColor=#CCCCCC;" vertex="1" parent="1">
          <mxGeometry x="20" y="1690" width="2160" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="hdr_dd" value="6 — DEEP DIVE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="1720" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="dd1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Celebrity fan-out&lt;/b&gt;&lt;br&gt;Fan-out-on-write fails for high-follower accounts (50M keys per post).&lt;br&gt;Classify users above a followerCount threshold as celebrities.&lt;br&gt;Write path: skip fan-out for celebrity posts.&lt;br&gt;Read path: look up celebrities the user follows (FollowRelationship),&lt;br&gt;fetch their posts, merge with the precomputed Redis feed.&lt;br&gt;&lt;i&gt;Trade-off: write fan-out removed, complexity moved to read time.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="1755" width="700" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="dd2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Merged cursor &amp;amp; threshold crossing&lt;/b&gt;&lt;br&gt;Cursor = postId + createdAt, spanning both the celebrity list&lt;br&gt;and the Redis feed.&lt;br&gt;&lt;br&gt;When a user crosses the celebrity threshold: their older posts&lt;br&gt;are already in followers&#39; Redis feeds, new ones take the merge&lt;br&gt;path → merge the two lists as a union, dropping duplicates.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="760" y="1755" width="700" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="dd3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Sizing&lt;/b&gt;&lt;br&gt;Fan-out: peak 10k posts/s × 1000 followers = &lt;b&gt;10⁷ Redis writes/s&lt;/b&gt;&lt;br&gt;Redis memory: 100M users × 50 posts × 1 KB = &lt;b&gt;~5 TB&lt;/b&gt;&lt;br&gt;→ single instance insufficient → Redis cluster sharded by userId&lt;br&gt;&lt;br&gt;&lt;b&gt;Optimisation:&lt;/b&gt; fan out only to recently-active users&lt;br&gt;(assume ~50% inactive → fan-out cut ~50%)&lt;br&gt;Dormant user returns → cache miss → GET /posts queries the DB,&lt;br&gt;generates the feed, repopulates Redis (slower initial load)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF4E5;strokeColor=#B26B00;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1755" width="700" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="dd4" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Operability&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;Metric: delay between post creation and the post being written to Redis — how far the feed pipeline is lagging.&lt;br&gt;Under lag, users see followers&#39; posts on a delay — consistent with the eventual-consistency NFR for posts.&lt;br&gt;Auto-mitigation: scale up worker nodes based on CDC queue depth.&lt;br&gt;&lt;br&gt;&lt;b&gt;Remaining bottleneck (stated):&lt;/b&gt; likes and comments.&amp;nbsp;&amp;nbsp;&lt;b&gt;At 10× denser graph (10⁸ writes/s):&lt;/b&gt; the write-side feed update cannot be removed without blowing the read latency budget — no alternative reached.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="1965" width="2180" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="bigsep" value="" style="line;strokeWidth=4;html=1;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="2160" width="2450" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="hdr_opt" value="OPTIMAL REFERENCE — what a senior strong-hire would design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=20;fontStyle=1;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="2190" width="1400" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="o_hdr_ent" value="A — CORE ENTITIES (with the fields that were missed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="2260" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="oe_user" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id, handle, name, email&lt;br&gt;&lt;b&gt;followerCount&lt;/b&gt; (denormalised)&lt;br&gt;&lt;b&gt;isCelebrity&lt;/b&gt; (derived from threshold)&lt;br&gt;&lt;b&gt;lastActiveAt&lt;/b&gt; (drives fan-out policy)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="20" y="2300" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="oe_post" value="&lt;b&gt;Post&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id (&lt;b&gt;time-sortable, e.g. Snowflake&lt;/b&gt;)&lt;br&gt;authorId, caption, createdAt&lt;br&gt;&lt;b&gt;media[]&lt;/b&gt; — a post is a carousel, not one blob&lt;br&gt;status: PENDING | READY | FAILED&lt;br&gt;likeCount, commentCount (denormalised)&lt;br&gt;&lt;b&gt;visibility&lt;/b&gt; (public / private account)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="360" y="2300" width="340" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="oe_media" value="&lt;b&gt;Media&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;font-size:10px&quot;&gt;(missed entirely)&lt;/span&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id, postId, type: PHOTO | VIDEO&lt;br&gt;originalKey (S3)&lt;br&gt;&lt;b&gt;renditions[]&lt;/b&gt; {resolution, bitrate, cdnUrl}&lt;br&gt;transcodeStatus, durationMs&lt;br&gt;width, height, blurhash&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="740" y="2300" width="340" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="oe_like" value="&lt;b&gt;Like&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;userId, postId, createdAt&lt;br&gt;PK(postId, userId) — natural idempotency&lt;br&gt;&lt;i&gt;count kept as a sharded counter,&lt;br&gt;not a single hot row&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1120" y="2300" width="320" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="oe_comment" value="&lt;b&gt;Comment&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id, postId, authorId, text, createdAt&lt;br&gt;parentCommentId (threading)&lt;br&gt;PK(postId, id) — clustered for range read&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1480" y="2300" width="320" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="oe_follow" value="&lt;b&gt;Follow&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;followerId, followeeId, createdAt&lt;br&gt;&lt;b&gt;two indexes&lt;/b&gt;: (followerId) for &quot;who I follow&quot;,&lt;br&gt;(followeeId) for fan-out target list&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1840" y="2300" width="330" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="o_hdr_api" value="B — API DESIGN (explicit shapes; endpoints that were skipped or left vague are marked ★)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="2520" width="1200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="oa1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;POST /v1/posts&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Idempotency-Key&lt;/i&gt;&lt;br&gt;Req { caption, media:[{type,filename,sizeBytes}] }&lt;br&gt;201 { postId, status:&quot;PENDING&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;uploads:[{mediaId, presignedUrl, expiresAt,&lt;br&gt;&amp;nbsp;&amp;nbsp;partSize, uploadId}] }&lt;br&gt;&lt;br&gt;★&lt;b&gt; POST /v1/posts/:id/complete&lt;/b&gt;&lt;br&gt;client signals upload done → belt-and-braces&lt;br&gt;alongside the S3 event&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="2560" width="680" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="oa2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;GET /v1/feed?cursor=&amp;amp;limit=20&lt;/b&gt;&lt;br&gt;200 {&lt;br&gt;&amp;nbsp;items:[{ postId, author:{id,handle,avatarUrl},&lt;br&gt;&amp;nbsp;&amp;nbsp;caption, media:[{cdnUrl, w, h, type, blurhash}],&lt;br&gt;&amp;nbsp;&amp;nbsp;likeCount, commentCount, viewerHasLiked,&lt;br&gt;&amp;nbsp;&amp;nbsp;createdAt }],&lt;br&gt;&amp;nbsp;nextCursor: &quot;&lt;i&gt;opaque, base64&lt;/i&gt;&quot;, hasMore: true }&lt;br&gt;&lt;br&gt;Cursor is &lt;b&gt;opaque&lt;/b&gt; and encodes BOTH sources:&lt;br&gt;{ redisOffset, celebLastPostId, snapshotTs }&lt;br&gt;→ pagination is stable across a live-changing feed&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="740" y="2560" width="700" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="oa3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;GET /v1/users/:id/posts?cursor=&amp;amp;limit=&lt;/b&gt;&amp;nbsp;(profile grid)&lt;br&gt;200 { items:[{postId, thumbnailUrl, type}], nextCursor }&lt;br&gt;&lt;i&gt;— works for any user, not just self; thumbnails only&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PUT /v1/posts/:id/like&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;★&lt;b&gt;DELETE /v1/posts/:id/like&lt;/b&gt;&lt;br&gt;PUT not POST → idempotent by verb, no key needed&lt;br&gt;200 { likeCount, viewerHasLiked }&lt;br&gt;&lt;br&gt;★&lt;b&gt;GET /v1/posts/:id/comments?cursor=&amp;amp;limit=&lt;/b&gt;&lt;br&gt;200 { items:[{id, author, text, createdAt, replyCount}], nextCursor }&lt;br&gt;★&lt;b&gt;DELETE /v1/comments/:commentId&lt;/b&gt; → 204&lt;br&gt;&lt;b&gt;PUT /v1/users/:id/follow&lt;/b&gt; · ★&lt;b&gt;DELETE /v1/users/:id/follow&lt;/b&gt; → 204&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E9F5E4;strokeColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="1480" y="2560" width="700" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="o_hdr_hld" value="C — OPTIMAL HIGH-LEVEL DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#2D7600;" vertex="1" parent="1">
          <mxGeometry x="20" y="2830" width="800" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="lane_w" value="WRITE PATH" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="20" y="2880" width="200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="o_client" value="Client&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;mobile / web&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="2920" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_gw" value="API Gateway&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;auth · rate limit · TLS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="2920" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_postsvc" value="Post Service&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;create post · presign · complete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="2920" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_postdb" value="Post / Graph Store&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Postgres (sharded by userId)&lt;br&gt;posts · follows · comments&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="2890" width="230" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="o_outbox" value="Outbox → Kafka&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;post.created topic&lt;br&gt;partitioned by authorId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="2890" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="o_fanout" value="Fan-out Workers&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;skip celebrities&lt;br&gt;skip inactive followers&lt;br&gt;pipelined ZADD, batched&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="2890" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="o_feedcache" value="Feed Cache&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Redis Cluster, sharded by userId&lt;br&gt;ZSET feed:{userId} → score=postId&lt;br&gt;capped at 500 · TTL 7d · ~5 TB&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1810" y="2880" width="260" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="o_s3" value="S3 (originals)&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;multipart · resumable&lt;br&gt;lifecycle → IA → Glacier&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="3110" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="o_transq" value="Transcode Queue&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;S3 event → SQS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="560" y="3110" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="o_transw" value="Transcode Workers&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;video → HLS ladder&lt;br&gt;image → thumb/med/full&lt;br&gt;retries + DLQ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="3110" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="o_s3d" value="S3 (renditions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="1120" y="3110" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="o_cdn" value="CDN&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;signed URLs · ~50 GB/s egress&lt;br&gt;&lt;b&gt;THE read path for bytes&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="3110" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="lane_r" value="READ PATH" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="20" y="3290" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="o_feedsvc" value="Feed Service&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;merge + dedupe + hydrate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="3330" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="o_celeb" value="Celebrity Post Cache&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Redis: recent posts per celeb&lt;br&gt;tiny set, extremely hot,&lt;br&gt;replicated to every shard&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="850" y="3310" width="240" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="o_counter" value="Counter Service&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Redis sharded counters&lt;br&gt;like/comment counts&lt;br&gt;flushed to DB periodically&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="3310" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="o_rebuild" value="Feed Rebuilder&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;cache miss → query followees&#39;&lt;br&gt;recent posts, k-way merge,&lt;br&gt;repopulate ZSET&lt;br&gt;single-flight per userId&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1500" y="3310" width="240" height="130" as="geometry"/>
