        </mxCell>
        <mxCell id="oe7l" value="direct multipart upload (presigned)" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe7">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="oe8" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_s3" target="o_transq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe8l" value="ObjectCreated event" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="oe8">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="oe9" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_transq" target="o_transw">
          <mxGeometry relative="1" as="geometry"/>
