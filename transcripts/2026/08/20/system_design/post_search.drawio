<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="4200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="POST SEARCH" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="1. Users can create short text posts.&#10;2. Users can issue multiple free-text keywords in a query; posts matching ALL query terms are returned." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#F5F9FF;strokeColor=#7EA6E0;" vertex="1" parent="1">
          <mxGeometry x="20" y="125" width="700" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="OUT OF SCOPE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="1. Searching posts by author." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="760" y="125" width="400" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="225" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="1. Highly available for post searching (99.99). Lower availability for post creation acceptable (99.9).&#10;2. Posts should be durably stored.&#10;3. Eventual consistency acceptable for post search.&#10;4. Low latency post search (p99 &lt; 500ms)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#F5F9FF;strokeColor=#7EA6E0;" vertex="1" parent="1">
          <mxGeometry x="20" y="260" width="700" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="22" value="TRAFFIC MODEL (his numbers)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="760" y="225" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="500M DAU, 2 posts/user/day, 300 B/post&#10;  -&gt; 10k posts/s avg, peak 3x -&gt; 3 MB/s&#10;  -&gt; 300 GB/day ~ 90 TB/year&#10;5B searches/day -&gt; 50k searches/s&#10;  assuming each search returns 2 posts -&gt; 100k post reads/s&#10;Read:write ratio 10:1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#F5F9FF;strokeColor=#7EA6E0;" vertex="1" parent="1">
          <mxGeometry x="760" y="260" width="500" height="110" as="geometry"/>
        </mxCell>


        <mxCell id="30" value="CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="User&#10;- id&#10;- name&#10;- email" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="20" y="435" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="Post&#10;- id&#10;- text&#10;- userId&#10;- createdAt   (ordering field)&#10;&#10;inverted index on text" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="300" y="435" width="300" height="130" as="geometry"/>
