        <mxCell id="41" value="POST /posts&#10;  body     -&gt; { text: string }&#10;  response -&gt; 201 { postId }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="20" y="635" width="560" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="GET /search?terms={terms}&amp;pageSize=&amp;cursor=&#10;  response -&gt; 200 { posts: [ { postId, text, userId, createdAt } ], nextCursor }" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="620" y="635" width="640" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="Errors: 400 invalid request · 401 unauthenticated · 429 rate limited · 500 internal server error&#10;Identity from JWT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
