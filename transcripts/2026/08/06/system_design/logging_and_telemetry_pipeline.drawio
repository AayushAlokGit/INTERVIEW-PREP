<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="4800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="Distributed Logging &amp; Telemetry Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Mock round 2026-08-06 &#183; 40 min" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="700" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="4" value="PART A &#8212; AAYUSH&#39;S DESIGN (as described in the round)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontSize=16;fontStyle=1;fontColor=#FFFFFF;fillColor=#1F4E79;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="2400" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="1 &#183; FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;div style=&#39;text-align:left&#39;&gt;1. Ingest logs, metrics, traces from service machines across a company&#39;s fleet&lt;br&gt;&lt;br&gt;2. Store the logs, metrics and traces durably&lt;br&gt;&lt;br&gt;3. Allow engineer to query the metrics timeseries and logs and traces&lt;br&gt;&lt;br&gt;4. Support dashboards on metrics (last 1h / 24h / 7d)&lt;br&gt;&lt;br&gt;5. Support raising alerts on metrics&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#7EA6D9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="195" width="820" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="Out of scope: never stated" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fontColor=#B85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="600" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="2 &#183; NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="960" y="160" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="&lt;div style=&#39;text-align:left&#39;&gt;1. Highly available for event ingestion (99.99% ~ 52 min downtime/year)&lt;br&gt;&lt;br&gt;2. Data freshness latency ~ 3 min (event reflected in dashboard within 3 min)&lt;br&gt;&lt;br&gt;3. Alert raised within 1 min of metric threshold being breached&lt;br&gt;&lt;br&gt;4. Low latency query time &amp;lt; 1 min&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E8F1FA;strokeColor=#7EA6D9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="195" width="820" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="NFR 2 (3 min freshness) and NFR 3 (1 min alert) were never reconciled" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fontColor=#B85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="960" y="350" width="820" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="30" value="3 &#183; SCALE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;Inputs (supplied by interviewer after two requests for help):&lt;/b&gt;&lt;br&gt;&lt;br&gt;10,000 hosts &#183; 500 services &#183; 1,000,000 req/s peak&lt;br&gt;Metrics: 200 series/host, 10 s scrape, ~100 B/point&lt;br&gt;Logs: 100 lines/s/host, ~500 B/line&lt;br&gt;Traces: 1% sampled, ~10 spans/trace, ~300 B/span&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="400" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;Correct derived totals:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Metrics&#160;&#160;&#160;200 K/s&#160;&#160;&#160;20 MB/s&#160;&#160;&#160;1.7 TB/day&lt;br&gt;Logs&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;1 M/s&#160;&#160;500 MB/s&#160;&#160;&#160;&#160;43 TB/day&lt;br&gt;Traces&#160;&#160;&#160;&#160;&#160;100 K/s&#160;&#160;&#160;30 MB/s&#160;&#160;&#160;2.6 TB/day&lt;br&gt;&lt;b&gt;Total&#160;&#160;&#160;&#160;&#160;&#160;1.3 M/s&#160;&#160;~550 MB/s&#160;&#160;~47 TB/day&lt;/b&gt;&lt;br&gt;&lt;br&gt;Retention stated: logs 15 d, traces 15 d. Metrics: never given.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="460" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;First pass (incorrect, defended when challenged):&lt;/b&gt;&lt;br&gt;&lt;br&gt;Metrics 20 GB/s&#160;&#160;&#8212; 1,000&#215; too high&lt;br&gt;Logs&#160;&#160;&#160;&#160;500 GB/s&#160;&#8212; 1,000&#215; too high (= 43 PB/day)&lt;br&gt;Traces&#160;&#160;300 GB/s&#160;&#8212; 10,000&#215; too high&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="460" width="440" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="40" value="4 &#183; CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="1400" y="425" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="NEVER PRODUCED&#10;(asked three times)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;fontColor=#B85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="460" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="5 &#183; API DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="1760" y="425" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="NEVER PRODUCED&#10;(asked three times)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;fontColor=#B85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1760" y="460" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="50" value="6 &#183; HIGH-LEVEL DESIGN &#8212; logs path only (metrics, traces and alerting were never designed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="51" value="Agent on host&#10;(aggregates logs,&#10;tracks what has&#10;been sent)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="52" value="Ingesting&#10;Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="720" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="53" value="Kafka&#10;partitioned by machineId&#10;(preserves per-machine&#10;log ordering)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="705" width="200" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="54" value="Consumer&#10;process&#10;(polls Kafka)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="980" y="720" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="55" value="OLAP DB&#10;(never named;&#10;no alternative given)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1280" y="705" width="200" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="56" value="Engineer&#10;query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1600" y="720" width="160" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="51" target="52">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="61l" value="push logs" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" connectable="0" parent="61">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="52" target="53">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;dashed=1;" edge="1" parent="1" source="53" target="54">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="63l" value="poll" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" connectable="0" parent="63">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="54" target="55">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="64l" value="write" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" connectable="0" parent="64">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;dashed=1;" edge="1" parent="1" source="55" target="56">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="65l" value="query" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" connectable="0" parent="65">
          <mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="70" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;Questions asked and left unanswered:&lt;/b&gt;&lt;br&gt;&#8226; What happens to a log line when the datastore stalls for 10 min?&lt;br&gt;&#8226; Which OLAP DB, and over what alternative?&lt;br&gt;&#8226; One service 100&#215;s its log rate &#8212; what breaks first, and what does the engineer see?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="900" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="100" value="PART B &#8212; OPTIMAL REFERENCE (what a senior strong-hire would design)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontSize=16;fontStyle=1;fontColor=#FFFFFF;fillColor=#38761D;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="2400" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="110" value="B1 &#183; CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#38761D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="111" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;MetricSeries&lt;/b&gt; &#8212; the identity, not the data&lt;br&gt;&#160;&#160;series_id&#160;&#160;&#160;&#160;&#160;uint64 (hash of name + sorted tags)&lt;br&gt;&#160;&#160;name&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;http_request_duration_ms&lt;br&gt;&#160;&#160;tags&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;{service, region, endpoint, status, host}&lt;br&gt;&#160;&#160;type&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;counter | gauge | histogram&lt;br&gt;&lt;br&gt;&lt;i&gt;Cardinality is the whole game: 10K hosts &#215; 200 series&lt;br&gt;= 2 M active series. Tag combinations multiply it.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1155" width="560" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="112" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;MetricPoint&lt;/b&gt; &#8212; the data, kept tiny&lt;br&gt;&#160;&#160;series_id&#160;&#160;&#160;&#160;&#160;uint64&lt;br&gt;&#160;&#160;ts&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;int64 (delta-encoded)&lt;br&gt;&#160;&#160;value&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;float64 (XOR-encoded, Gorilla)&lt;br&gt;&lt;br&gt;&lt;i&gt;Tags live on the series, never repeated per point.&lt;br&gt;This is why 100 B/point on the wire becomes&lt;br&gt;~2 B/point at rest &#8212; ~50&#215; compression.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="1155" width="560" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="113" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;LogEvent&lt;/b&gt;&lt;br&gt;&#160;&#160;ts, level, service, host, trace_id, span_id&lt;br&gt;&#160;&#160;message&#160;&#160;&#160;&#160;&#160;&#160;text (full-text indexed)&lt;br&gt;&#160;&#160;fields&#160;&#160;&#160;&#160;&#160;&#160;&#160;map&amp;lt;string,string&amp;gt;&lt;br&gt;&#160;&#160;ingest_id&#160;&#160;&#160;&#160;uuid (agent-generated, for dedup)&lt;br&gt;&lt;br&gt;&lt;i&gt;trace_id is the join key across all three pillars.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1155" width="560" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="114" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b&gt;Span&lt;/b&gt;&lt;br&gt;&#160;&#160;trace_id, span_id, parent_span_id&lt;br&gt;&#160;&#160;service, operation, start_ts, duration_ms&lt;br&gt;&#160;&#160;status, attributes&lt;br&gt;&lt;br&gt;&lt;b&gt;AlertRule&lt;/b&gt;&lt;br&gt;&#160;&#160;rule_id, query (PromQL-like), threshold,&lt;br&gt;&#160;&#160;comparator, for_duration, severity,&lt;br&gt;&#160;&#160;notification_channel, state (OK|PENDING|FIRING)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1840" y="1155" width="560" height="185" as="geometry"/>
        </mxCell>

        <mxCell id="120" value="B2 &#183; API DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#38761D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1390" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="121" value="&lt;div style=&#39;text-align:left;font-family:monospace&#39;&gt;&lt;b&gt;INGEST (write path)&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /v1/ingest&lt;br&gt;Headers: Authorization: Bearer &amp;lt;host-cert-token&amp;gt;&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Content-Encoding: zstd&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;X-Batch-Id: &amp;lt;uuid&amp;gt;&#160;&#160;&#8592; idempotency key&lt;br&gt;&lt;br&gt;Body (protobuf/OTLP, batched):&lt;br&gt;{ resource: { service, host, region },&lt;br&gt;&#160;&#160;logs:&#160;&#160;&#160;&#160;[ {ts, level, message, fields, trace_id} ],&lt;br&gt;&#160;&#160;metrics: [ {name, tags, points:[{ts,value}]} ],&lt;br&gt;&#160;&#160;spans:&#160;&#160;&#160;[ {trace_id, span_id, parent, ...} ] }&lt;br&gt;&lt;br&gt;200 { accepted: 4812, rejected: 3,&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;errors: [{index, reason}] }&lt;br&gt;429 { retry_after_ms: 2000 }&#160;&#8592; backpressure signal&lt;br&gt;503 &#8592; agent must buffer and retry w/ same X-Batch-Id&lt;br&gt;&lt;br&gt;&lt;i&gt;Identity comes from the mTLS cert, never the body.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1425" width="560" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="122" value="&lt;div style=&#39;text-align:left;font-family:monospace&#39;&gt;&lt;b&gt;METRIC QUERY (dashboards)&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /v1/metrics/query&lt;br&gt;{ query: &quot;p99(http_request_duration_ms{service=&#39;checkout&#39;})&quot;,&lt;br&gt;&#160;&#160;start: &quot;2026-08-06T13:00:00Z&quot;,&lt;br&gt;&#160;&#160;end:&#160;&#160;&#160;&quot;2026-08-06T14:00:00Z&quot;,&lt;br&gt;&#160;&#160;step_s: 60,&lt;br&gt;&#160;&#160;group_by: [&quot;region&quot;] }&lt;br&gt;&lt;br&gt;200 {&lt;br&gt;&#160;&#160;series: [&lt;br&gt;&#160;&#160;&#160;&#160;{ tags: {region:&quot;us-east&quot;},&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;points: [[1754487600, 143.2], [1754487660, 151.8]] }&lt;br&gt;&#160;&#160;],&lt;br&gt;&#160;&#160;resolution_s: 60,&lt;br&gt;&#160;&#160;partial: false,&#160;&#160;&#8592; true if shards timed out&lt;br&gt;&#160;&#160;max_ts_ingested: 1754487720&#160;&#8592; freshness, explicit&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;i&gt;POST not GET: queries exceed URL length. &lt;br&gt;`partial` + `max_ts_ingested` let the UI show&lt;br&gt;&quot;data may be incomplete&quot; instead of lying.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="1425" width="560" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="123" value="&lt;div style=&#39;text-align:left;font-family:monospace&#39;&gt;&lt;b&gt;LOG SEARCH (incident debugging)&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /v1/logs/search&lt;br&gt;{ query: &quot;level:ERROR AND trace_id:4bf92f35...&quot;,&lt;br&gt;&#160;&#160;start, end,&#160;&#160;&#8592; REQUIRED, capped at 24 h span&lt;br&gt;&#160;&#160;limit: 100,&lt;br&gt;&#160;&#160;cursor: &quot;eyJ0cyI6MTc1NDQ4NzYwMCwiaWQiOi4uLn0=&quot; }&lt;br&gt;&lt;br&gt;200 {&lt;br&gt;&#160;&#160;results: [ {ts, level, service, host,&lt;br&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;trace_id, message, fields} ],&lt;br&gt;&#160;&#160;next_cursor: &quot;...&quot; | null,&lt;br&gt;&#160;&#160;approx_total: 48213,&lt;br&gt;&#160;&#160;scanned_bytes: 2147483648&#160;&#8592; cost visibility&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;b&gt;TRACES&lt;/b&gt;&lt;br&gt;GET /v1/traces/{trace_id}&#160;&#8594; full span tree&lt;br&gt;GET /v1/traces?service=&amp;amp;min_duration_ms=&amp;amp;start=&amp;amp;end=&lt;br&gt;&lt;br&gt;&lt;i&gt;Cursor not offset: data is append-heavy and&lt;br&gt;shifting; offset paging re-reads and skips rows.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1425" width="560" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="124" value="&lt;div style=&#39;text-align:left;font-family:monospace&#39;&gt;&lt;b&gt;ALERT RULES (CRUD)&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST&#160;&#160;&#160;/v1/alert-rules&lt;br&gt;{ name: &quot;checkout p99 latency&quot;,&lt;br&gt;&#160;&#160;query: &quot;p99(http_request_duration_ms{service=&#39;checkout&#39;})&quot;,&lt;br&gt;&#160;&#160;comparator: &quot;&amp;gt;&quot;, threshold: 500,&lt;br&gt;&#160;&#160;for_duration_s: 300,&lt;br&gt;&#160;&#160;eval_interval_s: 30,&lt;br&gt;&#160;&#160;severity: &quot;P2&quot;, channel: &quot;pd://checkout-oncall&quot; }&lt;br&gt;&#8594; 201 { rule_id, state: &quot;OK&quot; }&lt;br&gt;&lt;br&gt;GET&#160;&#160;&#160;&#160;/v1/alert-rules?limit=50&amp;amp;cursor=&lt;br&gt;PUT&#160;&#160;&#160;&#160;/v1/alert-rules/{rule_id}&lt;br&gt;DELETE /v1/alert-rules/{rule_id}&lt;br&gt;GET&#160;&#160;&#160;&#160;/v1/alerts?state=FIRING&#160;&#8594; active incidents&lt;br&gt;&lt;br&gt;&lt;i&gt;for_duration is what stops a 1-scrape blip&lt;br&gt;from paging someone at 3am.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1840" y="1425" width="560" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="130" value="B3 &#183; HIGH-LEVEL DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#38761D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1805" width="600" height="30" as="geometry"/>
