<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="720" dy="165" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="4800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Price Tracking Service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
                    <mxGeometry x="40" y="90" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="FR1 — Users can add products they want tracked, with the URL of the product&#xa;on the e-commerce site from where tracking needs to be done.&#xa;&#xa;FR2 — Users can choose to be notified when price of a product &lt;= set target price.&#xa;&#xa;FR3 — Users can view product price history as a chart&#xa;(any time window within the last 2 years)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F1FA;strokeColor=#6C8EBF;" vertex="1" parent="1">
                    <mxGeometry x="40" y="125" width="700" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="OUT OF SCOPE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
                    <mxGeometry x="800" y="90" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="(none stated)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontColor=#808080;" vertex="1" parent="1">
                    <mxGeometry x="800" y="125" width="480" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
                    <mxGeometry x="40" y="330" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="NFR1 — Highly available for detecting price change (99.99%).&#xa;For price chart and user notification, lower availability acceptable.&#xa;&#xa;NFR2 — Freshness latency for price-change notification: 5 min.&#xa;Price chart latency p99 &lt; 1s.&#xa;&#xa;NFR3 — Eventual consistency acceptable for price-points data.&#xa;&#xa;NFR4 — Price data retained for 2 years." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
                    <mxGeometry x="40" y="365" width="700" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="SCALE / TRAFFIC MODEL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
                    <mxGeometry x="800" y="330" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="GIVENS (fixed for this round)&#10;&#10;1. 100M registered users, 10M DAU&#10;2. 20 tracked products per user (avg)&#10;3. 50M distinct product URLs across all users&#10;4. A product&#39;s price changes ~once per week (avg)&#10;5. Chart views: 2 per DAU per day&#10;6. Retention: 2 years of price history&#10;7. Peak-to-average 3x; on Black Friday price-change rate 20x normal&#10;&#10;Convention: a day = 10^5 seconds&#10;&#10;Derived numbers (QPS, storage, poll rate, fanout) are the&#10;candidate&#39;s to compute." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="800" y="365" width="580" height="300" as="geometry"/>
        </mxCell>
                <mxCell id="30" value="CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
                    <mxGeometry x="40" y="610" width="500" height="30" as="geometry"/>
                </mxCell>
