        </mxCell>

        <mxCell id="80" value="1 - OPTIMAL CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="1935" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="81" value="User" style="swimlane;html=1;startSize=28;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1975" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="81a" value="id&#10;name, email, pushToken&#10;notificationPrefs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="81">
          <mxGeometry x="0" y="28" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="82" value="Product (one row per unique URL)" style="swimlane;html=1;startSize=28;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="1975" width="380" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="82a" value="id&#10;canonicalUrl     (unique key - dedups polling)&#10;retailerDomain   (drives per-domain rate limit)&#10;+ lastKnownPrice   &lt;&lt; MISSING in his model&#10;+ lastPolledAt     &lt;&lt; MISSING&#10;+ nextPollAt       &lt;&lt; MISSING - the scheduler key&#10;+ pollIntervalSec  (adaptive: volatile 5m, dead 1d)&#10;+ parserVersion    (detect markup breakage)&#10;createdAt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="82">
          <mxGeometry x="0" y="28" width="380" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="83" value="PriceSubscription" style="swimlane;html=1;startSize=28;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="1975" width="420" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="83a" value="id&#10;productId, userId&#10;targetPrice&#10;+ armed: bool      &lt;&lt; THE MISSING FIELD&#10;                   false after firing; re-armed only&#10;                   when price rises back above target.&#10;                   Without it you notify every 5 min&#10;                   forever while price sits below target.&#10;+ lastNotifiedAt&#10;createdAt&#10;INDEX (productId, targetPrice) -- range query, not scan" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="83">
          <mxGeometry x="0" y="28" width="420" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="84" value="PriceChange (NOT PriceSample)" style="swimlane;html=1;startSize=28;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1975" width="440" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="84a" value="productId   (partition key)&#10;timestamp   (clustering key, DESC)&#10;price&#10;&#10;Written ONLY when price != lastKnownPrice.&#10;~104 rows/yr/product instead of 105,000.&#10;550 TB  ---&gt;  ~500 GB   (1000x)&#10;A price chart is a STEP FUNCTION: the change&#10;points ARE the complete information." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="84">
          <mxGeometry x="0" y="28" width="440" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="85" value="PriceRollup (daily pre-aggregate)" style="swimlane;html=1;startSize=28;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1740" y="1975" width="400" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="85a" value="productId, day&#10;open, close, min, max&#10;&#10;Serves any long window in ~730 rows.&#10;A chart is ~1000 px wide - more points&#10;than that is data you pay to ship and&#10;the client pays to throw away." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Courier New;fontSize=11;" vertex="1" parent="85">
          <mxGeometry x="0" y="28" width="400" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="90" value="2 - OPTIMAL API DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="2250" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="91" value="Identity from JWT on every endpoint.&#10;&#10;POST   /v1/subscriptions                     Idempotency-Key: &lt;uuid&gt;&#10;  req  { productUrl, targetPrice }&#10;  201  { id, productId, targetPrice, armed, createdAt }&#10;  409  URL already tracked by this user    422  unparseable / unsupported retailer&#10;&#10;PATCH  /v1/subscriptions/:id&#10;  req  { targetPrice }                 &lt;-- id in the PATH (his PUT had none)&#10;  200  { id, productId, targetPrice, armed }&#10;  404  not found / not owned    422  targetPrice &lt;= 0&#10;&#10;DELETE /v1/subscriptions/:id          -&gt; 204        (he had no delete)&#10;&#10;GET    /v1/subscriptions?cursor=&amp;limit=50          (he had no list)&#10;  200  { items: Subscription[], nextCursor }&#10;&#10;GET    /v1/products/:id/prices?from=&amp;to=&amp;resolution=auto|raw|hourly|daily&#10;  200  { points: [{t, price}], resolution, nextCursor }&#10;       resolution=auto -&gt; server picks rollup granularity from window width,&#10;       so a 2-year window returns ~730 points, NOT 220,000.&#10;       This is the endpoint that makes p99 &lt; 1s true instead of hoped-for." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Courier New;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2290" width="1100" height="420" as="geometry"/>
        </mxCell>

        <mxCell id="92" value="KEY CONTRACT POINTS HE MISSED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=13;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2290" width="600" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="93" value="1. Resource addressability - PUT /priceSubscriptions/notify has no id.&#10;&#10;2. Error semantics - zero endpoints had any. A caller cannot distinguish&#10;   &quot;bad URL&quot;, &quot;retailer unsupported&quot;, &quot;not your subscription&quot;, &quot;already tracked&quot;.&#10;&#10;3. resolution / downsampling parameter - the single field that turns an&#10;   11 MB, 2.2 GB/s-egress read into a 30 KB one.&#10;&#10;4. Idempotency-Key on POST - a retried create must not double-subscribe.&#10;&#10;5. His PUT response echoed targetPrice = null on the endpoint whose only&#10;   job is setting targetPrice (copy-paste from the POST response).&#10;&#10;6. No list, no delete - users can create trackers and never manage them." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2325" width="940" height="290" as="geometry"/>
        </mxCell>

