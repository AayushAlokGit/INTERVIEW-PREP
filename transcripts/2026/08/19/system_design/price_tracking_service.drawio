        <mxCell id="71" value="OPTIMAL REFERENCE - what a senior strong-hire would design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=20;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1">
