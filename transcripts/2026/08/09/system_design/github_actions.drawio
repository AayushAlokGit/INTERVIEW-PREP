<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="4600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="GitHub Actions — CI/CD Workflow Execution Platform" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;div style=&quot;text-align:left&quot;&gt;1. Parse workflow YAML files to create event watchers&lt;br/&gt;2. On event trigger, schedule proper workflows to execute on a fresh machine of the type specified in the YAML&lt;br/&gt;3. Resolve order of execution for jobs with dependencies on other jobs, from the YAML&lt;br/&gt;4. Provision compute for the jobs depending on the YAML&lt;br/&gt;5. Execute the jobs in compute in proper sequence&lt;br/&gt;6. Stream logs of job execution back to user's browser live&lt;br/&gt;7. Store artifacts generated during job execution&lt;br/&gt;8. Report pass/fail back onto the commit and PR which triggered the event&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#EAF3FB;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="112" width="760" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="OUT OF SCOPE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;div style=&quot;text-align:left&quot;&gt;• Analytics on job runs&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="840" y="112" width="360" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="312" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="&lt;div style=&quot;text-align:left&quot;&gt;1. Low-latency job scheduling post event (&amp;lt; 1s)&lt;br/&gt;2. No event should be dropped&lt;br/&gt;3. Highly available for event receiving&lt;br/&gt;4. At-least-once guarantee for job execution&lt;br/&gt;5. Durably store artifacts for 7 days&lt;br/&gt;6. Log latency &amp;lt; 500ms to the browser; ~1KB logs per job&lt;br/&gt;7. Execute jobs on a fresh machine for isolation&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#EAF3FB;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="344" width="760" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="22" value="SCALE (back-of-envelope)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="840" y="312" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="&lt;div style=&quot;text-align:left&quot;&gt;• 1M DAU&lt;br/&gt;• 1 PR/day/user → ~10 PR events/s&lt;br/&gt;• 10 commits/day/user → ~100 commits/s&lt;br/&gt;• Peak = 5×  →  ~550 jobs scheduled/s&lt;br/&gt;• 1MB artifacts per job → ~0.5 GB/s artifact data&lt;br/&gt;• Avg job = 5 min → 550 × 300 = &lt;b&gt;165,000 concurrent machines at peak&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="840" y="344" width="360" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="30" value="" style="line;strokeWidth=2;html=1;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1160" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="40" value="CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="DEFINITIONS (created when YAML is parsed)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="40" y="592" width="400" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="42" value="&lt;b&gt;Workflow&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br/&gt;eventTriggerType&lt;br/&gt;jobDag: [JobId]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="616" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="&lt;b&gt;Job&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br/&gt;dependsOn: [JobId]&lt;br/&gt;createdAt&lt;br/&gt;codeToExecute: string&lt;br/&gt;executionEnvironmentDetails&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="360" y="616" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="44" value="&lt;b&gt;EventWatcher&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;eventType&lt;br/&gt;createdAt&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="680" y="616" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="45" value="references Workflow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="43" target="42">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="50" value="INSTANCES (created when an actual event arrives)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=11;fontStyle=2;fontColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="40" y="756" width="400" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="51" value="&lt;b&gt;WorkflowExecutionRecord&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;(fields not specified)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="52" value="&lt;b&gt;JobExecutionRecord&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;jobId&lt;br/&gt;executionTime&lt;br/&gt;artifactStoreUrl&lt;br/&gt;logFileUrl&lt;br/&gt;status: PASS | FAIL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="360" y="780" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="53" value="&lt;b&gt;MachineStatus&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;lastPingTime&lt;br/&gt;alive&lt;br/&gt;osImage&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="680" y="780" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="54" value="references WorkflowExecutionRecord" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="52" target="51">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="55" value="jobId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;dashed=1;" edge="1" parent="1" source="52" target="43">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="60" value="" style="line;strokeWidth=2;html=1;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1160" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="61" value="API DESIGN (as described)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="62" value="&lt;div style=&quot;text-align:left&quot;&gt;NOTE: identity extracted from Auth headers&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /workflows/:id?cursor={}&amp;limit={}&lt;/b&gt;&lt;br/&gt;→ WorkflowExecutionRecord(status, jobs:[JobExecRecord])[], nextCursor   (cursor-based pagination)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /workflows/:id/execution/:execRecordId&lt;/b&gt;&lt;br/&gt;→ WorkflowExecRecord()&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /workflows/:id/artifacts&lt;/b&gt;&lt;br/&gt;→ ArtifactStoreUrls&lt;br/&gt;&lt;br/&gt;YAML parsing + GitHub event subscription done internally by a job (on commit that changes YAML, or periodic).&lt;br/&gt;An event-push webhook is exposed and registered with GitHub.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#EAF3FB;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="992" width="760" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="63" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;HIGH-LEVEL DESIGN&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Not reached — the round ended during API design.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;DEEP DIVE&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Not reached.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="840" y="992" width="360" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="70" value="" style="line;strokeWidth=4;html=1;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="1660" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="71" value="OPTIMAL REFERENCE — what a senior strong-hire would design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;fontColor=#2D6A2D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1320" width="900" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="72" value="Pattern: managing long-running tasks + multi-step processes.  Scale designed to: ~1M runs/day, ~3 jobs/run via matrix fan-out → ~35 jobs/s avg, ~175/s peak, ~50k concurrent runners.  Job duration is long-tailed (p50 2 min, p99 1 hr) — that tail, not the mean, drives scheduling." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;fontSize=12;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1358" width="1160" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="80" value="1 · OPTIMAL CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#2D6A2D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1420" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="81" value="&lt;b&gt;Repository&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;repoId (PK)&lt;br/&gt;orgId&lt;br/&gt;defaultBranch&lt;br/&gt;actionsEnabled&lt;br/&gt;concurrencyQuota&lt;br/&gt;billingPlan&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1454" width="240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="82" value="&lt;b&gt;WorkflowDefinition&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;workflowId (PK)&lt;br/&gt;repoId, path (.github/workflows/x.yml)&lt;br/&gt;commitSha  ← definition is pinned to a SHA&lt;br/&gt;triggers: [push, pull_request, schedule]&lt;br/&gt;rawYaml, parsedPlanJson&lt;br/&gt;concurrencyGroup, cancelInProgress&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="320" y="1454" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="83" value="&lt;b&gt;WorkflowRun&lt;/b&gt;  (one per event)&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;runId (PK), workflowId, repoId&lt;br/&gt;commitSha, prNumber, actor&lt;br/&gt;&lt;b&gt;deliveryId (UNIQUE)&lt;/b&gt; ← webhook dedupe&lt;br/&gt;status: queued|running|success|failure|cancelled&lt;br/&gt;attempt, queuedAt, startedAt, finishedAt&lt;br/&gt;checkRunId (handle on GitHub Checks)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="660" y="1454" width="340" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="84" value="&lt;b&gt;JobRun&lt;/b&gt;  (the unit of scheduling)&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;jobRunId (PK), runId, jobKey&lt;br/&gt;matrixValues {os, version}&lt;br/&gt;needs: [jobKey]  ← DAG edges&lt;br/&gt;runsOnLabels: [ubuntu-22.04, self-hosted]&lt;br/&gt;status, attempt, exitCode, timeoutMinutes&lt;br/&gt;&lt;b&gt;runnerId, leaseExpiresAt&lt;/b&gt; ← orphan detection&lt;br/&gt;steps: [{name, status, startedAt, logOffset}]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1454" width="340" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="85" value="&lt;b&gt;Runner&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;runnerId (PK), kind: hosted|self-hosted&lt;br/&gt;orgId (null for hosted pool)&lt;br/&gt;labels: [ubuntu-22.04, gpu]&lt;br/&gt;osImage, imageVersion&lt;br/&gt;state: booting|idle(warm)|busy|draining|dead&lt;br/&gt;currentJobRunId, lastHeartbeatAt&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1634" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="86" value="&lt;b&gt;LogChunk&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;jobRunId, seqNo (monotonic, gap-detectable)&lt;br/&gt;byteOffset, lineCount&lt;br/&gt;blobKey (S3), sealed: bool&lt;br/&gt;&lt;i&gt;seqNo is what lets a late viewer&lt;br/&gt;backfill then subscribe with no seam&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="380" y="1634" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="87" value="&lt;b&gt;Artifact&lt;/b&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;artifactId (PK), jobRunId, runId&lt;br/&gt;name, sizeBytes, sha256&lt;br/&gt;blobKey (S3), expiresAt (= created + 7d)&lt;br/&gt;&lt;i&gt;S3 lifecycle rule enforces retention;&lt;br/&gt;row is the index, blob is the payload&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="720" y="1634" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="88" value="&lt;b&gt;WebhookDelivery&lt;/b&gt;  (idempotency ledger)&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;deliveryId (PK, from GitHub header)&lt;br/&gt;repoId, eventType, receivedAt&lt;br/&gt;resultingRunId&lt;br/&gt;&lt;i&gt;INSERT ... ON CONFLICT DO NOTHING —&lt;br/&gt;a redelivery returns the existing runId&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1634" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="89" value="WorkflowRun → WorkflowDefinition" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="83" target="82">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="90" value="JobRun → WorkflowRun" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="84" target="83">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="100" value="2 · OPTIMAL API DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#2D6A2D;" vertex="1" parent="1">
          <mxGeometry x="40" y="1820" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="101" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;INGRESS (GitHub → us) — at-least-once, so idempotent&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /webhooks/github&lt;/b&gt;&lt;br/&gt;Headers: X-GitHub-Delivery, X-Hub-Signature-256&lt;br/&gt;Body: { event, repo:{id,fullName}, after:sha, pullRequest:{number} }&lt;br/&gt;→ 202 { runIds: [...], deduped: false }&lt;br/&gt;Redelivery of the same X-GitHub-Delivery → 202 { runIds:[same], deduped:true }.&lt;br/&gt;&lt;i&gt;Ack fast (write to Kafka + ledger), plan asynchronously.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1854" width="530" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="102" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;RUNNER ← → CONTROL PLANE  (PULL, not push)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /runners/:runnerId/acquire&lt;/b&gt;  (long-poll, ~30s)&lt;br/&gt;Body: { labels:[...], capacity:1 }&lt;br/&gt;→ 200 { jobRunId, plan:{steps[]}, repoToken (scoped, 1h TTL),&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;leaseId, leaseExpiresAt } &amp;nbsp;|&amp;nbsp; 204 no work&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /jobs/:jobRunId/heartbeat&lt;/b&gt;  every 10s&lt;br/&gt;Body: { leaseId, currentStep, logSeqNo }&lt;br/&gt;→ 200 { extendTo, cancelRequested: bool }  ← cancel piggybacks here&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /jobs/:jobRunId/logs&lt;/b&gt;  (batched every ~250ms)&lt;br/&gt;Body: { leaseId, seqNo, lines:[{ts, stream, text}] }&lt;br/&gt;→ 200 { ackedSeqNo }   &lt;i&gt;seqNo makes retries idempotent&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /jobs/:jobRunId/complete&lt;/b&gt;&lt;br/&gt;Body: { leaseId, conclusion: success|failure|cancelled, exitCode }&lt;br/&gt;→ 200 { accepted }  &lt;i&gt;rejected if leaseId is stale (job was requeued)&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="610" y="1854" width="560" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="103" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;ARTIFACTS — never proxy bytes through the API&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /jobs/:jobRunId/artifacts&lt;/b&gt;&lt;br/&gt;Body: { name, sizeBytes, sha256 }&lt;br/&gt;→ 201 { artifactId, uploadUrl (presigned S3 PUT, 15 min) }&lt;br/&gt;Runner PUTs directly to S3, then:&lt;br/&gt;&lt;b&gt;POST /artifacts/:artifactId/finalize&lt;/b&gt; → 200 { expiresAt }&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /runs/:runId/artifacts?cursor=&amp;amp;limit=50&lt;/b&gt;&lt;br/&gt;→ 200 { items:[{artifactId,name,sizeBytes,expiresAt,&lt;br/&gt;&amp;nbsp;&amp;nbsp;downloadUrl(presigned GET)}], nextCursor }&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="40" y="2114" width="530" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="104" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;USER / BROWSER&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /repos/:repoId/runs?status=&amp;amp;branch=&amp;amp;cursor=&amp;amp;limit=25&lt;/b&gt;&lt;br/&gt;→ 200 { items:[{runId, workflowName, commitSha, prNumber,&lt;br/&gt;&amp;nbsp;&amp;nbsp;status, conclusion, queuedAt, durationMs, jobCounts:{...}}],&lt;br/&gt;&amp;nbsp;&amp;nbsp;nextCursor }&amp;nbsp;&amp;nbsp;&lt;i&gt;cursor, not offset — the list mutates live&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /runs/:runId&lt;/b&gt; → 200 { runId, status, jobs:[{jobRunId, name,&lt;br/&gt;&amp;nbsp;&amp;nbsp;status, needs:[], startedAt, finishedAt, steps:[{name,status}]}] }&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /jobs/:jobRunId/logs?fromSeq=N&lt;/b&gt;  &lt;i&gt;Accept: text/event-stream&lt;/i&gt;&lt;br/&gt;→ &lt;b&gt;SSE&lt;/b&gt; if running: backfill from fromSeq, then live frames&lt;br/&gt;→ &lt;b&gt;302 → presigned S3 URL&lt;/b&gt; if the run is finished (sealed blob)&lt;br/&gt;&lt;i&gt;Last-Event-ID header resumes cleanly after a refresh&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /runs/:runId/rerun&lt;/b&gt;  { failedOnly: bool }&lt;br/&gt;Header: Idempotency-Key → 201 { runId, attempt }&lt;br/&gt;&lt;b&gt;POST /runs/:runId/cancel&lt;/b&gt; → 202 { cancelling:[jobRunId] }&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="610" y="2174" width="560" height="310" as="geometry"/>
        </mxCell>

