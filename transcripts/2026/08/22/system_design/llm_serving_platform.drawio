        <mxCell id="171" value="heartbeat / freeKvBytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="146" target="150">
