        <mxCell id="165" value="token stream (gRPC, seq-numbered)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontSize=10;dashed=1;strokeColor=#C0392B;" edge="1" parent="1" source="146" target="143">
