<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="4200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="LLM Serving Platform (ChatGPT-style Inference Service)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Difficulty: 5/5 (Hard)  ·  2026-08-22" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="600" height="24" as="geometry"/>
        </mxCell>

        <!-- ================= CANDIDATE SECTION ================= -->
        <mxCell id="10" value="CANDIDATE DESIGN (exactly as described in the round)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;fontColor=#1F5C99;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="" style="line;strokeWidth=2;html=1;strokeColor=#1F5C99;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="2280" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="Functional Requirements" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="165" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="1. A user sends a conversation (chat history + new message). The service runs it through a large language model and streams the generated tokens back to the user's browser as they are produced.&#10;&#10;2. Output tokens should be streamed to the user as they are generated.&#10;&#10;3. A ChatCompletion request is handled by models running on GPUs, which are expensive, scarce and slow to provision. The system must provision GPUs if needed and load model weights into GPUs for inference.&#10;&#10;4. Multiple model sizes offered; multiple tiers of service — paying tier gets better service than free tier." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#EAF2FA;strokeColor=#1F5C99;" vertex="1" parent="1">
          <mxGeometry x="40" y="196" width="1100" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="14" value="Non-Functional Requirements" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="165" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="(not produced — round ended before NFRs)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontColor=#777777;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="196" width="520" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="16" value="Core Entities · API Design · High-Level Design · Deep Dive&#10;&#10;(not reached — the round was abandoned inside the requirements phase)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontColor=#777777;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="1100" height="80" as="geometry"/>
        </mxCell>

        <!-- ================= OPTIMAL SECTION ================= -->
        <mxCell id="100" value="OPTIMAL REFERENCE (what a senior strong-hire would design)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;fontColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="101" value="" style="line;strokeWidth=2;html=1;strokeColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="2280" height="10" as="geometry"/>
        </mxCell>

        <!-- Optimal requirements -->
        <mxCell id="110" value="1 · Requirements" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="615" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="111" value="&lt;b&gt;FRs (choices, not restatements)&lt;/b&gt;&#10;• Submit a conversation → receive a streamed completion&#10;• Cancel an in-flight generation (users hit stop constantly = live GPU spend)&#10;• Reconnect / resume a stream that dropped mid-generation&#10;• Route to a requested model (small / large)&#10;• Per-tier admission, priority and shedding under scarcity&#10;&#10;&lt;b&gt;Out of scope (say it aloud)&lt;/b&gt;&#10;training / fine-tuning · conversation persistence · the model itself&#10;safety filtering · billing &amp;amp; metering · auth" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F5EC;strokeColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="40" y="646" width="700" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="112" value="&lt;b&gt;NFRs — three distinct latencies, and they trade against each other&lt;/b&gt;&#10;• &lt;b&gt;TTFT&lt;/b&gt; (time to first token): p99 &amp;lt; 1s paid, &amp;lt; 5s free — perceived responsiveness&#10;• &lt;b&gt;TPOT&lt;/b&gt; (inter-token): ~50 ms/token, must beat reading speed or the stream stutters&#10;• &lt;b&gt;Total generation&lt;/b&gt;: 500 tokens x 50 ms = 25s of &lt;i&gt;held GPU&lt;/i&gt; per request&#10;• Availability 99.9% on submit; a dropped stream is resumable, not a data-loss event&#10;• Consistency: not a factor — no shared mutable state on the serving path&#10;&#10;&lt;b&gt;Scale (givens)&lt;/b&gt;  100M DAU · 10 msgs/user/day · 1,000 in / 500 out tokens&#10;peak 3x avg · 90% small model · large-model GPU ≈ 2,000 out-tok/s aggregate&#10;&#10;&lt;b&gt;THE TRAP: QPS is the wrong unit.&lt;/b&gt; Capacity is tokens/sec, and requests&#10;differ ~100x in cost. Sizing in req/s gives a fleet wrong by an order of magnitude.&#10;&#10;&lt;b&gt;Derivation&lt;/b&gt; (day = 10^5 s)&#10;1e9 msgs/day → 1e4 msgs/s avg → 3e4/s peak&#10;output tokens: 3e4/s x 500 = 1.5e7 out-tok/s at peak&#10;GPUs ≈ 1.5e7 / 2e3 ≈ &lt;b&gt;7,500 GPUs&lt;/b&gt; at peak for generation alone (+ prefill)&#10;&lt;b&gt;Conclusion:&lt;/b&gt; cost dominates every other concern → batching, tiering and&#10;KV-cache reuse are &lt;i&gt;necessary&lt;/i&gt;, not decorative. If the 2,000 tok/s figure is off&#10;by 10x, the fleet moves 10x and the whole business case moves with it." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F5EC;strokeColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="790" y="646" width="930" height="430" as="geometry"/>
        </mxCell>

        <!-- Optimal entities -->
        <mxCell id="120" value="2 · Core Entities" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="121" value="&lt;b&gt;Request&lt;/b&gt;&#10;requestId (idempotency key)&#10;userId, tier&#10;modelId&#10;messages[] (role, content)&#10;maxTokens, temperature&#10;promptTokenCount (est.)&#10;state: QUEUED | PREFILL |&#10;  DECODING | DONE | CANCELLED |&#10;  FAILED&#10;assignedWorkerId&#10;createdAt, firstTokenAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F5EC;strokeColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="40" y="931" width="330" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="122" value="&lt;b&gt;Model&lt;/b&gt;&#10;modelId, version&#10;weightsUri (object store)&#10;paramCount, dtype&#10;gpuMemForWeights&#10;kvBytesPerToken&#10;  ← the field that decides&#10;     admission control&#10;maxContextLen&#10;warmPoolTarget" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F5EC;strokeColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="410" y="931" width="330" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="123" value="&lt;b&gt;InferenceWorker&lt;/b&gt;  (NOT stateless)&#10;workerId, gpuType, zone&#10;loadedModelId (or null)&#10;state: PROVISIONING | LOADING |&#10;  READY | DRAINING | DEAD&#10;totalKvBytes / freeKvBytes&#10;activeRequestIds[]&#10;currentBatchSize&#10;observedTokensPerSec&#10;heartbeatAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F5EC;strokeColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="780" y="931" width="360" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="124" value="&lt;b&gt;StreamSession&lt;/b&gt;&#10;requestId&#10;tokensEmitted (monotonic seq)&#10;lastAckedSeq&#10;  ← enables resume-from-offset&#10;bufferedTail (ring buffer)&#10;connectionState&#10;&#10;&lt;b&gt;QueueEntry&lt;/b&gt;&#10;requestId, priorityClass,&#10;enqueuedAt, deadline" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F5EC;strokeColor=#1A7F37;" vertex="1" parent="1">
          <mxGeometry x="1180" y="931" width="340" height="220" as="geometry"/>
        </mxCell>

        <!-- Optimal API -->
        <mxCell id="130" value="3 · API Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="131" value="&lt;b&gt;POST /v1/chat/completions&lt;/b&gt;    (SSE stream; Authorization: Bearer &amp;lt;jwt&amp;gt; → userId + tier)&#10;&lt;b&gt;Headers:&lt;/b&gt; Idempotency-Key: &amp;lt;uuid&amp;gt;   ← retry of a 25-second request must NOT double-charge a GPU&#10;&lt;b&gt;Request:&lt;/b&gt; { model, messages: [{role, content}], maxTokens, temperature, stream: true }&#10;&lt;b&gt;Response (200, text/event-stream):&lt;/b&gt;&#10;  event: meta   data: { requestId, model, queuePositionHint }        ← requestId is load-bearing: cancel + resume key&#10;  event: token  data: { seq, text }                                   ← seq is load-bearing: the resume offset&#10;  event: done   data: { finishReason: stop|length|cancelled|error, usage: {promptTokens, completionTokens} }&#10;&lt;b&gt;Errors:&lt;/b&gt; 400 bad request · 401 unauth · 413 context too long · 429 tier rate limit (Retry-After)&#10;        503 capacity exhausted — free tier sheds here first, paid queues instead&#10;&#10;&lt;b&gt;GET /v1/chat/completions/{requestId}/stream?fromSeq=N&lt;/b&gt;   → resume a dropped stream from seq N (SSE, same event shape)&#10;&lt;b&gt;DELETE /v1/chat/completions/{requestId}&lt;/b&gt;                 → cancel in flight; 202 + frees the KV cache immediately&#10;&lt;b&gt;GET /v1/models&lt;/b&gt;                                          → [{ modelId, maxContextLen, availableToTier }]&#10;&#10;&lt;b&gt;Why SSE over WebSocket:&lt;/b&gt; the stream is unidirectional server→client; SSE gets HTTP/2 multiplexing, proxy&#10;compatibility and automatic browser reconnect (Last-Event-ID maps straight onto fromSeq). Given up: no client→server&#10;channel, so cancel needs a separate DELETE rather than an in-band frame. &lt;b&gt;Why not long-poll:&lt;/b&gt; a token every 50 ms&#10;would mean 20 round-trips a second per user." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E8F5EC;strokeColor=#1A7F37;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1211" width="1680" height="340" as="geometry"/>
        </mxCell>

        <!-- Optimal HLD -->
        <mxCell id="140" value="4 · High-Level Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1590" width="400" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="141" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1660" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="142" value="API Gateway&#10;(auth, tier lookup,&#10;per-tier rate limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="1650" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="143" value="Stream Gateway&#10;(stateless SSE front;&#10;holds client conn,&#10;relays tokens,&#10;resume-from-seq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B36B00;" vertex="1" parent="1">
          <mxGeometry x="510" y="1640" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="144" value="Priority Queue&#10;(Redis / Kafka)&#10;paid · free · batch&#10;+ deadline-aware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B36B00;" vertex="1" parent="1">
          <mxGeometry x="770" y="1645" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="145" value="Scheduler / Router&#10;• picks worker with the right model&#10;  LOADED and enough FREE KV memory&#10;• admission = memory admission&#10;• prefix-affinity routing (cache hit)&#10;• emits shed / 503 when starved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5E5;strokeColor=#C0392B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1620" width="290" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="146" value="Inference Worker Fleet (GPU) — STATEFUL&#10;• continuous batching: every step decodes one token&#10;  for every request in the batch&#10;• KV cache per request resident in GPU RAM for the&#10;  whole generation (GBs) → cannot round-robin&#10;• paged KV blocks (vLLM-style) to stop fragmentation&#10;• streams tokens back over gRPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5E5;strokeColor=#C0392B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1610" width="340" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="147" value="Prefix / KV Cache Store&#10;(shared system-prompt&#10;+ conversation prefix reuse&#10;→ cuts prefill cost + TTFT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EEFF;strokeColor=#1F5C99;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1840" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="148" value="Capacity Controller&#10;• warm pool per model&#10;• scales on queue depth &amp;amp; TTFT,&#10;  NOT on GPU utilisation&#10;• provisions node (minutes) →&#10;  loads weights (1–5 min)&#10;• predictive: diurnal pre-warm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EEFF;strokeColor=#1F5C99;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1840" width="290" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="149" value="Model Registry&#10;+ Weights in Object Storage&#10;(S3 / Blob, pulled to local NVMe,&#10;peer-to-peer seeded on scale-out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EEFF;strokeColor=#1F5C99;" vertex="1" parent="1">
          <mxGeometry x="620" y="1850" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="150" value="Worker Registry&#10;(etcd / Redis: heartbeat,&#10;loadedModel, freeKvBytes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5EEFF;strokeColor=#1F5C99;" vertex="1" parent="1">
          <mxGeometry x="250" y="1850" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="151" value="Metrics &amp;amp; Usage Sink&#10;(TTFT/TPOT per tier, queue depth,&#10;tokens billed, GPU $/M tokens)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E5FF;strokeColor=#6B3FA0;" vertex="1" parent="1">
          <mxGeometry x="60" y="2020" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="160" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="141" target="142">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="161" value="POST /chat/completions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="142" target="143">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="162" value="enqueue (priority=tier)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="143" target="144">
          <mxGeometry relative="1" as="geometry"/>
