<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="3400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Strava — Activity Tracking &amp; Segment Leaderboards" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="800" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="sec_fr" value="1 — FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="fr_box" value="&lt;div style=&quot;text-align:left&quot;&gt;0. A user can follow other users of the app&lt;br&gt;1. User records activity (runs, rides) from mobile app&lt;br&gt;2. User location updated during activity by phone GPS coordinate stream&lt;br&gt;3. On activity end, show activity stats: distance, pace, elevation&lt;br&gt;4. Activity details appear in feeds of a user's followers&lt;br&gt;5. Classify certain stretches of road as segments&lt;br&gt;6. Activity passing through a segment gets ranked on an all-time leaderboard&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="20" y="125" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="oos_box" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Out of scope&lt;/b&gt;&lt;br&gt;1. Global activity leaderboard across all users&lt;br&gt;2. Watching another user's activity live (recording is personal tracking only)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="125" width="440" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="sec_nfr" value="2 — NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="nfr_box" value="&lt;div style=&quot;text-align:left&quot;&gt;1. Eventual consistency acceptable for activity feed and leaderboards&lt;br&gt;2. High availability for activity creation + tracking — 99.99% (~52 min/yr)&lt;br&gt;3. Phone pings GPS coordinates every 10s&lt;br&gt;4. Feed load p99 &amp;lt; 200 ms; segment leaderboard may be up to 3 min stale&lt;br&gt;5. Read:write ratio for activities = 100:1&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="20" y="345" width="700" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="boe_box" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Back-of-envelope&lt;/b&gt;&lt;br&gt;100M DAU x 2 activities/day = 200M/day → ~2k activities/s&lt;br&gt;1M concurrent recorders, ping every 10s → 100k GPS updates/s&lt;br&gt;Activity ~100 KB → 2k/s x 100 KB ≈ 200 MB/s of activity data&lt;br&gt;&lt;i&gt;Storage/day + storage/year: deferred, to revisit&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="760" y="345" width="440" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="sec_ent" value="3 — CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="520" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ent_user" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br&gt;name&lt;br&gt;email&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ent_act" value="&lt;b&gt;Activity&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br&gt;userId&lt;br&gt;distance&lt;br&gt;pace&lt;br&gt;elevation&lt;br&gt;segmentsCovered: [segmentId]&lt;br&gt;route: [GPS coordinates]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="260" y="560" width="240" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="ent_seg" value="&lt;b&gt;Segment&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;id&lt;br&gt;route: [GPS coordinates]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="540" y="560" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ent_follow" value="&lt;b&gt;FollowRelationship&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;fromUserId&lt;br&gt;toUserId&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="800" y="560" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ent_s2a" value="&lt;b&gt;SegmentToActivity&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;segmentId&lt;br&gt;activityId&lt;br&gt;&lt;i&gt;+ a sort column for leaderboard&lt;br&gt;ordering (not named)&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="560" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ent_note" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Storage note (stated):&lt;/b&gt; GPS coordinate stream stored in a WAL-style store (Cassandra); the metadata store (distance, pace, …) holds a reference to that object.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="20" y="710" width="740" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="sec_api" value="4 — API DESIGN&#xa;(identity extracted from auth headers)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="810" width="500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="api_w" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PUT /follow/:userId&lt;/b&gt;&lt;br&gt;→ 2xx&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /activity&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(Idempotency-Key header)&lt;/i&gt;&lt;br&gt;req: { startTime, startLocation }&lt;br&gt;→ Activity(id, userId, startLocation, status)&lt;br&gt;&lt;br&gt;&lt;b&gt;PUT /activity/:id/locationUpdate&lt;/b&gt;&lt;br&gt;req: { gpsCoordinate }&amp;nbsp;&amp;nbsp;→ 2xx&lt;br&gt;&lt;i&gt;revised: needs a BATCH endpoint + Idempotency-Key&lt;br&gt;header; dedupe key = timestamp&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PUT /activity/:id/end&lt;/b&gt;&lt;br&gt;→ 2xx&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="20" y="860" width="560" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="api_r" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /activity/:id&lt;/b&gt;&lt;br&gt;→ Activity(id, distance, pace, route: [], …)&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /activities?cursor=&amp;amp;limit=&lt;/b&gt;&lt;br&gt;→ Activity(id, distance, userId, pace)[], nextCursor&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /activities/:followedUserId&lt;/b&gt;&lt;br&gt;&lt;b&gt;GET /friends/activities&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(merged follower feed;&lt;br&gt;response shape not specified)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /segments/:id/leaderboard?cursor=&amp;amp;limit=&lt;/b&gt;&lt;br&gt;→ Activity(id, distance, userId, pace, &lt;b&gt;duration&lt;/b&gt;)[],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nextCursor&lt;br&gt;&lt;br&gt;&lt;i&gt;Cursor-based pagination — chosen because feeds and&lt;br&gt;leaderboards are dynamic/changing datasets.&lt;br&gt;duration also added to Activity and SegmentToActivity.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="620" y="860" width="600" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="divider" value="" style="line;strokeWidth=3;html=1;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="1220" width="2300" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="opt_title" value="OPTIMAL REFERENCE — what a senior strong-hire would design&#xa;(added after the round; the section above is exactly what was described live)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="1250" width="1400" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="o_sec1" value="A — OPTIMAL CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="1330" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="o_e1" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;userId (PK)&lt;br&gt;name, email&lt;br&gt;followerCount&lt;br&gt;isPro (celebrity flag)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="20" y="1370" width="230" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="o_e2" value="&lt;b&gt;Activity&lt;/b&gt; (metadata only)&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;activityId (PK, UUID from client)&lt;br&gt;userId, type (run|ride)&lt;br&gt;status: RECORDING|ENDED|PROCESSED&lt;br&gt;startTime, endTime, movingTime&lt;br&gt;distanceM, avgPace, elevGainM&lt;br&gt;boundingBox (minLat,minLng,maxLat,maxLng)&lt;br&gt;streamRef → s3://.../activityId.polyline&lt;br&gt;visibility (public|followers|private)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="290" y="1370" width="330" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="o_e3" value="&lt;b&gt;GpsPoint&lt;/b&gt; (hot stream, Cassandra)&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;PARTITION KEY: activityId&lt;br&gt;CLUSTERING KEY: ts ASC&lt;br&gt;lat, lng, elevM, accuracyM&lt;br&gt;&lt;br&gt;&lt;i&gt;Upsert on (activityId, ts) ⇒ retried&lt;br&gt;batches are naturally idempotent.&lt;br&gt;TTL 7d — after processing the&lt;br&gt;canonical copy is the S3 polyline.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="660" y="1370" width="330" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="o_e4" value="&lt;b&gt;Segment&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;segmentId (PK)&lt;br&gt;name, activityType&lt;br&gt;polyline: [ (lat,lng) ]&lt;br&gt;&lt;b&gt;startPoint, endPoint&lt;/b&gt;&lt;br&gt;&lt;b&gt;startCellId / cellIds: [S2 cell]&lt;/b&gt;&lt;br&gt;boundingBox, lengthM, elevGainM&lt;br&gt;&lt;br&gt;&lt;i&gt;The cell IDs are the field that&lt;br&gt;makes matching cheap.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1370" width="330" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="o_e5" value="&lt;b&gt;SegmentEffort&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;(segmentId, activityId) PK&lt;br&gt;userId&lt;br&gt;&lt;b&gt;elapsedSec&lt;/b&gt; ← the leaderboard sort key&lt;br&gt;startedAt, endedAt&lt;br&gt;isFlagged (anti-cheat)&lt;br&gt;&lt;br&gt;&lt;i&gt;Leaderboard = efforts ordered by&lt;br&gt;elapsedSec ASC, tie-break startedAt ASC.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1370" width="340" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="o_e6" value="&lt;b&gt;Follow&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;(followerId, followeeId) PK&lt;br&gt;createdAt&lt;br&gt;&lt;br&gt;&lt;i&gt;Inverted index on followeeId&lt;br&gt;for fan-out.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1370" width="280" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="o_e7" value="&lt;b&gt;FeedEntry&lt;/b&gt; (materialised)&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;PARTITION KEY: userId&lt;br&gt;CLUSTERING: createdAt DESC&lt;br&gt;activityId, authorId&lt;br&gt;&lt;i&gt;capped at ~500 entries&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="2100" y="1370" width="280" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="o_sec2" value="B — OPTIMAL API DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="20" y="1620" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="o_api_w" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;WRITE PATH&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /v1/activities&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Idempotency-Key: &amp;lt;client UUID&amp;gt;&lt;/i&gt;&lt;br&gt;req&amp;nbsp; { activityId, type, startTime, startLocation }&lt;br&gt;201 { activityId, userId, status:&quot;RECORDING&quot;, uploadToken }&lt;br&gt;&lt;i&gt;Client mints activityId — create is retry-safe with no server state.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /v1/activities/{id}/points:batch&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(replaces per-point PUT)&lt;/i&gt;&lt;br&gt;req&amp;nbsp; { batchSeq, points:[ {ts, lat, lng, elev, accuracy} ] }&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;≤ 500 points, gzip, flushed every 30–60 s&lt;br&gt;202 { accepted: n, lastAckedTs }&lt;br&gt;&lt;i&gt;Idempotent by (activityId, ts) upsert — retries and duplicate&lt;br&gt;batches are no-ops. Out-of-order is fine: ts is the clustering key,&lt;br&gt;so Cassandra returns the stream sorted regardless of arrival order.&lt;br&gt;lastAckedTs lets the client prune its local buffer.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /v1/activities/{id}/complete&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Idempotency-Key&lt;/i&gt;&lt;br&gt;req&amp;nbsp; { endTime, finalBatch?: [...] }&lt;br&gt;202 { activityId, status:&quot;PROCESSING&quot;, pollUrl }&lt;br&gt;&lt;i&gt;202 not 200 — stats + segment matching are async.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PUT /v1/users/{id}/follow&lt;/b&gt;&amp;nbsp;&amp;nbsp;→ 204&amp;nbsp;&amp;nbsp;&lt;i&gt;(PUT = naturally idempotent)&lt;/i&gt;&lt;br&gt;&lt;b&gt;DELETE /v1/users/{id}/follow&lt;/b&gt;&amp;nbsp;&amp;nbsp;→ 204&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="20" y="1660" width="720" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="o_api_r" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;READ PATH&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/activities/{id}&lt;/b&gt;&lt;br&gt;200 { activityId, userId, type, startTime, movingTime,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;distanceM, avgPace, elevGainM, status,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;polylineUrl: &quot;https://cdn/…&quot;, &amp;nbsp;// signed, NOT inline&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;efforts: [ {segmentId, name, elapsedSec, rank, prRank} ] }&lt;br&gt;&lt;i&gt;Route is a CDN URL, not a JSON array — keeps the metadata&lt;br&gt;response small and lets the map load lazily.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/feed?cursor=&amp;amp;limit=20&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(merged follower feed)&lt;/i&gt;&lt;br&gt;200 { items: [ { activityId, author:{userId,name,avatarUrl},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;type, startTime, distanceM, movingTime, elevGainM,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;mapThumbUrl, kudosCount } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;nextCursor: &quot;&amp;lt;createdAt|activityId&amp;gt;&quot; }&lt;br&gt;&lt;i&gt;Cursor = (createdAt, activityId) — offset paging skips/duplicates&lt;br&gt;rows when new activities land mid-scroll.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/users/{id}/activities?cursor=&amp;amp;limit=&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(profile)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/segments/{id}/leaderboard?filter=all_time|this_year&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&amp;amp;gender=&amp;amp;ageGroup=&amp;amp;cursor=&amp;amp;limit=50&lt;/b&gt;&lt;br&gt;200 { segment: {id, name, lengthM, elevGainM},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;entries: [ {&lt;b&gt;rank&lt;/b&gt;, userId, name, activityId,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;elapsedSec&lt;/b&gt;, avgSpeed, achievedAt} ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;viewer: {rank, elapsedSec, percentile},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;nextCursor, asOf }&lt;br&gt;&lt;i&gt;`viewer` saves a second round-trip; `asOf` makes the 3-min&lt;br&gt;staleness budget visible to the client instead of implicit.&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="790" y="1660" width="760" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="o_api_n" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;CONTRACT DECISIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Batching, not per-point.&lt;/b&gt; 1 req/point = 100k–500k req/s&lt;br&gt;at the edge. A 60 s batch of 6 points cuts that ~60x to&lt;br&gt;&amp;lt;10k req/s and survives tunnels, which per-point does not.&lt;br&gt;Cost accepted: up to 60 s of loss if the phone dies&lt;br&gt;mid-activity — fine, the client persists the buffer to disk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Idempotency everywhere on the ingest path.&lt;/b&gt; Mobile&lt;br&gt;networks guarantee at-least-once, never exactly-once.&lt;br&gt;Natural key (activityId, ts) beats a header-based key here&lt;br&gt;because it dedupes at &lt;i&gt;point&lt;/i&gt; granularity, so a partially&lt;br&gt;delivered batch re-sent in a different grouping still converges.&lt;br&gt;&lt;br&gt;&lt;b&gt;202 + poll on complete.&lt;/b&gt; Stats and segment matching&lt;br&gt;take seconds; blocking the request would couple the&lt;br&gt;mobile UX to matcher latency.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cursor pagination&lt;/b&gt; on feed &amp;amp; leaderboard — both are&lt;br&gt;live-mutating lists.&lt;br&gt;&lt;br&gt;&lt;b&gt;Versioned /v1&lt;/b&gt; — mobile clients are un-upgradable in&lt;br&gt;the field; old app versions keep hitting v1 for years.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1600" y="1660" width="600" height="430" as="geometry"/>
        </mxCell>

