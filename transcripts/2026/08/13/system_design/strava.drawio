        <mxCell id="f20l" value="GET /v1/feed  ·  GET /v1/segments/{id}/leaderboard  ·  GET /v1/activities/{id}  (read paths)" style="edgeLabel;html=1;fontSize=11;fontStyle=2;" vertex="1" connectable="0" parent="f20">
