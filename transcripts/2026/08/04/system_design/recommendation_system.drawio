        <mxCell id="lane_s" value="STORAGE + READ / SERVING PATH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BFBFBF;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#808080;" vertex="1" parent="1">
