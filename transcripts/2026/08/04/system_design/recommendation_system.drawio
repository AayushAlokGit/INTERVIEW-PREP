        </mxCell>
        <mxCell id="o_feedkv" value="UserFeed store — KV (DynamoDB / Cassandra)&#10;pk = userId · top-500 IDs + scores&#10;~100M rows · ~200 GB · TTL 24 h&#10;(no joins, no transactions → SQL buys nothing)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontSize=11;" vertex="1" parent="1">
