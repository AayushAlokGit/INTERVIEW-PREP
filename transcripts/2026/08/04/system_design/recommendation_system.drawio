        <mxCell id="o_recsvc" value="Recommendation Service&#10;1. cache → 2. KV store → 3. FALLBACK&#10;   (trending / popular-in-category)&#10;light re-rank with in-session events&#10;filters: out-of-stock, already-purchased, dedupe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=11;" vertex="1" parent="1">
