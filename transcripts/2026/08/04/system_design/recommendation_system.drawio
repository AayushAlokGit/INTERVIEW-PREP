        </mxCell>
        <mxCell id="o_simkv" value="ItemSimilarity store — KV&#10;pk = productId · top-100 IDs + scores&#10;~50M products · ~40 GB&#10;fully cacheable (not personalized)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontSize=11;" vertex="1" parent="1">
