<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Design a Collaborative Document Editor (Google Docs)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="frs" value="FUNCTIONAL REQUIREMENTS&#10;&#10;1. Users can create documents&#10;2. Users can share a document with other users for editing&#10;3. Multiple users edit the same doc and see each other's changes in real time&#10;4. See each user's cursor position&#10;&#10;Out of scope: versioning/undo, access-control layers" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="nfrs" value="NON-FUNCTIONAL REQUIREMENTS&#10;&#10;1. Low latency for propagating edits: p99 &lt; 200ms&#10;2. Consistency: EVENTUAL CONSISTENCY / CONVERGENCE (system is AP)&#10;   - local-first edits (user sees own typing instantly)&#10;   - all editors converge to the same final doc state&#10;   - high availability favoured over strict ordering&#10;   (rejected strict linearizability: per-keystroke round-trip = typing lag)&#10;3. Durability: committed edits must not be lost&#10;&#10;Scale assumptions:&#10;- 100M DAU, ~10 concurrent editors per doc&#10;- ~10k docs concurrently edited; 1 edit = 1 keystroke&#10;- ~100k edits/s ingest (10k x 10 x ~1/s)&#10;- fanout: 1 edit -&gt; 9 editors = ~900k broadcasts/s" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="560" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="entities" value="CORE ENTITIES&#10;&#10;Document { id, userIds:[], createdAt, updatedAt }&#10;   - content: reconstructed from DocumentEdits, flushed to blob storage (S3)&#10;User { id, name, ... }&#10;DocumentEdit { userId, editText, editArea (location of edit) }&#10;CursorPosition { userId, logical char offset (render-agnostic) }" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API DESIGN&#10;&#10;Identity from JWT auth header (not in body)&#10;&#10;POST /documents&#10;  req: { name, ... }  + Idempotency-Key header&#10;  res: 201 Document { id, ... }&#10;&#10;PATCH /documents/:id/share&#10;  req: { userIds:[] }&#10;  res: 2xx (edit access granted)&#10;&#10;WS /documents/:id  (bidirectional, real-time)&#10;  on connect: server pushes current doc snapshot&#10;  client -&gt; server: pushCursorPosition, pushDocumentEdit&#10;  server -&gt; client: receiveDocumentEdits, receiveCursorPositions&#10;&#10;  pushDocumentEdit: { docId, op:insert|delete, position, text, clientId }&#10;  (open: version/seq number? meaning of position under&#10;   concurrent edits -&gt; resolved in deep dive)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="420" width="560" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="hld_hdr" value="HIGH-LEVEL DESIGN (as described)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="780" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="h_clients" value="Clients&#10;(browser editors)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h_gw" value="API Gateway&#10;- auth middleware (JWT)&#10;- LB: consistent hashing&#10;  on docId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="280" y="895" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_svc" value="API Service node (STATEFUL)&#10;- holds WS connections&#10;- in-memory doc state&#10;- resolves concurrent edits&#10;- broadcasts resolved state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="885" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="h_s3" value="Blob store (S3)&#10;periodic snapshot&#10;(overwrite each flush)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="820" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="h_ddb" value="DynamoDB (edit log)&#10;PK=docId, SK=createdAt&#10;high write throughput" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="960" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="h_clients" target="h_gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1l" value="WS edits + cursor / broadcasts" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="175" y="975" width="120" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="h_gw" target="h_svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2l" value="route by hash(docId)" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="465" y="975" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="h_svc" target="h_s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3l" value="periodic flush" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="780" y="850" width="90" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="h_svc" target="h_ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4l" value="append each edit" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="780" y="1000" width="90" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="optdiv" value="" style="line;strokeWidth=2;html=1;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="1110" width="1600" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="opt_hdr" value="OPTIMAL HLD (Reference) — what a senior strong-hire would draw for this problem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1a5fb4;" vertex="1" parent="1">
          <mxGeometry x="20" y="1130" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="o_clients" value="Clients&#10;(browser editors)&#10;local-first OT buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_gw" value="API Gateway&#10;- JWT auth / WS terminate&#10;- consistent-hash route&#10;  on docId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="260" y="1225" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="o_edit" value="Collaboration / Edit Service (owner per doc)&#10;- holds WS conns + in-memory doc&#10;- OT engine: transform vs concurrent&#10;  ops since edit.baseVersion&#10;- monotonic doc version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="1210" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="o_wal" value="WAL / Kafka&#10;(durable append&#10;BEFORE broadcast,&#10;batched)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="830" y="1215" width="150" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="o_relay" value="Region-local relay /&#10;fanout servers&#10;(broadcast once per region)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="1400" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_coord" value="etcd / ZooKeeper&#10;ring membership +&#10;owner failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="260" y="1405" width="180" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="o_snap" value="Snapshotter&#10;(async consumer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1230" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o_s3" value="S3&#10;doc snapshots&#10;(every N ops)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1180" width="150" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="o_ddb" value="DynamoDB&#10;queryable edit log&#10;PK=docId, SK=version" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1300" width="150" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="o_clients" target="o_gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe1l" value="edit { op, pos, text, baseVersion, clientId }" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="35" y="1320" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="o_gw" target="o_edit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe2l" value="route hash(docId)" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="445" y="1190" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="oe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="o_edit" target="o_wal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe3l" value="1) append  2) ack -&gt; then broadcast" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="765" y="1180" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="o_edit" target="o_relay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe4l" value="resolved op + version" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="620" y="1352" width="130" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="oe5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;exitX=0;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="o_relay" target="o_clients">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe5l" value="fanout broadcast (WS)" style="text;html=1;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="1440" width="130" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="oe6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="o_edit" target="o_coord">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="o_wal" target="o_snap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="o_snap" target="o_s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="o_snap" target="o_ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe10" value="recover/bootstrap: snapshot + replay log since version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;fontSize=10;" edge="1" parent="1" source="o_s3" target="o_edit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="o_tradeoffs" value="KEY TRADE-OFFS (choice vs named alternative)&#10;&#10;- OT (central server) vs CRDT: OT = simpler wire, but needs ONE serialization point per doc.&#10;  CRDT commutes / suits P2P+offline, but pays per-char unique-id metadata + delete tombstones.&#10;- Consistent hashing on docId vs random LB: colocation gives one in-memory OT state (fast),&#10;  cost = a hot doc pins to one node + ring changes force state migration.&#10;- WAL/Kafka append BEFORE broadcast vs async persist: guarantees no acked edit is ever lost,&#10;  cost = +latency per keystroke -> mitigate with batched appends within the 200ms budget.&#10;- In-memory authoritative state vs DB-per-edit read: meets p99 200ms, but volatile&#10;  -> recovery = S3 snapshot + replay WAL/Dynamo since snapshot version.&#10;- Eventual consistency / AP vs linearizable: instant local typing + writable under partition,&#10;  cost = no global order, must converge via OT." style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1560" width="760" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="o_deepdives" value="DEEP DIVES (specific to this system)&#10;&#10;- Core problem: concurrent-edit convergence via Operational Transformation.&#10;  Each edit carries baseVersion; server transforms its position against all ops applied since&#10;  that version (delta = net chars inserted/deleted before the position), then assigns a new version.&#10;&#10;- SCALE-BREAK: a single doc = a single owner node (OT needs one serialization point).&#10;  A hot/viral doc (100s of editors) caps that node's CPU and explodes broadcast fanout (~N^2).&#10;  A single OT'd doc does NOT shard. Fixes: cap concurrent editors/doc; region-local relay servers&#10;  (owner broadcasts once per region, relay fans out); batch keystrokes per ~50-100ms frame to&#10;  cut both fanout and WAL load.&#10;&#10;- Hot partitions: docId-hash skew -> detect hot docs, give them dedicated nodes.&#10;- Durability: WAL append before broadcast; snapshot to S3 every N ops; replay on recovery.&#10;- Failover/rebalancing: etcd/ZK tracks ring membership; on owner loss, reassign doc + rebuild&#10;  from snapshot+log. Brief per-doc unavailability; clients buffer local edits and sync on reconnect (AP).&#10;- Operability: detect divergence (state checksum across replicas), WS/broadcast backpressure &amp;&#10;  consumer lag at peak, hot-doc alerts. Cursors/presence = ephemeral channel (not durable)." style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="1560" width="780" height="300" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
