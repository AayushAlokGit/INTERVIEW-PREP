<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="669" dy="206" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="3500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design an Ad Click Aggregator" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="frs" value="FRs&#xa;1. Record ad click events from many publisher sites&#xa;2. Dashboard: aggregated click metrics per ad/campaign over time range (last hr/day)&#xa;   - Dimensions: publishing site, region&#xa;3. Near real-time capture of click events&#xa;4. Retention: raw click data 30 days; aggregated data 1 year" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="640" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="nfrs" value="NFRs&#xa;1. High availability for click reception (99.99% ~ 52 min/yr)&#xa;2. Low latency click to dashboard (under 1 min freshness)&#xa;3. No click event lost (durability — clicks = billing $)&#xa;4. Low-latency dashboard queries (p99 under 1s)&#xa;5. Scale: 1M clicks/s avg, 10M/s peak; 1KB/event&#xa;   1 GB/s avg, 10 GB/s peak; ~86B events/day ~86 TB/day raw; ~2.6 PB / 30 days" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="20" y="230" width="640" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="entities" value="Core Entities&#xa;1. ClickEvent (id, timestamp, adId to Advertisement, publishingSite, region)&#xa;2. Advertisement (adId, campaignId, ...)&#xa;3. AggregatedMetric (adId, timePeriod [hour/day], timeRange,&#xa;   aggregateType [count/min/max], dimensions: publishingSite/region, value)" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="20" y="400" width="640" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="api" value="API Design (identity from auth token)&#xa;&#xa;WRITE:  POST /ads/:id/clickEvents&#xa;  Headers: Idempotency-Key&#xa;  Request: { timestamp, site, region }&#xa;  Response: 2xx&#xa;&#xa;READ:  GET /clickEvents?aggregate_interval={1hr|1day}&amp;aggregate_type={count|min|max}&#xa;        &amp;dimensions={}&amp;start={}&amp;end={}&amp;cursor={}&amp;limit={}&#xa;  Response: [ AggregatedMetric(timePeriod, value) ]  (+ dimension value per row)&#xa;  Cursor-based pagination; cursor = last (clickEventTimestamp + clickEventId)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="20" y="540" width="640" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="hld_title" value="HLD — Write Path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="760" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="pub" value="Publishing Site&#xa;(user clicks ad)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="40" y="830" width="130" height="60" as="geometry"/>
                </mxCell>
