                    <mxGeometry x="250" y="830" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="kafka" value="Kafka&#xa;(durable, at-least-once;&#xa;no ordering needed)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="470" y="820" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="workers" value="Worker Consumer Group&#xa;(pull events;&#xa;dedupe via Idempotency-Key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="690" y="820" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="lock" value="Distributed Lock&#xa;(on aggregate record;&#xa;short TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="710" y="970" width="150" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ddb" value="DynamoDB&#xa;PK = adId, SK = timestamp&#xa;- ClickEvent rows (idempotent insert)&#xa;- AggregatedMetric rows (hour + day,&#xa;per matching dimensions; atomic update)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="970" y="810" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="POST /ads/:id/clickEvents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="pub" target="ingest" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="append click event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="ingest" target="kafka" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
