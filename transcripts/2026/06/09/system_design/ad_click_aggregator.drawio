                <mxCell id="rld_title" value="HLD — Read Path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="20" y="1100" width="400" height="30" as="geometry"/>
