                <mxCell id="mre4" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mr_rd" target="mr_day">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="mr_query" value="QUERY STRATEGY: read the COARSEST grain that covers the range, + fine grain only for the live (incomplete) edge.&#xa;&#xa;Example: &quot;last 24 hours&quot;&#xa;  - 23 completed hours  -&gt; read 23 precomputed HOUR rows&#xa;  - current partial hour -&gt; sum its &#8804;60 MINUTE buckets on the fly&#xa;  => fast (small row count) AND fresh (&lt;1 min on the open interval).&#xa;&#xa;Why not just sum minutes for everything?&#xa;  &quot;last 7 days&quot; = 10,080 minute rows PER dimension value (x50 regions = 500K rows/query) -&gt; blows p99.&#xa;  With rollups: ~7 day rows + a few hour rows + minutes for the open hour only.&#xa;&#xa;Note: the AggregatedMetric entity is NOT redundant — minute/hour/day rows are all AggregatedMetric&#xa;at different granularities (its timePeriod field). Rollup jobs just populate the coarser grains." style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
                    <mxGeometry x="40" y="2990" width="1290" height="290" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
