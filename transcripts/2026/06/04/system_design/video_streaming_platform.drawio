<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Design a Video Streaming Platform (YouTube-like)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="frs" value="&lt;b&gt;Functional Requirements&lt;/b&gt;&lt;br&gt;1. Users can upload videos&lt;br&gt;2. Users can search videos by text query&lt;br&gt;3. Users can watch (stream) videos&lt;br&gt;&lt;br&gt;&lt;i&gt;Out of scope:&lt;/i&gt; access privileges / sharing" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="nfrs" value="&lt;b&gt;Non-Functional Requirements&lt;/b&gt;&lt;br&gt;1. HA search: 99.99% (~52 min/yr)&lt;br&gt;2. Low-latency query: p99 &lt; 200ms&lt;br&gt;3. Durable uploads (S3-tier)&lt;br&gt;4. Uploads resilient to network drops&lt;br&gt;5. Streaming resilient to drops (adaptive bitrate / transcoding)&lt;br&gt;6. Low-latency streaming: p99 TTFF &lt; 200ms&lt;br&gt;&lt;br&gt;&lt;b&gt;Scale&lt;/b&gt;&lt;br&gt;100M DAU; 3M uploads/day (~1k/s)&lt;br&gt;10k streams/s avg, 100k/s peak (10x)&lt;br&gt;Storage ~450 TB/day (~160 PB/yr w/ renditions)&lt;br&gt;Egress 50 Gbps avg, 500 Gbps peak" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="380" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="entities" value="&lt;b&gt;Core Entities&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;VideoMetadata&lt;/b&gt;&#10;{ id, userId, name, description,&lt;br&gt;&#160;&#160;s3Urls: { &quot;360p&quot;:.., &quot;720p&quot;:.. },&lt;br&gt;&#160;&#160;status: pending | uploaded,&lt;br&gt;&#160;&#160;multipartUploadSessionId }&lt;br&gt;&lt;br&gt;&lt;b&gt;VideoBytes&lt;/b&gt; (raw + renditions in S3)&lt;br&gt;&lt;b&gt;User&lt;/b&gt; (identity via JWT)" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="320" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="apis" value="&lt;b&gt;API Design&lt;/b&gt; (identity from JWT)&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /videos&lt;/b&gt; — create record (status=pending)&lt;br&gt;&#160;&#160;req: { videoMetadata }; Idempotency-Key header&lt;br&gt;&#160;&#160;resp: presigned S3 URL&#160;&#160;(status&#8594;uploaded via S3 event)&lt;br&gt;&lt;br&gt;&lt;b&gt;PUT /videos/:id&lt;/b&gt; — S3 multipart upload (resumable)&lt;br&gt;&#160;&#160;req: { s3-multipart-upload-session-id }; client chunks file&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /videos?query=&amp;page=&amp;limit=&lt;/b&gt;&lt;br&gt;&#160;&#160;resp: Video(id, s3Urls, name, description)[]&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /videos/:id&lt;/b&gt;&lt;br&gt;&#160;&#160;resp: Video(id, s3Urls, name, description)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="340" width="420" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="archlabel" value="Architecture (as described)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="apigw" value="API Gateway&#10;(auth / JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="700" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="vsvc" value="Video Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="470" y="700" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sqldb" value="SQL DB&#10;(VideoMetadata)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="740" y="630" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="es" value="ElasticSearch&#10;(search index)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="800" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="S3&#10;(raw + renditions)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="240" y="900" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="kafka" value="Kafka&#10;(S3 upload events,&#10;partitioned by userId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="470" y="905" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="tworkers" value="Transcoding Workers&#10;(idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="900" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="dbworkers" value="DB-Update Workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="985" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="POST /videos, PUT /videos/:id, GET (JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="client" target="apigw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="apigw" target="vsvc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="create record (pending) / read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="vsvc" target="sqldb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="presigned S3 URL (resp)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="vsvc" target="client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="320" y="660"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="multipart upload (chunks, resumable)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="client" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="upload-complete event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="s3" target="kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="kafka" target="tworkers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="kafka" target="dbworkers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="write renditions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tworkers" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="update status + s3Urls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="tworkers" target="sqldb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="status -&gt; uploaded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="dbworkers" target="sqldb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="CDC sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sqldb" target="es">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="search query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="vsvc" target="es">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
