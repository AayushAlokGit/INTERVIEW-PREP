<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="Design a Live Streaming Platform (Twitch-like)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="frs" value="FUNCTIONAL REQUIREMENTS&#10;1. Streamer broadcasts video in real time&#10;2. Viewers watch streamer's live video&#10;3. Streamers see viewer counts&#10;4. Live chat during stream" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="440" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="nfrs" value="NON-FUNCTIONAL REQUIREMENTS&#10;- HA: 99.9% (~8.6 hrs/yr)&#10;- Latency: latest frame visible within ~1s&#10;- Viewer count: eventual consistency OK&#10;- Live chat: eventual consistency OK&#10;- Scale: 100M DAU; 1M concurrent viewers/stream&#10;- Egress: ~5 Tbps for ONE 1M-viewer stream (@5Mbps)&#10;- Tension: 1s latency + 5Tbps fan-out" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="470" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="entities" value="CORE ENTITIES (as described)&#10;1. Video (live video bytes)&#10;2. LiveStreamMetadata (id, name, streamingUserId, startedAt)&#10;3. User (id, name, ...)&#10;4. StreamViewer (id, userId, joinedAt, videoId)&#10;5. ChatMessage (id, streamViewerId, videoId, txt)" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API (as described)&#10;NOTE: identity from auth token&#10;&#10;POST /liveStreams   (Header: Idempotency-Key)&#10;  req: { stream metadata - name, etc }&#10;  resp: presigned URL  [REVISED: ingest model changed to&#10;        video bytes streamed THROUGH our servers, fanned out]&#10;&#10;WS /livestream/:id   (WebSocket - live chat)&#10;  client-&gt;server: sendMessage();  server-&gt;client: pushMessages()&#10;&#10;Watch/subscribe endpoint per stream id&#10;  [described verbally; verb/path/response shape not specified]" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="480" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="hld_head" value="HLD (as described — naive v1, candidate flagged it breaks at scale)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h_streamer" value="Streamer Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_server" value="Stream Server&#10;(ingest + fan-out;&#10;drop bytes if no subscribers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="715" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h_viewers" value="Viewers&#10;(WS connections)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="900" y="715" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h_db" value="DB&#10;(StreamViewer records)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="450" y="900" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_count" value="Viewer-Count API&#10;(polled; COUNT query + indices)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="900" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="he1" value="video (WS/UDP)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h_streamer" target="h_server"><mxGeometry relative="1" as="geometry"><mxPoint y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="he2" value="forward (WS)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h_server" target="h_viewers"><mxGeometry relative="1" as="geometry"><mxPoint y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="he3" value="write viewer" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h_server" target="h_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he4" value="poll" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h_count" target="h_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he5" value="chat (WS)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h_viewers" target="h_server"><mxGeometry relative="1" as="geometry"><mxPoint y="16" as="offset"/></mxGeometry></mxCell>

        <mxCell id="opt_head" value="OPTIMAL REFERENCE — what a senior strong-hire would design for THIS problem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="1050" width="1100" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="opt_entities" value="OPTIMAL CORE ENTITIES&#10;&#10;- User (id, name, ...)&#10;- Stream (streamId, broadcasterId, title, category, status[live|ended],&#10;     startedAt, streamKey, renditions[1080/720/480/360], playbackUrl)&#10;- ChatMessage (id, streamId, userId, text, ts) - ephemeral, short-TTL store&#10;- Follow (followerId, streamerId) - for go-live notifications&#10;- (NO per-viewer table: viewer count is edge-aggregated &amp; approximate)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="640" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="opt_api" value="OPTIMAL API DESIGN&#10;&#10;POST /streams  (auth, Idempotency-Key)&#10;  resp: { streamId, ingestUrl, streamKey, playbackUrl }&#10;GET  /streams/{id}&#10;  resp: { streamId, title, broadcaster, status, viewerCount,&#10;          playbackManifestUrl, renditions:[...] }&#10;GET  /streams?category=&amp;cursor=  -&gt; { streams:[...], nextCursor }  (cursor)&#10;GET  /streams/{id}/playback  -&gt; LL-HLS manifest (served from CDN edge)&#10;WS   /streams/{id}/chat  -&gt; bidirectional chat (rate-limited)&#10;Viewer count pushed over WS or via GET /streams/{id} (approx)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="1110" width="640" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="opt_hld_head" value="Optimal HLD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1390" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="o_streamer" value="Streamer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="1470" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="o_ingest" value="Ingest Servers&#10;(RTMP/WebRTC,&#10;regional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="1460" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_transcode" value="Transcode Service&#10;(ABR ladder&#10;1080/720/480/360)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="1460" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_packager" value="Packager&#10;(LL-HLS segments)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1465" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o_origin" value="Origin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1470" y="1465" width="120" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="o_relay" value="Mid-tier Relay PoPs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1455" y="1650" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="o_edge" value="Edge PoPs&#10;(near viewers;&#10;fan-out tree leaves)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1445" y="1820" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_viewers" value="Viewers&#10;(ABR client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1750" y="1825" width="150" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="o_meta" value="Stream Metadata Svc + DB&#10;(lifecycle, who is live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="740" y="1650" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="o_chat" value="Chat Gateway&#10;(WS, sharded by streamId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="740" y="1820" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o_backplane" value="Pub/Sub Backplane&#10;(Redis/Kafka)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1820" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o_count" value="Viewer-Count Aggregator&#10;(sum edge conn counts; approx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1750" y="1980" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="oe1" value="push" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_streamer" target="o_ingest"><mxGeometry relative="1" as="geometry"><mxPoint y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="o_ingest" target="o_transcode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe3" value="renditions" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_transcode" target="o_packager"><mxGeometry relative="1" as="geometry"><mxPoint y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="o_packager" target="o_origin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe5" value="1 copy" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_origin" target="o_relay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe6" value="replicate" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_relay" target="o_edge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe7" value="LL-HLS / ABR" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_edge" target="o_viewers"><mxGeometry relative="1" as="geometry"><mxPoint y="-16" as="offset"/></mxGeometry></mxCell>
        <mxCell id="oe8" value="counts" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_edge" target="o_count"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe9" value="chat" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_viewers" target="o_chat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe10" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="o_chat" target="o_backplane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe11" value="lifecycle" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o_ingest" target="o_meta"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="opt_tradeoffs" value="KEY TRADE-OFFS (vs named alternatives)&#10;&#10;- Delivery protocol: LL-HLS over CDN (~2s, CDN-cacheable, scales to&#10;   millions) vs WebRTC (sub-second but expensive SFU trees, no CDN&#10;   cache) vs plain HLS (10-30s). 1s + 1M viewers -&gt; LL-HLS, accept ~2s.&#10;- Fan-out: tiered CDN tree (origin-&gt;relay-&gt;edge) vs unicast from&#10;   origin (impossible at 5 Tbps) vs P2P (unreliable).&#10;- Ingest transport: Kafka (ordered/durable, +latency) vs direct relay&#10;   (lower latency, no replay). No recording -&gt; durability optional.&#10;- Chat: sharded gateways + pub/sub backplane vs single server (hot key).&#10;- Viewer count: edge-aggregated approx vs DB COUNT (write churn + hot row)." style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="2110" width="560" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="opt_deep" value="DEEP DIVES (specific to live streaming)&#10;&#10;1. Fan-out at 5 Tbps: single ingest copy replicated down a CDN tree;&#10;   NO single node holds 1M conns. Viral stream = HOT KEY -&gt; must NOT&#10;   pin all viewers to one instance (the consistent-hash-on-streamId trap).&#10;2. Latency vs scale: true sub-second to 1M is WebRTC-grade and costly;&#10;   LL-HLS ~2s is the scalable compromise - name this at requirements time.&#10;3. ABR: transcode once into a ladder; client picks rendition by bandwidth.&#10;   Keep transcode a SEPARATE tier, not inside fan-out.&#10;4. Chat at scale: 1M-viewer chat is its own hot key - shard chat servers,&#10;   pub/sub backplane, rate-limit / slow-mode; drop-on-overload acceptable.&#10;5. Viewer count: sum edge connection counts periodically (approx, eventual).&#10;6. Operability: CDN egress is the dominant COST (5 Tbps), ingest&#10;   redundancy, regional failover, backpressure if edges saturate." style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="2110" width="540" height="240" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
