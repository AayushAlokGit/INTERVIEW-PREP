<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Design an Event Ticketing System (Ticketmaster)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="frs" value="FUNCTIONAL REQUIREMENTS&#10;&#10;1. Search for events and view events&#10;2. View seats for an event&#10;3. Book tickets for seats for an event&#10;&#10;Out of scope: payment internals, organizer event creation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="420" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="nfrs" value="NON-FUNCTIONAL REQUIREMENTS&#10;&#10;1. Highly available event querying — 99.9% (~8.6 hrs/yr)&#10;2. Low latency event querying — p99 &lt; 200ms&#10;3. Strong consistency for booking — no double booking&#10;4. Handle hot-event burst — waiting room for booking&#10;5. Scale: 100M DAU x 5 queries/day&#10;     = 500M queries/day&#10;     avg ~5k QPS, peak ~50k QPS (must meet latency)&#10;     Hot event: 50k seats, ~1-2M users in first seconds" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="500" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="entities" value="CORE ENTITIES (evolved)&#10;&#10;User (id, name, ...)&#10;Event (id, name, description, venueId, eventDate, artists[])&#10;Venue (id, lat, long, name, description, address)&#10;VenueSeat (id, venueId, seatType, seatNumber)&#10;EventSeat (id, eventId, venueSeatId, status)&#10;     status: available -&gt; reserved (TTL 10m) -&gt; booked&#10;Booking (id, userId, createdAt, eventId, eventSeats[], amount)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="320" width="600" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="apis" value="API DESIGN  (identity via JWT auth)&#10;&#10;1. GET /events?query=&amp;cursor=&amp;limit=&amp;lat=&amp;long=&amp;radius=&#10;     Resp: Event(id, venueId, name, description, artists[])[]&#10;     Cursor pagination — survives dynamic event insertion&#10;&#10;2. GET /events/:id&#10;     Resp: Event(..., eventSeats:[{id, seatType, status}])&#10;&#10;3. PUT /events/:id/seats/reserve&#10;     Req: { eventSeats[] }   ->  status=reserved, TTL 10m (Redis)&#10;     Reverts to available on TTL expiry&#10;&#10;4. POST /events/:id/bookings&#10;     Req: { eventSeats[] }   (amount computed server-side)&#10;     Header: Idempotency-Key  (dedupe client retries)&#10;     Confirmed on payment webhook -> status=booked&#10;     Resp: Booking(id, userId, createdAt, eventId, eventSeats[])" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="320" width="600" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="hldhdr" value="HIGH-LEVEL DESIGN (as described)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="680" width="500" height="30" as="geometry"/>
        </mxCell>
