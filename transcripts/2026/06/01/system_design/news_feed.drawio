<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="736" dy="207" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a News Feed (Twitter/Facebook-like)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="frbox" value="Functional Requirements" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="360" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="frtext" value="1. User can create posts (text + optional media)&#xa;2. User can follow other users&#xa;3. User can view feed of followed users,&#xa;    ordered chronologically&#xa;&#xa;Out of scope: likes, comments" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="28" y="110" width="344" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="nfrbox" value="Non-Functional Requirements" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="420" y="80" width="420" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="nfrtext" value="1. Highly available post creation (99.9% ~ 8.6 hrs/yr).&#xa;    Eventual consistency OK for viewing.&#xa;2. Low-latency feed generation (p99 &lt; 200ms)&#xa;3. Scale: 300M DAU&#xa;    - 1 post/day write, 10 reads/day per user&#xa;    - 30k reads/s, 3k writes/s (10:1)&#xa;    - Peak read ~300k/s&#xa;    - Storage: ~300GB/day post data (~110TB/yr)&#xa;    - Media bytes in S3&#xa;4. Handle celebrity users (followers &gt; threshold)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="428" y="110" width="404" height="164" as="geometry"/>
                </mxCell>
                <mxCell id="entbox" value="Core Entities" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="20" y="300" width="360" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="entPost" value="Post&#xa;  postId&#xa;  authorId&#xa;  postText&#xa;  hasMedia&#xa;  createdAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontStyle=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="32" y="328" width="160" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="entMedia" value="PostMedia&#xa;  postMediaId&#xa;  postId  (FK)&#xa;  s3Url&#xa;  status&#xa;   (pending|complete)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontStyle=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="204" y="328" width="164" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="entFollow" value="FollowRelationship&#xa;  followerId  (A, follows)        followeeId  (B, followed)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontStyle=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="32" y="458" width="336" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="apibox" value="API Design" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="420" y="300" width="420" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="apitext" value="POST /posts        (auth: JWT)&#xa;  Request:  { postText, optionalMediaContentDetails }&#xa;  Response: presigned S3 URLs (if media), OR 200 OK&#xa;&#xa;GET /posts?nextCursor=&amp;limit=     (auth: JWT)&#xa;  Response: { posts:[], nextCursor: &quot;ts_postId&quot; }&#xa;  Cursor-based paging; composite (timestamp, postId)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="428" y="328" width="404" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="archtitle" value="Architecture   —   Write (black)    Fanout-on-write (orange)    Read + merge (blue)    Media notify (red)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="580" width="960" height="30" as="geometry"/>
                </mxCell>
