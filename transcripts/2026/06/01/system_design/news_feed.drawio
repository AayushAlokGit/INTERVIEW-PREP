                    <mxGeometry x="40" y="660" width="130" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="gateway" value="API Gateway&#xa;(auth: JWT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="270" y="660" width="150" height="56" as="geometry"/>
                </mxCell>
