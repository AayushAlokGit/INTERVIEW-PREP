                <mxCell id="noteRes" value="Resilience (reads):&#xa;- circuit breaker on Redis&#xa;- replicas + promotion&#xa;- DB fallback on cache miss/fail" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
