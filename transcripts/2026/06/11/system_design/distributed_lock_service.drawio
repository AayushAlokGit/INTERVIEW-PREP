                <mxCell id="o_bF2" value="Follower B2  (... N groups for 1M writes/s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="860" y="1135" width="240" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="o_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="o_clients" target="o_lb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
