                    <mxGeometry x="480" y="1070" width="240" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="o_aF2" value="Follower A2  (5-node group: majority = 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
