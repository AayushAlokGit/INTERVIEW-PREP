                    <mxGeometry x="85" y="1050" width="170" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="o_coord" value="Lock-Service Tier (stateless)&#xa;routes key → correct Raft group&#xa;(range / consistent-hash shard map)&#xa;+ fans out watch notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1160" width="260" height="90" as="geometry"/>
                </mxCell>
