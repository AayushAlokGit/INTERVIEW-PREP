                </mxCell>
                <mxCell id="o_aRepl" value="replicate log&#xa;commit on majority" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="730" y="1040" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="o_grpB" value="Raft Group B  (key range R2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="820" y="930" width="320" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="o_bL" value="Leader B&#xa;(serializes writes,&#xa;owns fencing counter)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="860" y="975" width="240" height="60" as="geometry"/>
                </mxCell>
