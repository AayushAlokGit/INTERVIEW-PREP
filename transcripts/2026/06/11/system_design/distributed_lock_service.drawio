                <mxCell id="o_e3" value="route by key; write to leader" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontSize=10;" parent="1" source="o_coord" target="o_aL" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="o_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;fontSize=10;" parent="1" source="o_coord" target="o_bL" edge="1">
