<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="545" dy="186" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a Distributed Lock Service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="frs" value="FUNCTIONAL REQUIREMENTS&#xa;&#xa;1. Clients acquire locks on named resources (client-supplied keys)&#xa;2. Mutual exclusion: one holder per lock at a time&#xa;3. TTL on locks (auto-release on crash)&#xa;4. Fencing tokens (monotonic) for locks&#xa;5. (implied) acquire / release / renew operations" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="430" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="entities" value="CORE ENTITIES&#xa;&#xa;1. Client&#xa;2. Lock { key, fencingToken, clientId, expiry }" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="250" width="430" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="api" value="API DESIGN  (identity from auth token)&lt;br&gt;&lt;br&gt;POST /locks   (Idempotency-Key header)&lt;br&gt;  Req: { key, expiry }&lt;br&gt;  Resp 200: { fencingToken }   |   409 if already held&lt;br&gt;&lt;br&gt;PUT /locks/{key}   (renew)&lt;br&gt;  Req: { fencingToken, expiry }&lt;br&gt;  Resp: 2xx&lt;br&gt;&lt;br&gt;DELETE /locks/{key}   (release)&lt;br&gt;  Req: { fencingToken }&lt;br&gt;  Resp: status (lock released)&lt;br&gt;&lt;br&gt;// When a client tries to acquire an already held lock it will block its execution&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;and wait for lock to be acquired.&lt;br&gt;&lt;/font&gt;Blocking: client-side retry w/ wait_timeout + max retries&lt;br&gt;(or server long-poll)&lt;/div&gt;" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="480" y="250" width="470" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="nfrs" value="NON-FUNCTIONAL REQUIREMENTS&#xa;&#xa;- Consistency over availability (CP) under partition&#xa;- Mutual exclusion atomic (no 2 concurrent holders)&#xa;- Availability target 99.99% (minority partition unavailable by design)&#xa;- Latency: p99 acquire &lt; 100ms&#xa;- Scale: ~1M acquire/release ops/s avg, 10M peak&#xa;- ~1M locks held (1GB) up to 10M (10GB) @ 1KB/key" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="480" y="80" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="hld_h" value="HIGH-LEVEL DESIGN (as described)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="560" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="hld_clients" value="Distributed Clients" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="40" y="620" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="hld_r1" value="Redis Node 1&#xa;(Lua atomic SET+TTL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="360" y="600" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="hld_r2" value="Redis Node 2&#xa;(Lua atomic SET+TTL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="360" y="680" width="160" height="60" as="geometry"/>
                </mxCell>
