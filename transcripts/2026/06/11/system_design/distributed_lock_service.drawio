                <mxCell id="opt_h" value="OPTIMAL HLD (REFERENCE) — what a senior strong-hire would draw" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1a7f37;" parent="1" vertex="1">
                    <mxGeometry x="20" y="880" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="o_clients" value="Distributed Clients&#xa;(acquire / renew / release + watch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="60" y="940" width="220" height="60" as="geometry"/>
                </mxCell>
