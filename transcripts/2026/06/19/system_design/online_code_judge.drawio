        <mxCell id="e6" value="spin up sandbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="h_worker" target="h_sandbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="fetch hidden testcases / write status,result, contestScore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="h_worker" target="h_cass">
          <mxGeometry relative="1" as="geometry"/>
