          <mxGeometry x="40" y="2070" width="400" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="o_cdn" value="CDN / Read Cache&#10;(problem browse,&#10;read-heavy)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="2110" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o_push" value="Push Service&#10;(WebSocket / SSE)&#10;verdict to client&#10;(vs polling)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="2105" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_scoretopic" value="Kafka&#10;score-event topic&#10;(CDC from Submission DB)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="790" y="2105" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_lbsvc" value="Leaderboard Service&#10;scatter-gather Top-K&#10;across N shards, merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1070" y="2105" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o_redis" value="Redis Cluster&#10;SHARDED ZSET per contest&#10;ZADD O(log n) / ZREVRANGE Top-K&#10;(rebuildable cache; SoT = DB)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="2095" width="230" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_client" target="o_gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_gw" target="o_sub">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe3" value="enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_sub" target="o_kafka">
