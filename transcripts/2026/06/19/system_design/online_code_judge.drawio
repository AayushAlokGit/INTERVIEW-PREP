<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Design an Online Code Judge / Coding Contest Platform" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="frs_h" value="Functional Requirements" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="frs" value="1. Browse coding questions&#10;2. Write &amp; submit solutions in multiple languages&#10;3. Execute submissions vs hidden test cases, record verdict&#10;4. Timed contests&#10;5. Live contest leaderboard" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="98" width="560" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="nfrs_h" value="Non-Functional Requirements" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="nfrs" value="- Sandboxed, isolated, resource-restricted, secure execution&#10;- API ack p99 &lt; 200ms; execution is ASYNC&#10;- HA 99.9% (~8.6 hrs/yr)&#10;- Eventual consistency OK for submissions&#10;- Leaderboard freshness &lt; 5s during contests&#10;&#10;Scale: 10M DAU, 10 views/user/day, 5 subs/user/day&#10;- Writes ~580/s avg (50M subs/day), Reads ~1.1k/s avg&#10;- General peak 5x&#10;- CONTEST SPIKE: 50k-100k submissions/s (~100-170x)&#10;- Storage: 50M x 10KB = 500 GB/day" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="98" width="560" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="ent_h" value="Core Entities" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="ent" value="Question (id, name, tags, description)&#10;TestCase (id, questionId -&gt; FK, input, expectedOutput)  [separate entity, large I/O]&#10;User (id, name, ...)&#10;Submission (id, userId, questionId, code, language,&#10;            status: submitted|executing|failed|accepted, result, logs, createdAt)&#10;Contest (id, name, questions:[], timeLimit, contestDate)&#10;Leaderboard (contestId, ranked entries)  [MATERIALIZED]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=6;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="368" width="760" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="api_h" value="API Design (identity from JWT)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="540" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="GET /questions?cursor=&amp;limit=&amp;tags=    -&gt; [Question(id,name,tags)]  (cursor pagination)&#10;GET /questions/:id?language=          -&gt; Question(id,name,tags,description), SAMPLE TestCases[], code stub&#10;POST /questions/:id/submissions       req{code,language} + Idempotency-Key&#10;                                       -&gt; 2xx Submission(id,...) [scheduled for async execution]&#10;GET /questions/:id/submissions/:sid   -&gt; Submission(id,status,logs,result)  [client polls to terminal]&#10;POST /contests/:id/join               -&gt; 2xx joined&#10;GET /contests/:id/leaderboard?cursor=&amp;limit=  -&gt; [ {userId,name,score,rank} ]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=6;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="568" width="900" height="160" as="geometry"/>
        </mxCell>
