        </mxCell>
        <mxCell id="oe4" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_kafka" target="o_worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe5" value="run in sandbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_worker" target="o_sandbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe6" value="store code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o_sub" target="o_blob">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe7" value="fetch hidden tests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="o_worker" target="o_blob">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe8" value="write verdict + score event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o_worker" target="o_subdb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe9" value="CDC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o_subdb" target="o_scoretopic">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe10" value="apply ZADD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_scoretopic" target="o_lbsvc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o_lbsvc" target="o_redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe12" value="Top-K read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="o_lbsvc" target="o_client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe13" value="browse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="o_client" target="o_cdn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe14" value="push verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="o_worker" target="o_push">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="opt_tradeoffs" value="KEY TRADE-OFFS (component vs named alternative)&#10;&#10;- Cassandra/Dynamo for submissions  vs  Postgres: write-optimized, horizontally scalable for 100k/s spike; give up strong consistency &amp; rich queries (OK, EC acceptable).&#10;- Kafka (at-least-once)  vs  SQS/direct RPC: durable buffer that ABSORBS the contest spike + replay; give up exactly-once (handle via CAS idempotency) and op complexity.&#10;- Redis sharded ZSET for leaderboard  vs  Cassandra sorted table: O(log n) mutable-score updates + cheap Top-K; give up single-node memory limits &amp; durability (rebuild from DB on loss).&#10;- Pre-warmed sandbox pool  vs  cold container/serverless per submission: avoids 100ms-1s cold start at peak; give up idle fleet cost.&#10;- Firecracker/gVisor microVM  vs  bare Docker: stronger isolation for untrusted code; give up a little startup speed/density.&#10;- Object store for code + test I/O  vs  inline in DB row: keeps hot rows small, cheap large-blob storage; give up an extra fetch hop.&#10;- WebSocket/SSE push  vs  client polling: instant verdict, fewer wasted GETs; give up connection-management complexity." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="2300" width="1000" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="opt_deepdive" value="DEEP DIVES (specific to this system)&#10;&#10;1. Leaderboard scale-break: a popular contest = 100k members on ONE contestId. Cassandra sorted-by-score fails (mutable clustering key = delete+reinsert per update; single hot partition). FIX: shard the contest's ZSET across N Redis shards; ZADD updates locally; global Top-100 = scatter-gather top-100 per shard + merge (need 100 from EACH shard since all leaders may be on one).&#10;&#10;2. Global single-user rank (rank 4,217 / 100k) is the genuinely hard one once sharded: ZREVRANK is per-shard only. Approximate via per-shard score-histogram (count members above score X) summed across shards, + local exact rank within bucket.&#10;&#10;3. Idempotency under at-least-once: worker may run a submission twice. CAS submission status executing-&gt;accepted; only the winner applies score; ContestScore stores ABSOLUTE best per (user,problem). No double counting.&#10;&#10;4. Backpressure at 100k/s: queue decouples, so SUBMITS still succeed; verdict latency + leaderboard freshness degrade gracefully. Autoscale judge fleet on CONSUMER LAG (not CPU). Pre-warmed sandbox pool beats cold start.&#10;&#10;5. Operability / monitoring: leaderboard freshness SLA (5s) tracked as now - last_applied_score_event_ts on CDC-&gt;Redis leg; alert on breach. Watch: consumer lag, sandbox pool utilization, fleet cost at peak. Fairness: separate priority lane for contest vs practice submissions.&#10;&#10;6. Tie-breaking: equal score -&gt; earlier last-accepted timestamp (ICPC penalty model); guard against clock skew / late events." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="2300" width="1000" height="430" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
