        <mxCell id="o_blob" value="Object Store (S3 / Blob)&#10;code blobs + large hidden test I/O" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1880" width="220" height="90" as="geometry"/>
        </mxCell>
