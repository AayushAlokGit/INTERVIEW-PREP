        <mxCell id="o_sandbox" value="Sandbox Pool&#10;PRE-WARMED&#10;(Firecracker / gVisor microVMs,&#10;CPU/mem/time/net limits)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1700" width="230" height="80" as="geometry"/>
