<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Design a Stock Exchange (Order Matching System)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="frs" value="FUNCTIONAL REQUIREMENTS&#10;&#10;1. Place &amp; cancel orders (limit + market)&#10;2. Match buy &lt;-&gt; sell orders, execute trades&#10;3. Traders view their order status&#10;4. Traders view market data (current price, order book depth)&#10;&#10;Out of scope: historical price data, analysis tools" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="430" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="nfrs" value="NON-FUNCTIONAL REQUIREMENTS&#10;&#10;1. HA for accepting orders: 99.99% (~52 min/yr)&#10;2. Low latency matching: p99 &lt; 200ms&#10;3. Strong consistency for orders (no double-sell)&#10;4. No double-charging (idempotent orders)&#10;5. Near real-time market price updates&#10;&#10;Scale: 100M DAU x 5-10 orders/day = 1B orders/day&#10;  Avg ~10k orders/s | Peak ~50k orders/s (5x)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="470" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="entities" value="CORE ENTITIES&#10;&#10;User { id, name, ... }&#10;&#10;Order { id, userId, side(buy/sell), stockSymbol,&#10;        orderType(market/limit), limitPrice,&#10;        quantity, fulfilledQuantity, status, createdAt }&#10;&#10;Trade { id, buyOrderId, sellOrderId, quantity,&#10;        price (execution price), createdAt }&#10;&#10;StockSymbol { symbol, ... }" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="600" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API DESIGN   (identity from JWT auth token)&#10;&#10;POST /orders   [Idempotency-Key header]&#10;  req:  { orderType, limitPrice, quantity, stockSymbol }&#10;  resp: { id, status, fulfilledQuantity, stockSymbol, orderType }&#10;&#10;DELETE /orders/{id}        -> cancel a resting order&#10;&#10;GET /orders?cursor=&amp;limit=   (cursor pagination)&#10;  resp: [ { id, status, fulfilledQuantity, stockSymbol, orderType } ]&#10;&#10;GET /orders/{id}  -> { id, status, ... }&#10;&#10;WS  /stockSymbols (subscribe by symbol)&#10;  push: { symbol, currentPrice, book depth }   [upgraded from REST]" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="300" width="600" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="hldhdr" value="HIGH-LEVEL DESIGN (Write Path)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="590" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="apigw" value="API Gateway&#10;(auth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="210" y="660" width="120" height="60" as="geometry"/>
        </mxCell>
