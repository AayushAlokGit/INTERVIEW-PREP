        <mxCell id="e5l" value="write order" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e5">
          <mxGeometry x="-0.1" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ddhdr" value="DEEP DIVE — Matching Engine &amp; Order Book" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="960" width="560" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="Redis Cluster (in-memory order book)&#10;{stockSymbol}_buy  -&gt; ZSET sorted by price&#10;{stockSymbol}_sell -&gt; ZSET sorted by price&#10;book kept WHOLE per symbol (no time-bucket split)&#10;atomic claim via Lua script" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;boundedLbl=1;backgroundOutline=1;size=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="1010" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="me" value="Matching Engine&#10;(per stock symbol = unit of sharding)&#10;match buy &lt;-&gt; sell, price-time priority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="120" y="1020" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="consumers2" value="Kafka Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="120" y="1180" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cass2" value="Cassandra&#10;(orders + trades)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;boundedLbl=1;backgroundOutline=1;size=14;" vertex="1" parent="1">
          <mxGeometry x="980" y="1015" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="consumers2" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de1l" value="also write order to book" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="de1">
          <mxGeometry x="-0.2" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;" edge="1" parent="1" source="me" target="redis">
          <mxGeometry relative="1" as="geometry"/>
