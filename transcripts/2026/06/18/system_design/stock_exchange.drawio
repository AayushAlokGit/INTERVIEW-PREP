        </mxCell>
        <mxCell id="de3l" value="write Trade + update order status" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="de3">
          <mxGeometry x="-0.1" relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ddnotes" value="FAILOVER / RECOVERY&#10;- Engine sharded per symbol; one engine owns a symbol's whole book&#10;- In-memory matching fast enough for hot symbol (~15k/s AAPL)&#10;- Crash recovery: periodic order-book SNAPSHOT + replay Kafka&#10;  partition from last snapshot offset (bounds recovery to seconds)&#10;- Dedup on replay: skip orders already 'fulfilled' in DB&#10;- Redis down: persist to disk; reject new orders temporarily" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1170" width="580" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="optdiv" value="" style="line;strokeWidth=2;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="1380" width="1640" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="opthdr" value="OPTIMAL HLD (Reference) — what a senior strong-hire would draw" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;fontColor=#1a5e1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="1400" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="o_client" value="Client&#10;(WS + REST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
