                <mxCell id="opt_title" value="OPTIMAL HLD (Reference) — what a senior strong-hire would design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;fontColor=#cc0000;" vertex="1" parent="1">
