<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="613" dy="210" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a Webhook Delivery System" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="frs_box" value="FUNCTIONAL REQUIREMENTS&#xa;&#xa;1. Customers can subscribe to event types they want to be notified about (events produced by our system)&#xa;2. Customers can register their own URL to receive notifications on an event" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="520" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="nfrs_box" value="NON-FUNCTIONAL REQUIREMENTS&#xa;&#xa;1. At-least-once delivery of event notifications&#xa;2. Low latency: event -&gt; delivery &lt; 1s&#xa;3. High availability: 99.99% (~52 min downtime/yr)&#xa;4. Scale: 10k events/s avg, 100k/s peak&#xa;5. Fan-out = 5 subscribers/event -&gt; 50k deliveries/s avg, 500k/s peak" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="220" width="520" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="entities_box" value="CORE ENTITIES&#xa;&#xa;1. Event (id, type, status, details ...)&#xa;2. EventSubscriber (id, clientId, eventType, eventStatus)&#xa;3. Client (id, redirectUrl)&#xa;4. DeliveryAttempt (id, status, retryCount, attemptLogs, clientId, eventId, lastAttemptAt)" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="390" width="520" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="api_box" value="API DESIGN  (identity from auth headers; events ingested via internal queue, no public API)&#xa;&#xa;POST /clients&#xa;  Req: {clientName, redirectUrl}   Header: Idempotency-Key&#xa;  Res: 2xx, Client(id, ...)&#xa;&#xa;PUT /clients/:id/subscribe&#xa;  Req: {eventDetails: [{eventType, eventStatus}]}&#xa;  Res: EventSubscription(id, clientId, eventType, eventStatus)&#xa;&#xa;GET /events/:id/deliveryAttempts?clientId={}&#xa;  Res: DeliveryAttempt(id, clientId, eventId, status, attemptLogs, retryCount)&#xa;  (bounded by fan-out, no pagination)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="550" width="520" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="hld_title" value="HIGH-LEVEL DESIGN (as described)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="80" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="hld_internal" value="Internal Services&#xa;(event producers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="660" y="140" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="hld_kafka" value="Kafka&#xa;(event queue, durable,&#xa;at-least-once,&#xa;partitioned)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
                    <mxGeometry x="900" y="130" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="hld_workers" value="Workers&#xa;(stateless consumers,&#xa;horizontally scaled)&#xa;- pull event&#xa;- fetch subscribers + URLs&#xa;- POST payload&#xa;- write DeliveryAttempt&#xa;- gen idempotency key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="880" y="300" width="200" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="hld_sqldb" value="SQL DB&#xa;(clients/redirect URLs,&#xa;subscribers,&#xa;delivery attempts)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="620" y="320" width="170" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="hld_clients" value="Customer Endpoints&#xa;(external HTTP URLs,&#xa;&lt;=5 per event)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="350" width="180" height="70" as="geometry"/>
