<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Design a Distributed Cache (Redis-like) — Reference Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="800" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="frs" value="FRs&#10;- GET / SET(PUT) / DELETE&#10;- TTL / expiry&#10;Out of scope: eviction,&#10;rich data structures" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="nfrs" value="NFRs&#10;- HA 99.99% (~52 min/yr)&#10;- GET p99 &lt; 10ms&#10;- Fault tolerant&#10;- Last-write-wins (AP)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="cap" value="Capacity&#10;- 1B keys, ~11 TB&#10;- Reads ~100M/s (peak ~1B/s)&#10;- ~85 shards (storage) vs&#10;  ~1000 nodes (throughput)&#10;- THROUGHPUT-BOUND" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="230" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API (auth: JWT)&#10;GET /key -&gt; 200 {value, ttlRemaining} | 404&#10;PUT /key {value, ttl?} -&gt; 2xx (idempotent)&#10;DELETE /key -&gt; 2xx (idempotent)&#10;MGET {keys[]} -&gt; batch read" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="330" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="archtitle" value="Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="190" width="200" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="App Client&#10;+ L1 local cache&#10;(hot keys, short TTL)&#10;+ cached slot-&gt;node map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="380" width="170" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="coord" value="Cluster Coordinator (ZK/etcd-like)&#10;- authoritative slot-&gt;node map&#10;- health checks + failover&#10;  (promote replica on leader loss)&#10;- hot-key registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="240" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="ecoord" style="endArrow=open;startArrow=open;html=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="client" target="coord">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ecoordlbl" value="fetch / refresh slot map&#10;(on MOVED — OFF hot path)" style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="265" y="330" width="160" height="36" as="geometry"/>
        </mxCell>

        <!-- Shard A -->
        <mxCell id="shardA_box" value="Shard A (owns slot range)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;spacingTop=4;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="320" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="leaderA" value="LEADER A&#10;in-mem KV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="250" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="repA1" value="Replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e3;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="375" y="370" width="85" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="repA2" value="Replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e3;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="478" y="370" width="85" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="repA3" value="Replica ... x10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e3;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="581" y="370" width="85" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="diskA" value="Disk (AOF / snapshot)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="90" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="erepA1" style="endArrow=open;html=1;strokeColor=#82b366;" edge="1" parent="1" source="leaderA" target="repA1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="erepA2" style="endArrow=open;html=1;strokeColor=#82b366;" edge="1" parent="1" source="leaderA" target="repA2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="erepA3" style="endArrow=open;html=1;strokeColor=#82b366;" edge="1" parent="1" source="leaderA" target="repA3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="erepAlbl" value="async repl" style="text;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="588" y="330" width="70" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="ediskA" style="endArrow=open;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="leaderA" target="diskA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Shard B -->
        <mxCell id="shardB_box" value="Shard B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;spacingTop=4;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="220" width="320" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="leaderB" value="LEADER B&#10;in-mem KV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="250" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="repB1" value="Replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e3;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="735" y="370" width="85" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="repB2" value="Replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e3;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="838" y="370" width="85" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="repB3" value="Replica ... x10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e3;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="941" y="370" width="85" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="diskB" value="Disk (AOF / snapshot)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="480" width="90" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="erepB1" style="endArrow=open;html=1;strokeColor=#82b366;" edge="1" parent="1" source="leaderB" target="repB1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="erepB2" style="endArrow=open;html=1;strokeColor=#82b366;" edge="1" parent="1" source="leaderB" target="repB2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="erepB3" style="endArrow=open;html=1;strokeColor=#82b366;" edge="1" parent="1" source="leaderB" target="repB3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ediskB" style="endArrow=open;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="leaderB" target="diskB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="moreshards" value="... ~85 shards&#10;(1 leader + ~10 replicas each&#10;≈ 1000 nodes)" style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="1060" y="250" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- write path -->
        <mxCell id="ewriteA" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="leaderA">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ewritelbl" value="WRITES -&gt; leader only&#10;(consistent hashing on key)" style="text;html=1;fontSize=10;align=left;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="210" y="300" width="170" height="34" as="geometry"/>
        </mxCell>
        <!-- read path -->
        <mxCell id="ereadA" style="endArrow=block;html=1;strokeColor=#6c8ebf;dashed=1;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="repA1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ereadlbl" value="READS -&gt; leader OR any replica&#10;(fan-out for throughput;&#10;eventual consistency)" style="text;html=1;fontSize=10;align=left;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="205" y="430" width="180" height="46" as="geometry"/>
        </mxCell>

        <!-- mechanisms legend -->
        <mxCell id="legend" value="Key mechanisms&#10;1. Routing: client caches slot-&gt;node map; talks to coordinator only on MOVED — coordinator stays off the 100M/s hot path.&#10;2. Consistency: async replication = AP. Acked write can be lost on failover; acceptable since DB is source of truth.&#10;3. Read scaling: ~10 replicas/shard fan out reads -&gt; ~11x capacity per shard.&#10;4. Hot READ key: nodes count per-key hit-rate -&gt; coordinator. Mitigate via (a) client L1 cache [cheapest], (b) replicate key across extra shards.&#10;5. Hot WRITE key: hard ceiling (single leader). Mitigate by coalescing writes (LWW lets you drop all but latest in a window).&#10;6. Failover: coordinator detects dead leader, promotes a replica, repoints the slot.&#10;7. Operability (to monitor): replication lag, stale-read rate, failover time vs 99.99% budget, per-shard hotness, fleet cost (~1000 nodes)." style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="1030" height="180" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
