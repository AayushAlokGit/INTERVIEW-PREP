<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="736" dy="221" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a News Feed System (Twitter/Facebook-like)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="frs" value="Functional Requirements&#xa;1. User can create posts (optional media content)&#xa;2. User can follow other users&#xa;3. User can see a feed of recent posts from people/pages they follow&#xa;&#xa;Out of scope: Likes, Comments on posts" style="text;html=1;strokeColor=#000000;fillColor=#dae8fc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="nfrs" value="Non-Functional Requirements&#xa;1. Highly available post creation (99.9% ~ 8.6 hrs/yr); eventual consistency OK for posts&#xa;2. Low latency feed gen (p99 &lt; 200ms)&#xa;3. Low latency media rendering&#xa;4. 1B DAU; 1 post/day, 2 feed reads/day (10 posts each = 20 posts read/day)&#xa;   ~100k post-reads/s avg, ~10k writes/s avg; peak 3x (~300k reads/s, ~30k writes/s)&#xa;   Post ~10KB -&gt; ~10TB/day storage growth&#xa;5. Handle celebrity posts fanning out to 10M follower feeds" style="text;html=1;strokeColor=#000000;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="20" y="250" width="600" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="entities" value="Core Entities&#xa;&#xa;Post { postId (PK), authorId, text, createdAt }&#xa;User { userId (PK), name }&#xa;FollowRelationship { followRelationshipId, followerId, targetUserId }&#xa;PostMedia { s3Url, status (pending/uploaded), postId (FK) }" style="text;html=1;strokeColor=#000000;fillColor=#ffe6cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="20" y="460" width="280" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="api" value="API Design  (identity from auth headers)&#xa;&#xa;1. POST /posts&#xa;   Req: { postText, optionalMediaContentDetails }&#xa;   Headers: Idempotency-Key&#xa;   Resp: presigned S3 URLs (if media) OR 200 OK&#xa;&#xa;2. GET /posts?nextCursor=&amp;limit=&#xa;   Resp: { posts: [{ postId, authorId, authorName,&#xa;          text, mediaUrls, createdAt }], nextCursor: &#39;ts_postId&#39; }&#xa;   Cursor-based paging; composite (timestamp, postId)&#xa;&#xa;3. POST /follow/:targetUserId&#xa;   Resp: { followRelationshipId }" style="text;html=1;strokeColor=#000000;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="320" y="460" width="500" height="290" as="geometry"/>
                </mxCell>

                <mxCell id="legend" value="Legend:    &#8594; solid = synchronous request / response          &#8594; dashed = asynchronous event / response" style="text;html=1;strokeColor=#999999;fillColor=#f5f5f5;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="900" y="20" width="640" height="36" as="geometry"/>
                </mxCell>

                <mxCell id="wp_title" value="1 &#183; WRITE PATH  (create a post)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1f4e79;" parent="1" vertex="1">
                    <mxGeometry x="900" y="80" width="360" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="900" y="130" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="API Gateway&#xa;(auth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="130" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="Social Media&#xa;Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="125" width="150" height="60" as="geometry"/>
