                    <mxGeometry x="1090" y="270" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="SQL DB&#xa;(sharded on userId)&#xa;Post / PostMedia / FollowRelationship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="265" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="POST /posts" style="endArrow=classic;html=1;fontSize=11;rounded=0;" parent="1" source="c1" target="c2" edge="1">
