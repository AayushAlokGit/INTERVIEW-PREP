                <mxCell id="e3" value="presigned S3 URLs (resp)" style="endArrow=classic;html=1;fontSize=11;dashed=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c3" target="c1" edge="1">
