                    <mxGeometry x="900" y="610" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="rc2" value="Feed Service&#xa;(merge-sort by createdAt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="600" width="170" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="GET /posts" style="endArrow=classic;html=1;fontSize=11;rounded=0;" parent="1" source="rc1" target="rc2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r2a" value="read precomputed feed" style="endArrow=classic;html=1;fontSize=11;rounded=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" parent="1" source="rc2" target="redis_pre" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r2b" value="read celeb recent posts" style="endArrow=classic;html=1;fontSize=11;rounded=0;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" parent="1" source="rc2" target="redis_celeb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
