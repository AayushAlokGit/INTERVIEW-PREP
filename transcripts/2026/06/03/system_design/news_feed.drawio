                <mxCell id="e6" value="S3 event:&#xa;status &#8594; uploaded" style="endArrow=classic;html=1;fontSize=11;dashed=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" parent="1" source="c4" target="c3" edge="1">
                    <mxGeometry relative="1" as="geometry">
