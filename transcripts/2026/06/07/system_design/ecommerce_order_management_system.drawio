                <mxCell id="a_invredis" value="Redis (Inventory)&#xa;atomic Lua decrement&#xa;sharded counters (hot items)&#xa;reservation TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
