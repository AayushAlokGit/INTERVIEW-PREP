<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="866" dy="352" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="2150" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design an E-Commerce Order Management System" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="frbox" value="Functional Requirements&#xa;&#xa;1. Browse items of a catalog&#xa;2. Add items to cart for purchase&#xa;3. Place order for items and make payment&#xa;4. Order status tracking through lifecycle&#xa;5. View orders placed&#xa;&#xa;Out of scope: Analytics, Ratings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="360" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="nfrbox" value="Non-Functional Requirements&#xa;&#xa;1. Highly available browsing (99.99%)&#xa;2. Strong consistency for orders (no overselling)&#xa;3. No double charging for payments&#xa;4. Order status event -&gt; DB update &lt; 1 min&#xa;5. 100M DAU, 2 orders/day&#xa;   - Writes: 2k/s avg, 20k/s peak&#xa;   - Order reads: 100k/s peak (5 reads/order)&#xa;6. Order size 10kb -&gt; 2TB/day&#xa;7. 1M item catalog, 50 browses/user/day&#xa;   - Item reads: 50k/s avg, 500k/s peak" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="400" y="80" width="380" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="apibox" value="API Design  (identity from auth token)&#xa;&#xa;GET /items?query={}&amp;cursor={}&amp;limit={}&#xa;  -&gt; [Item(id, name, description, quantity)]  (cursor pagination)&#xa;&#xa;POST /carts          req: [Item]              -&gt; 201 {cartId}&#xa;PUT  /carts/:id      req: [{add/remove, itemId}] -&gt; 200 {cart}&#xa;&#xa;POST /orders         req: {[CartItems], Address}&#xa;  -&gt; 201 {orderId, status: PAYMENT_PENDING}&#xa;  Header: Idempotency-Key&#xa;&#xa;POST /orders/:id/payment  -&gt; 202 {paymentId} (initiates 3P charge)&#xa;GET  /orders/:id     -&gt; Order(id, status, items[], createdAt..)&#xa;GET  /orders?cursor={}&amp;limit={}  -&gt; Order(id, status, createdAt)[]&#xa;&#xa;Webhook: POST /payments/callback (3P -&gt; us, idempotent)&#xa;NOTE: order status updates are INTERNAL only (no client API)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="800" y="80" width="520" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="entlabel" value="Core Entities" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="390" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="e_user" value="User&#xa;- id&#xa;- name&#xa;- email .." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="430" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e_item" value="Item&#xa;- id&#xa;- name&#xa;- description .." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="190" y="430" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e_inv" value="ItemInventory&#xa;- itemId&#xa;- count&#xa;- version (OCC)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="360" y="430" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e_cart" value="Cart&#xa;- id&#xa;- userId (unique)&#xa;- items[]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="530" y="430" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e_resv" value="Reservation&#xa;- id&#xa;- orderId&#xa;- itemId, qty&#xa;- expiresAt&#xa;- status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="700" y="430" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e_order" value="Order&#xa;- id&#xa;- userId&#xa;- createdAt&#xa;- status: PAYMENT_PENDING | PAYMENT_DONE |&#xa;  DELIVERY_SCHEDULED | PICKED_UP |&#xa;  DELIVERED | CANCELLED&#xa;- amount" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="20" y="560" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="e_orderitem" value="OrderItem&#xa;- orderId&#xa;- itemId&#xa;- itemCount&#xa;- price" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="330" y="560" width="170" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="e_payment" value="Payment&#xa;- id&#xa;- orderId&#xa;- amount&#xa;- method&#xa;- idempotencyKey&#xa;- createdAt&#xa;- status&#xa;- recipient / sender" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="530" y="560" width="180" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="lnk_order_payment" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="e_order" target="e_payment" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lnk_order_oi" style="endArrow=classic;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" parent="1" source="e_order" target="e_orderitem" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="archlabel" value="Complete Reference Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="780" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="payidembox" value="Payment Idempotency - No Double Charge&#xa;&#xa;Status is a GUARD, not the key. Use BOTH, layered:&#xa;&#xa;1. Unique idempotency key on the Payment row [UNIQUE(idempotencyKey)] - a retried POST /orders/:id/payment collides with the existing row instead of creating a 2nd charge. This is the real dedup.&#xa;&#xa;2. Status as an ATOMIC CAS guard (not a plain read):&#xa;   UPDATE payment SET status='PROCESSING'&#xa;   WHERE id=:id AND status='PENDING';&#xa;   only one concurrent caller gets 1 row -&gt; charges; losers return the in-flight result. (avoids TOCTOU double-charge)&#xa;&#xa;3. Forward the same idempotency key to the 3P provider so the provider dedups our own retries.&#xa;&#xa;4. Webhook is at-least-once -&gt; dedupe on provider event id + apply same CAS, so a replayed callback is a no-op.&#xa;&#xa;Scope the key to ONE payment ATTEMPT (not orderId), so a legit retry-after-failure is a new charge, but a network retry of the same attempt is deduped." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1960" y="430" width="520" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="flow1box" value="FLOW 1 - Browse / Catalog (Read path)&#xa;&#xa;1. Client hits CDN for static catalog content; dynamic / cache-miss requests go to the API Gateway (auth, rate limit).&#xa;2. Gateway routes to the Catalog Service.&#xa;3. Catalog Service serves popular search queries from the Redis LFU cache; full-text search is answered by Elasticsearch.&#xa;4. Elasticsearch is kept in sync with PostgreSQL (Items = source of truth) via CDC events, so the DB stays off the hot read path.&#xa;5. Live stock (quantity) is read straight from Postgres on the item-detail call and is never cached (avoids stale stock)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="430" width="540" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="flow2box" value="FLOW 2 - Place Order + Pay (Write path)&#xa;&#xa;1. Client builds a Cart (persisted for cross-device). POST /orders with an Idempotency-Key -&gt; Order Service writes an Order in PAYMENT_PENDING.&#xa;2. Order Service calls the Inventory Service to RESERVE stock: an atomic Lua decrement in Redis (sharded counters for hot items) creates a Reservation with a TTL; changes are async-written back to PostgreSQL (Inventory = source of truth).&#xa;3. POST /orders/:id/payment -&gt; Payment Service initiates the charge with the 3P provider (Payment row keyed by idempotencyKey -&gt; no double charge).&#xa;4. The provider notifies us via an idempotent, at-least-once webhook; Payment + Order are marked paid.&#xa;5. State changes are published via the Outbox to Kafka; the Order Workflow Engine drives the long-running lifecycle (PAYMENT_DONE -&gt; DELIVERY_SCHEDULED -&gt; PICKED_UP -&gt; DELIVERED) and releases the reservation on cancel / TTL expiry.&#xa;6. Reconciliation jobs keep Redis &lt;-&gt; DB consistent; Monitoring detects oversell and consumer lag." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="640" width="540" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="a_client" value="Client (Web / Mobile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="900" y="840" width="220" height="60" as="geometry"/>
                </mxCell>
