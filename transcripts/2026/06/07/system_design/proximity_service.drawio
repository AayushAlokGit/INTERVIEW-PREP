          <mxGeometry x="320" y="845" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c_lb" value="Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="780" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c_search" value="Search Servers&#10;&#10;- in-memory geo index&#10;  (geohash precompute -&gt; quadtree,&#10;   split on threshold)&#10;- sharded by region&#10;- hot region replicated" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="720" width="350" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="c_disk" value="Local Disk&#10;Index Snapshot&#10;(recovery)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="745" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c_pg" value="PostgreSQL + PostGIS&#10;(source of truth)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="990" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c_kafka" value="Kafka&#10;(CDC events, partitioned by region)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="1010" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c_mon" value="Monitoring&#10;(consumer lag = staleness)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1010" width="240" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ce1" value="search (read)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.4;entryX=0;entryY=0.3;" edge="1" parent="1" source="c_client" target="c_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce2" value="CRUD (write)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.6;entryX=0;entryY=0.7;" edge="1" parent="1" source="c_owner" target="c_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce3" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_api" target="c_lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_lb" target="c_search">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce5" value="write listing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c_api" target="c_pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce6" value="CDC (by region)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_pg" target="c_kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce7" value="index updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c_kafka" target="c_search">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce8" value="snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_search" target="c_disk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce9" value="track lag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c_mon" target="c_kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Trade-offs text (right of Section C) -->
        <mxCell id="e_trade" value="KEY TRADE-OFFS&#10;&#10;Geo-index choice:&#10;- Geohash: simple, but FIXED cell size -&gt; dense cells huge / sparse queries span many cells; boundary discontinuities.&#10;- Quadtree: adaptive (split dense cells), but rebalancing cost on writes; held in memory.&#10;- S2 (Google) / H3 (Uber): hierarchical adaptive cells, production-grade. PICK for uneven density - used by Uber/Google for exactly this.&#10;&#10;DB / storage:&#10;- PostGIS as source of truth, kept OFF the hot read path; reads served from the in-memory / replicated geo-index to hit p99 &lt; 200ms.&#10;&#10;Consistency:&#10;- Eventual consistency is acceptable (listings change rarely) -&gt; async CDC index updates; cheap replication of hot regions.&#10;&#10;Read vs write:&#10;- Read-heavy, writes sparse -&gt; precompute/index for reads, async index build on write." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1580" y="700" width="640" height="420" as="geometry"/>
        </mxCell>

        <!-- ============ SECTION D: OPTIMAL HLD (REFERENCE) ============ -->
        <mxCell id="labelD" value="Optimal HLD (Reference)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1230" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="d_client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d_gw" value="API Gateway / LB&#10;(auth, routing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="1330" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d_search" value="Search Service&#10;(stateless, autoscaled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="1290" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_place" value="Place Mgmt Service&#10;(writes / CRUD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="1450" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_index" value="Distributed Geo-Index&#10;&#10;- adaptive cells: S2 / H3 (or quadtree)&#10;- sharded by cell, replicated&#10;- hot-cell aware" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="1270" width="340" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="d_edge" value="Regional Replicas / Edge Cache&#10;(geo-replication for global p99)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="1450" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_pg" value="PostGIS&#10;(Places - source of truth)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1590" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="d_cdc" value="CDC&#10;(Debezium)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="1605" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_kafka" value="Kafka&#10;(partitioned by cell)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1605" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_builder" value="Index Builder&#10;(consumer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1450" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d_mon" value="Monitoring&#10;(consumer lag, hot-cell detect)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1605" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="de1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="d_client" target="d_gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de2" value="nearby search" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_gw" target="d_search">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de3" value="CRUD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_gw" target="d_place">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de4" value="query covering cells" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="d_search" target="d_index">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de5" value="hot-region cached reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_search" target="d_edge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de6" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="d_place" target="d_pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de7" value="CDC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_pg" target="d_cdc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d_cdc" target="d_kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de9" value="consume (by cell)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=1;exitY=0.4;entryX=0.5;entryY=1;" edge="1" parent="1" source="d_kafka" target="d_builder">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de10" value="build / update cells" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="d_builder" target="d_index">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="de11" value="lag, hot-cell" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d_mon" target="d_kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Deep dives text (right of Section D) -->
        <mxCell id="e_deep" value="DEEP DIVES&#10;&#10;1. Density skew (the core problem):&#10;   Fixed grid fails (Manhattan ~5k vs rural ~2). Use adaptive cells (S2/H3 or quadtree); leaf = subdivide when &gt; N places. Hot-cell detection + finer split.&#10;&#10;2. Radius / boundary:&#10;   User's cell != the radius. Compute the COVERING set of cells for (location, radius) plus neighbor cells to avoid edge misses.&#10;&#10;3. Sharding &amp; cross-shard queries:&#10;   Shard the index by cell/region behind an LB. A radius near a shard boundary -&gt; scatter-gather to the relevant shards, merge by distance.&#10;&#10;4. Pagination:&#10;   Cursor over a distance-sorted, scatter-gathered set -&gt; cursor must encode (distance, id) for a stable global order, not an offset.&#10;&#10;5. Hot region:&#10;   Replicate hot cells across nodes; query service load-balances. Eventual consistency makes copies cheap. Edge/regional caches for global latency.&#10;&#10;6. Operability / recovery:&#10;   Index is rebuildable from PostGIS (SoT); local snapshot for fast restart. Staleness SLI = CDC consumer lag (alert on lag)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1650" y="1240" width="660" height="540" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
