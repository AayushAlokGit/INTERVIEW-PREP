<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="Design a Proximity Service (Find Nearby Places / Yelp)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="700" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="frbox" value="Functional Requirements&#10;&#10;1. Users query for restaurants within a radius of their location&#10;2. Business owners can CRUD restaurant listings&#10;&#10;Out of scope: restaurant menu &amp; ordering" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="nfrbox" value="Non-Functional Requirements&#10;&#10;1. Highly available querying (99.9% ~ 8.6 hrs/yr)&#10;2. Low latency querying (p99 &lt; 200ms)&#10;3. Eventual consistency OK for listing updates&#10;4. Scale: 10M DAU, 100M restaurants&#10;   - 3 queries/user/day -&gt; ~300 searches/s avg&#10;     (~3k/s peak), 10 results/query&#10;   - High read load&#10;5. Storage: 10KB/restaurant -&gt; ~1TB total&#10;6. Writes: ~1 update/day/restaurant (revisit;&#10;   realistically much sparser)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="400" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="entlabel" value="Core Entities" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e_restaurant" value="Restaurant&#10;- id&#10;- lat, lng&#10;- geohash&#10;- name&#10;- description&#10;- category&#10;- rating&#10;- ownerId" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="380" width="200" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="e_user" value="User&#10;- id&#10;- ..." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="380" width="160" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e_owner" value="Owner&#10;- id&#10;- ..." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="380" width="160" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="apibox" value="API Design  (identity from auth header)&#10;&#10;POST /restaurants&#10;  req: {name, description, lat, lng, category, ...}&#10;  Header: Idempotency-Key&#10;  -&gt; { restaurantId }&#10;&#10;GET /restaurants?lat={}&amp;lng={}&amp;query={}&amp;radius={}&amp;cursor={}&amp;limit={}&#10;  -&gt; [ Restaurant(id, name, rating, category, lat, lng, ...) ]&#10;  (cursor pagination)&#10;&#10;PUT /restaurants/:id&#10;  req: {name, description, ...}  -&gt; 2xx&#10;&#10;DELETE /restaurants/:id  -&gt; 2xx" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="340" width="520" height="280" as="geometry"/>
        </mxCell>

        <!-- ============ SECTION C: YOUR DESCRIBED ARCHITECTURE ============ -->
        <mxCell id="labelC" value="Your Described Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="690" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="c_client" value="Client (User)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c_owner" value="Owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="170" height="60" as="geometry"/>
        </mxCell>
