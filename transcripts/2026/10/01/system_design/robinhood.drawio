<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel pageWidth="2000" pageHeight="4300">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Robinhood — Retail Stock Trading App" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="fr" value="&lt;b&gt;Functional Requirements&lt;/b&gt;&lt;br&gt;1. Users can watch live prices of stocks to which they subscribe (exchange exposes a market data feed for every symbol)&lt;br&gt;2. Users can place orders for stocks they want to buy/sell; the brokerage routes orders to the exchange&lt;br&gt;3. Users can cancel placed orders while they are open (exchange streams order updates for orders placed by the brokerage)&lt;br&gt;4. Users should be able to see their order status&lt;br&gt;&lt;br&gt;&lt;b&gt;Out of scope&lt;/b&gt;&lt;br&gt;1. Payment system" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="700" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="nfr" value="&lt;b&gt;Non-Functional Requirements&lt;/b&gt;&lt;br&gt;1. Highly available system for live price updates&lt;br&gt;2. Strong consistency for orders (an order that is completely filled can't be cancelled)&lt;br&gt;3. Price point update latency p99 &amp;lt; 1s&lt;br&gt;4. 20M DAU, 5 orders/user/day -&amp;gt; 1,000 orders/s avg, peak 10x&lt;br&gt;5. 10 price updates/symbol/s x 10,000 symbols -&amp;gt; 100k price updates/s in&lt;br&gt;6. Hot symbol can have 5M subscribers -&amp;gt; high fanout&lt;br&gt;7. Peak: 5M users x 20 symbols x 10 updates/s -&amp;gt; 200 updates/s per phone, 1B price updates/s delivered&lt;br&gt;8. Order placement latency p99 &amp;lt; 250ms" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="700" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="ent" value="&lt;b&gt;Core Entities&lt;/b&gt;&lt;br&gt;1. User(id, name, email)&lt;br&gt;2. UserSymbolSubscription(userId, createdAt, symbolId, lastPriceUpdate)&lt;br&gt;3. PricePoint(symbolId, time, price)&lt;br&gt;4. StockSymbol(id, name)&lt;br&gt;5. UserPortfolioItem(userId, stockSymbol, quantityOwned)&lt;br&gt;6. Order(symbol, createdAt, quantity, type: BUY | SELL, status: OPEN | PARTIALLY_FILLED | FILLED | CANCELLED, quantityFilled, exchangeOrderId)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="700" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API Design&lt;/b&gt; (identity extracted from auth header)&lt;br&gt;&lt;br&gt;&lt;b&gt;PUT /subscribe&lt;/b&gt;&lt;br&gt;Request: {stockSymbol}&lt;br&gt;Response: UserSymbolSubscription&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /symbol&lt;/b&gt; (SSE)&lt;br&gt;One connection per client, opened at startup with all subscribed symbols; server streams price point updates for all of them; a newly subscribed symbol is added to the list&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /orders&lt;/b&gt;&lt;br&gt;Header: Idempotency-Key&lt;br&gt;Request: {symbol, quantity, type: buy | sell}&lt;br&gt;Response: Order(id, status: OPEN ...)&lt;br&gt;&lt;br&gt;&lt;b&gt;DELETE /orders/:id&lt;/b&gt;&lt;br&gt;Response: 2xx on successful cancellation of an unfilled order; appropriate messages for partially filled and completely filled orders&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /orders/:id&lt;/b&gt;&lt;br&gt;Response: Order(id, status ...)&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /orders?cursor={}&amp;amp;limit={}&lt;/b&gt;&lt;br&gt;Response: {Order[], nextCursor}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="760" y="330" width="700" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="hldT" value="High-Level Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="860" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="hClient" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hStream" value="Price Point Update Streaming Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="960" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hRedis" value="Redis Pub/Sub&lt;br&gt;(channel per symbol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="960" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hListener" value="Price Ingestion Service&lt;br&gt;(listens to exchange price stream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1140" y="960" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hExch" value="Exchange&lt;br&gt;(market data feed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1160" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hCass" value="Cassandra&lt;br&gt;(price point data)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1460" y="945" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="he1" value="GET /symbol (SSE), on app start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="hClient" target="hStream">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he2" value="price updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="hStream" target="hClient">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he3" value="subscribes to channels for relevant symbols" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hStream" target="hRedis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he4" value="2. publish price update (after DB write)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hListener" target="hRedis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he5" value="1. write price point" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hListener" target="hCass">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he6" value="price point update stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="hExch" target="hListener">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he7" value="read price points since a time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hStream" target="hCass">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="910"/>
              <mxPoint x="1540" y="910"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="oClient" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1360" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="oSvc" value="Order Service&lt;br&gt;(validates quantity of the symbol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="1360" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="oExch" value="Exchange&lt;br&gt;(order API + trade feed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1360" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="oDb" value="Order DB&lt;br&gt;(SQL, e.g. PostgreSQL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="1580" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="oWatch" value="Trade Feed Processor&lt;br&gt;(watches exchange trade feed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1595" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="oe1" value="POST /orders · DELETE /orders/:id · GET /orders/:id (polled)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="oClient" target="oSvc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe2" value="Order object / relayed cancel result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="oSvc" target="oClient">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe3" value="1. place order · cancel order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oSvc" target="oExch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe4" value="2. save order + exchangeOrderId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="oSvc" target="oDb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe5" value="trade feed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="oExch" target="oWatch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oe6" value="look up by exchangeOrderId, update order status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oWatch" target="oDb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="oNote" value="Note: client polls GET /orders/:id on the Order Service at regular intervals for the latest status" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1460" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="hNote1" value="Note: Redis pub/sub is at-most-once, so the client also polls the streaming service: GET /symbol/:id/price?since={} returns price points after a time, read from the DB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ddNote" value="&lt;b&gt;Deep Dive (as stated)&lt;/b&gt;&lt;br&gt;- Users join different instances of the streaming service; instances subscribe to a Redis pub/sub channel per stock symbol&lt;br&gt;- The publisher pushes only 100k price updates/s to a Redis pub/sub cluster; stock symbol is the hash key across the cluster&lt;br&gt;- Each price update is delivered to a few service instances, which relay it to the users connected to them&lt;br&gt;- 10k orders/s placed at peak, so about 10k order updates/s from the exchange; a SQL DB like PostgreSQL should handle that write load" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="760" y="1760" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="optLine" value="" style="line;strokeWidth=3;html=1;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="2000" width="1700" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="optT" value="Optimal Reference (what a senior strong-hire would design)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="20" y="2030" width="900" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="optEnt" value="&lt;b&gt;1. Optimal Core Entities&lt;/b&gt;&lt;br&gt;&lt;b&gt;Order&lt;/b&gt;(id, userId, clientOrderId [unique, = idempotency key, also sent to the exchange], symbol, side: BUY | SELL, type: MARKET | LIMIT, limitPrice, quantity, filledQuantity, avgFillPrice, status, exchangeOrderId, version, createdAt)&lt;br&gt;status: PENDING_SUBMIT -&amp;gt; SUBMITTED -&amp;gt; PARTIALLY_FILLED -&amp;gt; FILLED | CANCEL_REQUESTED -&amp;gt; CANCELLED | REJECTED | FAILED&lt;br&gt;&lt;b&gt;Fill&lt;/b&gt;(execId [from exchange, unique], orderId, quantity, price, time) - makes trade-feed processing idempotent&lt;br&gt;&lt;b&gt;Position&lt;/b&gt;(userId, symbol, quantity, reservedQuantity)&lt;br&gt;&lt;b&gt;Account&lt;/b&gt;(userId, buyingPower, reservedCash)&lt;br&gt;&lt;b&gt;Watchlist&lt;/b&gt;(userId, symbol)&lt;br&gt;&lt;b&gt;Quote&lt;/b&gt;(symbol, price, seq, time) - latest value per symbol; history is a separate time series&lt;br&gt;&lt;b&gt;Symbol&lt;/b&gt;(id, ticker, name)&lt;br&gt;&lt;br&gt;Missed in the round: Order had no id, no userId, no order type or limit price, no PENDING / REJECTED states; no Fill entity; nothing holding reserved quantity." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="2100" width="820" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="optApi" value="&lt;b&gt;2. Optimal API Design&lt;/b&gt;&lt;br&gt;&lt;b&gt;POST /v1/orders&lt;/b&gt; · header Idempotency-Key&lt;br&gt;Request: {symbol, side, type, quantity, limitPrice?}&lt;br&gt;Response: 201 {orderId, status: SUBMITTED} or 202 {orderId, status: PENDING_SUBMIT} when the exchange has not answered in time&lt;br&gt;Errors: 422 insufficient buying power / shares · 409 same key with a different body · 429&lt;br&gt;&lt;br&gt;&lt;b&gt;DELETE /v1/orders/{id}&lt;/b&gt;&lt;br&gt;Response: 202 {status: CANCEL_REQUESTED}; the final result (CANCELLED, or FILLED if the fill won the race) arrives on the stream. 409 if already FILLED / CANCELLED&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/orders/{id}&lt;/b&gt; -&amp;gt; Order (status, filledQuantity, version)&lt;br&gt;&lt;b&gt;GET /v1/orders?status=&amp;amp;cursor=&amp;amp;limit=&lt;/b&gt; -&amp;gt; {orders[], nextCursor} (cursor on createdAt, id)&lt;br&gt;&lt;b&gt;GET /v1/quotes?symbols=A,B,C&lt;/b&gt; -&amp;gt; latest quote per symbol; snapshot on app start and after a reconnect&lt;br&gt;&lt;br&gt;&lt;b&gt;WebSocket /v1/stream&lt;/b&gt; (one connection per device)&lt;br&gt;Client -&amp;gt; server: {subscribe: [symbols]} · {unsubscribe: [symbols]} as screens change&lt;br&gt;Server -&amp;gt; client: quote {symbol, price, seq, time} · order_update {orderId, status, filledQuantity, version}&lt;br&gt;&lt;br&gt;Missed in the round: no push channel for order status, no order type / limit price, cancel treated as synchronous, no unsubscribe, no error semantics." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="2100" width="820" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="optHldT" value="3. Optimal HLD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="2640" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="xClient" value="Clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="2980" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="xGw" value="Stream Gateways&lt;br&gt;(WebSocket, ~100 instances, ~50k connections each)&lt;br&gt;conflate to 1 frame/s per device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="2740" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xBus" value="Redis Pub/Sub&lt;br&gt;(channel per symbol,&lt;br&gt;+ channel per user for order updates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="840" y="2740" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xIngest" value="Price Ingestor&lt;br&gt;(keeps latest per symbol,&lt;br&gt;publishes first, persists async)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1280" y="2740" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xQuote" value="Latest-quote cache&lt;br&gt;(Redis)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1310" y="2900" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="xTs" value="Price history&lt;br&gt;(Cassandra / time series)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1640" y="2735" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="xExch" value="Exchange&lt;br&gt;market data feed · order API · trade feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1640" y="3180" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xOrder" value="Order Service&lt;br&gt;(stateless; validates, reserves, writes PENDING_SUBMIT first)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="3180" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xPg" value="Orders DB&lt;br&gt;(PostgreSQL, sharded by userId)&lt;br&gt;orders · fills · positions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="3400" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="xOgw" value="Exchange Order Gateway&lt;br&gt;(owns the exchange connections;&lt;br&gt;sends clientOrderId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="3180" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xTrade" value="Trade Feed Processor&lt;br&gt;(idempotent on execId; ordered per order)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="3415" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xRecon" value="Reconciler&lt;br&gt;(sweeps PENDING_SUBMIT older than a few seconds; end-of-day check against the exchange)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="3415" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="xa1" value="WebSocket: subscribe / quotes / order updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="xClient" target="xGw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="xa2" value="subscribe to symbols its devices watch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xGw" target="xBus">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
