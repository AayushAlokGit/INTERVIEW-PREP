<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="1170" dy="498" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a Notification System" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=22;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="700" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="Functional Requirements →&lt;br&gt;&lt;br&gt;1. Send notifications to users via various channels (email, push, SMS, in-app)&lt;div&gt;2. Consider user preference for notification channel&lt;/div&gt;&lt;div&gt;3. Support scheduled notifications&lt;/div&gt;&lt;div&gt;4. Internal services send notifications&lt;/div&gt;&lt;div&gt;5. Senders can track notification status&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="20" y="90" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Non-Functional Requirements →&lt;div&gt;1. At-least-once delivery of notification&lt;/div&gt;&lt;div&gt;2. Max delivery delay of 1 min from scheduled time&lt;/div&gt;&lt;div&gt;3. High availability for ingestion endpoint (99.99%)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="400" y="90" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Scale Numbers →&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;10M DAU, 5 notifications/day/user&lt;/div&gt;&lt;div&gt;50M notifications/day ≈ 580/sec avg, ~5K/sec peak&lt;/div&gt;&lt;div&gt;1 notification ≈ 1KB → 50GB data/day&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="20" y="270" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="Core Entities →&lt;br&gt;1. Notification&lt;div&gt;   id, channel, priority, status&lt;/div&gt;&lt;div&gt;   userId (INDEX), content&lt;/div&gt;&lt;div&gt;   notificationTime&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. UserPreferences&lt;/div&gt;&lt;div&gt;   id, userId (INDEX)&lt;/div&gt;&lt;div&gt;   preferredChannels&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. User&lt;/div&gt;&lt;div&gt;   id, email, mobile&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="400" y="270" width="220" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="APIs →&lt;div&gt;1. POST /notifications → returns notification_id&lt;/div&gt;&lt;div&gt;   { channel, notificationTime, userId, content, priority }&lt;/div&gt;&lt;div&gt;   Idempotency: hash(userId+channel+notificationTime+priority)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. GET /notifications/:id&lt;/div&gt;&lt;div&gt;   Returns { id, status, channel, sent_at, error_reason }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. PUT /users/:id/preferences&lt;/div&gt;&lt;div&gt;   { preferredChannels: [&quot;email&quot;, &quot;sms&quot;, &quot;in-app&quot;] }&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="670" y="90" width="450" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="Notification Service: checks UserPreferences → routes to appropriate channel queues → writes DB record (status=pending)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;" vertex="1" parent="1">
                    <mxGeometry x="270" y="530" width="620" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="Sender Services" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="590" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="270" y="590" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="Notification Service" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="510" y="590" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="SQL DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="1050" y="575" width="80" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="DB Schema:&lt;div&gt;Notification: id, channel, priority,&lt;/div&gt;&lt;div&gt;status (pending/queued/delivered/failed),&lt;/div&gt;&lt;div&gt;userId (INDEX), content, notificationTime&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;UserPreferences: id, userId (INDEX),&lt;/div&gt;&lt;div&gt;preferredChannels&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;User: id, email, mobile&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="1170" y="555" width="290" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="32" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="8" target="25">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
