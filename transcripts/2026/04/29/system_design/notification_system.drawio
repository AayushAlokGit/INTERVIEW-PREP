                <mxCell id="29" value="Queries DB for notifications WHERE status=&#39;pending&#39; AND notificationTime &lt;= now()+1min → atomically sets status=&#39;queued&#39; → pushes to SQS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;" vertex="1" parent="1">
