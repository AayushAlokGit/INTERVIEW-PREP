<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel pageWidth="1650" pageHeight="4700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Online Chess (chess.com / lichess)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="fr_h" value="Functional Requirements" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="fr_b" value="1. Users can create accounts.&lt;br&gt;2. Users can find another opponent user to play a live timed game.&lt;br&gt;3. Users can see past games (complete move history).&lt;br&gt;4. Player picks a match type (e.g. 3+2 blitz, 10+0 rapid) and is paired with someone who picked the same match type and has a similar rating.&lt;br&gt;5. Users can spectate a live game in progress and see moves as they happen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="115" width="760" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="nfr_h" value="Non-Functional Requirements" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="nfr_b" value="1. Highly available for chess matches (99.99%); lower availability acceptable for past games.&lt;br&gt;2. Eventual consistency acceptable for past games.&lt;br&gt;3. Move propagation to opponent: p99 &amp;lt; 200 ms.&lt;br&gt;4. 10M DAU, 5 games/user/day -&amp;gt; 500 games/s. Data ingress -&amp;gt; 4 MB/s.&lt;br&gt;5. A game can be streamed by up to 1M live spectators. Read heavy for move updates." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="305" width="760" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ent_h" value="Core Entities" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;id&lt;br&gt;name&lt;br&gt;rating&lt;br&gt;..." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="20" y="525" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Game&lt;/b&gt;&lt;br&gt;id&lt;br&gt;player1: userId&lt;br&gt;player2: userId&lt;br&gt;createdAt&lt;br&gt;status&lt;br&gt;winner&lt;br&gt;matchType&lt;br&gt;player clocks (remaining time)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="525" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;GameMove&lt;/b&gt;&lt;br&gt;gameId&lt;br&gt;playerId&lt;br&gt;chessPieceType&lt;br&gt;startPosition&lt;br&gt;endPosition&lt;br&gt;moveNumber" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="500" y="525" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;MatchTypeUserRating&lt;/b&gt;&lt;br&gt;matchType&lt;br&gt;userId&lt;br&gt;rating" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="525" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;GameMatchingRequest&lt;/b&gt;&lt;br&gt;userId&lt;br&gt;status (e.g. MATCHED)&lt;br&gt;matchedUser" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="980" y="525" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="api_h" value="API Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="720" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="api_b" value="NOTE: identity extracted from auth headers&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /gameMatchingRequests&lt;/b&gt; (Idempotency-Key header)&lt;br&gt;&amp;nbsp;&amp;nbsp;Request: {matchType}&lt;br&gt;&amp;nbsp;&amp;nbsp;Response: GameMatchingRequest(id, userId, matchType, status: MATCHING)&lt;br&gt;&amp;nbsp;&amp;nbsp;On match: notification sent to both players, containing the link to start the game.&lt;br&gt;&lt;br&gt;&lt;b&gt;WS /games/:id&lt;/b&gt; - WebSocket connection to the game&lt;br&gt;&amp;nbsp;&amp;nbsp;Client-&amp;gt;Server: sendMove(chessPiece, startPosition, endPosition)&lt;br&gt;&amp;nbsp;&amp;nbsp;Server-&amp;gt;Client: sendOpponentMove(chessPiece, startPosition, endPosition)&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /games?cursor={}&amp;amp;limit={}&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Response: Game(id, status, ..)[], nextCursor&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /games/:id&lt;/b&gt; - SSE connection to receive updates about game moves&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /games/:id/moves&lt;/b&gt; - full move list of a game (replay)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="20" y="755" width="760" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="hld_h" value="High-Level Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="1150" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h_client" value="Client (player)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="1260" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_lb" value="Load Balancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="240" y="1260" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_api" value="API + WebSocket layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="1260" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_mm" value="Matchmaking Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="1440" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_redis" value="Redis&lt;br&gt;(queues by match type + rating)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="460" y="1600" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_gs" value="Game Server&lt;br&gt;in-memory game state: board, current turn, clocks&lt;br&gt;processes moves sequentially" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="1440" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="h_kafka" value="Kafka&lt;br&gt;(events: rating updates, notifications, persistence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1440" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h_pg" value="PostgreSQL&lt;br&gt;users, completed games, move history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1620" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="h_fan" value="Spectator fanout layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="1760" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_wsg" value="WebSocket gateways (spectators)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="760" y="1900" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_spec" value="Spectator client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="1900" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h_rps" value="Redis Pub/Sub&lt;br&gt;(alternative: SSE push, at-most-once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1820" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="he1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="h_client" target="h_lb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="h_lb" target="h_api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="he3" value="game request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="h_api" target="h_mm">
          <mxGeometry relative="1" as="geometry"/>
