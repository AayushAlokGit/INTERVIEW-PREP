        <mxCell id="o-e8" value="find chunks (service, time, bloom)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;entryX=1;entryY=0.7;" edge="1" parent="1" source="o-querier" target="o-hot">
          <mxGeometry relative="1" as="geometry"/>
