        <mxCell id="o-e10" value="same stream, own consumer group" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o-kafka" target="o-eval">
