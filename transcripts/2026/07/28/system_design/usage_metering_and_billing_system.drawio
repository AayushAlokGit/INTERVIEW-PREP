<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="4600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="Design a Usage-Based Metering &amp; Billing System" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="AAYUSH'S DESIGN (as described)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="700" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="1. FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="94" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;div style=&quot;text-align:left&quot;&gt;1. Ingest usage events of different types (API call, compute-seconds, GB stored, etc.)&lt;br/&gt;2. Aggregate usage per customer, per type, per billing period&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(monthly, anniversary-aligned — boundaries spread across every day of the month)&lt;br/&gt;3. Apply pricing plans to produce an invoice per billing period — no over- or under-pricing&lt;br/&gt;4. Show current spend in UI&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="122" width="780" height="106" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="2. NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="256" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="&lt;div style=&quot;text-align:left&quot;&gt;1. Highly available ingestion — 99.99% (~52 min downtime/year)&lt;br/&gt;2. No undercounting or overcounting of consumption events&lt;br/&gt;3. Event → spend-UI freshness &amp;lt; 3 min&lt;br/&gt;4. Durability of consumption events&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Scale (as derived):&lt;/b&gt;&lt;br/&gt;• 50k customers × 10k events/day = 500M events/day&lt;br/&gt;• ~5k events/s average, peak 10× = ~50k events/s&lt;br/&gt;• 1 KB/event&lt;br/&gt;• Raw events retained for one billing period only (storage cost)&lt;br/&gt;• Storage stated as 150 TB/period (pre-correction figure — not restated after fix)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="284" width="780" height="196" as="geometry"/>
        </mxCell>

        <mxCell id="30" value="3. CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="508" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;ConsumptionEvent&lt;/b&gt; (type, id, customerId, time, quantity)&lt;br/&gt;&lt;b&gt;Customer&lt;/b&gt; (id)&lt;br/&gt;&lt;b&gt;BillingPeriod&lt;/b&gt; (type, customerId, billingStartDate, currentBillingCycleCount)&lt;br/&gt;&lt;b&gt;Invoice&lt;/b&gt; (id, amount, type, customerId, billingCycleCount)&lt;br/&gt;&lt;b&gt;ConsumptionType&lt;/b&gt; enum (API | Compute | Storage | ...)&lt;br/&gt;&lt;b&gt;PricingPlan&lt;/b&gt; (type, rate)&lt;br/&gt;&lt;b&gt;Cumulative-price table&lt;/b&gt; — tracks cumulative price for a billing cycle,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;updated on ingest of each event for a (customer, type)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="536" width="780" height="156" as="geometry"/>
        </mxCell>

        <mxCell id="40" value="4. API DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;i&gt;customerId extracted from auth header.&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /consumptionEvent/{type}&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Header: Idempotency-Key (prevents excessive counting)&lt;br/&gt;&amp;nbsp;&amp;nbsp;Request: { consumptionQuantity, timestamp }&lt;br/&gt;&amp;nbsp;&amp;nbsp;Response: 2xx — consumption event accepted&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /consumptionEvent/{type}/currentSpend&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Response: { priceSpend, currency }&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Batch ingestion endpoint&lt;/b&gt; (named, shape not specified)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F5F9FF;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="748" width="780" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="50" value="5. HIGH-LEVEL DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="976" width="400" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="51" value="Customers&#10;(clients)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1050" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="52" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="1050" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="53" value="Ingestion Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="1050" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="54" value="DynamoDB&#10;(write-optimised)&#10;events + current spend" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="1030" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="55" value="Cron&#10;(runs at end of each&#10;customer's billing cycle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="1210" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" edge="1" parent="1" source="51" target="52">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="57" value="POST event / GET spend" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="56">
          <mxGeometry x="-0.1" y="-1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;" edge="1" parent="1" source="52" target="53">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;fontSize=11;" edge="1" parent="1" source="53" target="54">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="60" value="write event +&#10;update current spend" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="59">
          <mxGeometry x="-0.05" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;fontSize=11;dashed=1;" edge="1" parent="1" source="54" target="53">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="62" value="read current spend" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="61">
          <mxGeometry x="0" y="14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;fontSize=11;" edge="1" parent="1" source="55" target="54">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="64" value="read consumption →&#10;generate invoice" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="63">
          <mxGeometry x="0.1" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="65" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;i&gt;Self-identified weaknesses of this design:&lt;/i&gt;&lt;br/&gt;• High load of incoming events — ensuring no event is lost or double-counted&lt;br/&gt;• No storage management — the database can grow unbounded&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1320" width="620" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="70" value="6. DEEP DIVE — revised ingest path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="1430" width="500" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="71" value="Customers&#10;(clients)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1500" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="72" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="1500" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="73" value="Ingestion Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="1500" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="74" value="Redis&#10;(dedupe)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="1485" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="75" value="Kafka&#10;(durability,&#10;at-least-once)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="1485" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="76" value="Consumer&#10;(idempotent)&#10;1-min window aggregation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1490" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="77" value="DynamoDB&#10;per-minute consumed&#10;QUANTITY (not price)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1480" width="180" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="71" target="72">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="79" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="72" target="73">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="73" target="74">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="81" value="dedupe" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="80">
          <mxGeometry x="0" y="-11" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>
        <mxCell id="82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="74" target="75">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="75" target="76">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="76" target="77">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="85" value="write 1-min&#10;quantities" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="84">
          <mxGeometry x="0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="86" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Key change:&lt;/b&gt; store consumed &lt;b&gt;quantity per minute&lt;/b&gt;, not a running price.&lt;br/&gt;Current spend = SUM(quantities over billing cycle so far) × pricing plan, computed at &lt;b&gt;read time&lt;/b&gt;.&lt;br/&gt;Invoice = same summation at billing-cycle end.&lt;br/&gt;&lt;i&gt;&quot;Complexity moved to read time and invoicing time.&quot;&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1630" width="820" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="99" value="" style="line;strokeWidth=3;html=1;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="1800" width="2400" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="100" value="OPTIMAL REFERENCE — what a senior strong-hire would design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="1830" width="1000" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="110" value="A. OPTIMAL CORE ENTITIES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="1890" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="111" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;UsageEvent&lt;/b&gt; (eventId [client-generated UUID = idempotency key], customerId, meterId,&lt;br/&gt;&amp;nbsp;&amp;nbsp;quantity, eventTime [when it happened], ingestTime [when we saw it], sourceService, dedupeScope)&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ immutable, append-only. eventTime ≠ ingestTime is what makes late events tractable.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Meter&lt;/b&gt; (meterId, name, unit, aggregationType [SUM | MAX | LAST_VALUE | UNIQUE_COUNT])&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ GB-stored is a gauge (MAX/LAST), API calls are a counter (SUM). Aayush's model assumed everything is SUM.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;UsageAggregate&lt;/b&gt; (customerId#shard, meterId, bucketGranularity [MIN|HOUR|DAY], bucketStart,&lt;br/&gt;&amp;nbsp;&amp;nbsp;quantity, eventCount, lastUpdated)&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ THE central entity. Quantity only, never price. Hierarchical granularity for cheap reads.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;PricingPlan&lt;/b&gt; (planId, &lt;b&gt;version&lt;/b&gt;, effectiveFrom, effectiveTo, currency)&lt;br/&gt;&lt;b&gt;PricingTier&lt;/b&gt; (planId, version, meterId, fromQty, toQty, unitPrice, flatFee)&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ Tiered, and VERSIONED. Without a version an old invoice cannot be reproduced.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Subscription&lt;/b&gt; (customerId, planId, planVersion, anniversaryDay, timezone)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;BillingPeriod&lt;/b&gt; (customerId, periodStart, periodEnd, &lt;b&gt;state: OPEN → CLOSING → FINALIZED&lt;/b&gt;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;gracePeriodEnds, finalizedAt)&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ A state machine, not a date pair. This is what makes late events answerable.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Invoice&lt;/b&gt; (invoiceId, customerId, periodStart, periodEnd, planVersion, lineItems[],&lt;br/&gt;&amp;nbsp;&amp;nbsp;subtotal, adjustments[], total, currency, status, aggregateSnapshotRef)&lt;br/&gt;&lt;b&gt;InvoiceLineItem&lt;/b&gt; (meterId, quantity, tierBreakdown[], amount)&lt;br/&gt;&lt;b&gt;Adjustment&lt;/b&gt; (invoiceId, reason [LATE_EVENT | CREDIT | CORRECTION], amount, sourcePeriod)&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ Invoices are immutable + reproducible; corrections are new rows, never edits.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FDF3F3;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1918" width="1180" height="450" as="geometry"/>
        </mxCell>

        <mxCell id="120" value="B. OPTIMAL API DESIGN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1890" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="121" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;i&gt;customerId from auth context. All list endpoints cursor-paginated.&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;POST /v1/usage/events:batch&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(batch is the PRIMARY contract at 50k/s)&lt;/i&gt;&lt;br/&gt;&amp;nbsp;Header: Idempotency-Key (batch-level)&lt;br/&gt;&amp;nbsp;Req:&amp;nbsp;{ events: [ { eventId, meterId, quantity, eventTime } ] }&amp;nbsp;&amp;nbsp;max 1000&lt;br/&gt;&amp;nbsp;Res 202: { accepted: 998, rejected: [ { eventId, code: DUPLICATE|BAD_METER&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|PERIOD_FINALIZED, message } ], receiptId }&lt;br/&gt;&amp;nbsp;→ per-event partial failure; a 1000-event batch must not fail atomically&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /v1/usage/current?meterId=&amp;amp;granularity=&lt;/b&gt;&lt;br/&gt;&amp;nbsp;Res: { customerId, periodStart, periodEnd, &lt;b&gt;asOf&lt;/b&gt;, &lt;b&gt;isEstimate: true&lt;/b&gt;, currency,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;meters: [ { meterId, quantity, unit, amount } ], subtotal, total }&lt;br/&gt;&amp;nbsp;→ asOf + isEstimate are mandatory: the number is &amp;lt;3 min stale BY DESIGN&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /v1/invoices?status=&amp;amp;cursor=&amp;amp;limit=&lt;/b&gt;&lt;br/&gt;&amp;nbsp;Res: { invoices: [ {invoiceId, periodStart, periodEnd, total, currency,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;status: DRAFT|FINALIZED|PAID} ], nextCursor }&lt;br/&gt;&amp;nbsp;→ cursor, not offset: invoices are appended continuously&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /v1/invoices/{invoiceId}&lt;/b&gt;&lt;br/&gt;&amp;nbsp;Res: { ...invoice, planVersion, lineItems: [ { meterId, quantity,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tierBreakdown: [ {fromQty, toQty, unitPrice, amount} ], amount } ],&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;adjustments: [...] }&lt;br/&gt;&amp;nbsp;→ tierBreakdown is the dispute-resolution field&lt;br/&gt;&lt;br/&gt;&lt;b&gt;GET /v1/usage/events?meterId=&amp;amp;from=&amp;amp;to=&amp;amp;cursor=&lt;/b&gt;&amp;nbsp;&amp;nbsp;audit / drill-down&lt;br/&gt;&lt;b&gt;GET /v1/plans/{planId}/versions/{version}&lt;/b&gt;&amp;nbsp;&amp;nbsp;reproducibility&lt;br/&gt;&lt;b&gt;POST /v1/invoices/{id}:finalize&lt;/b&gt;&amp;nbsp;&amp;nbsp;internal, idempotent&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Errors:&lt;/b&gt; 409 on idempotency-key reuse with different body;&lt;br/&gt;&amp;nbsp;422 PERIOD_FINALIZED → routed to adjustments, not dropped.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FDF3F3;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1918" width="900" height="450" as="geometry"/>
        </mxCell>

