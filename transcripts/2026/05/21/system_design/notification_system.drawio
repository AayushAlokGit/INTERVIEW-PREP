<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="4190" dy="1037" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a Notification System" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="FRs -&amp;gt;&lt;br&gt;1.Multiple channel support - Push , SMS and email&lt;div&gt;2. Track notifiation status&lt;/div&gt;&lt;div&gt;3. Support different categories of notifications with different priority&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Transaction - Medium priority (respect user preferences)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Critical - Highes priority&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;marketing - low priority (respect preferences) - batch notifications&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;4. Support user preferences for channel and categories of notifications (SMS/Push/Email)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;5. Support scheduled notifcations&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry y="90" width="450" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Scale -&amp;gt; 50M DAU&lt;br&gt;NFRs -&amp;gt;&lt;br&gt;1. Highly available notification acceptance (99.99% ~ 57 mins of downtime/year)&lt;br&gt;2. For critical notifications &amp;lt; 500ms delivery delta allowed from scheduled time , for&amp;nbsp;&lt;div&gt;lower priority delivery delta relaxed to 5s.&lt;br&gt;3. Assuming 10 notifications/user/day -&amp;gt; 500M notiifcations/day ~ 5k notifications/s on avg , in peak 10x ~50k notifs/s&lt;br&gt;4. Notification must be delivered at least once.&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="490" y="80" width="340" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Core Entities -&amp;gt;&lt;br&gt;1. Notification&lt;div&gt;2. User&lt;/div&gt;&lt;div&gt;3. UserPreferences&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="858.01" y="50" width="431.99" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font&gt;APIs -&amp;gt;&lt;br&gt;NOTE: UserId part of JWT auth headers&lt;br&gt;&lt;br&gt;1. POST /notifications -&amp;gt; Notification id. Creates a new notification&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;`notificationMessage,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;category,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;recepients[]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;channel&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;scheduledTime?(optional)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;}&lt;br&gt;Headers: idempotency-key (to prevent retries of same request creating multiple&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font&gt;notifications)&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;font&gt;2. GET /notifications/:id -&amp;gt; Recepientstatus[] , channel , category , recpienets etc&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font&gt;3. PUT /user/:id/preferences -&amp;gt; Update a users preferences&lt;/font&gt;&lt;br&gt;&lt;font&gt;{&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;allowedChannel:[]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;allowedCategories{}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font&gt;}&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="90" width="405" height="270" as="geometry"/>
                </mxCell>
