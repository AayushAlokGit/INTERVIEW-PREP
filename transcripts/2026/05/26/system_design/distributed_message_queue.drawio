<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="1431" dy="330" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a Distributed Message Queue (Kafka-like)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="FRs -&amp;gt;&lt;br&gt;1. Producers should be able to push messages to topics&lt;div&gt;2. Consumers should be able to pull messages from topics&lt;/div&gt;&lt;div&gt;3. Support topic management and configuration&lt;/div&gt;&lt;div&gt;4. Atleast once delivery guarantee&lt;/div&gt;&lt;div&gt;5. Ordering gurantee in one partition of topic.(Topic has many partitions)&lt;/div&gt;&lt;div&gt;6. Allow consumers to replay messages&amp;nbsp;&lt;/div&gt;&lt;div&gt;7. Only one consumer can connect to one partiton of topic, but there can be mltiple consumers for multiple paritions of one topic&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NFRs -&amp;gt;&lt;/div&gt;&lt;div&gt;1. Highly available (99.99 - 52.5 mints downtime/year)&lt;/div&gt;&lt;div&gt;2. Durability of events . Messages should not be lost for 3 days. Configurable replication&lt;/div&gt;&lt;div&gt;3. Low latency between publishing and availability for consumption (p99 &amp;lt; 100ms)&lt;/div&gt;&lt;div&gt;4. Handle ingestion of 1M messages/s avg and 10M msg/s peak.1M producers and 1M consumers. Avg message size = 5Kb&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry y="90" width="690" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Core Entities -&amp;gt;&lt;br&gt;1. Message&lt;div&gt;2. Topic&lt;/div&gt;&lt;div&gt;3. Partition&lt;/div&gt;&lt;div&gt;4. Consumer Group&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;APIs -&amp;gt; (Identity from JWT auth token)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1. Publish a message&lt;/b&gt;&lt;/div&gt;&lt;div&gt;POST /topics/:topicId/messages&lt;/div&gt;&lt;div&gt;Headers: Idempotency-Key: &amp;lt;uuid&amp;gt;&lt;/div&gt;&lt;div&gt;Body: { messageBody, partitionKey }&lt;/div&gt;&lt;div&gt;Response 200: { messageId, partition, offset, timestamp }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2. Consume messages (batch)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;GET /topics/:topicId/partitions/:partId/messages?offset={O}&amp;amp;limit={L}&lt;/div&gt;&lt;div&gt;Response 200: { messages: [...], nextOffset, highWatermark }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3. Create topic (control plane)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;POST /topics&lt;/div&gt;&lt;div&gt;Body: { topicName, partitionCount, replicationFactor, retentionMs }&lt;/div&gt;&lt;div&gt;Response 201: { topicId, partitions: [...] }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4. Commit consumer offset (for at-least-once)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;PUT /consumer-groups/:groupId/topics/:topicId/partitions/:partId/offset&lt;/div&gt;&lt;div&gt;Body: { offset }&lt;/div&gt;&lt;div&gt;Response 200: { committedOffset }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;5. Join consumer group / fetch partition assignment&lt;/b&gt;&lt;/div&gt;&lt;div&gt;POST /consumer-groups/:groupId/members&lt;/div&gt;&lt;div&gt;Body: { consumerId, subscribedTopics: [...] }&lt;/div&gt;&lt;div&gt;Response 200: { assignedPartitions: [...], generationId }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;6. Heartbeat (keepalive)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;POST /consumer-groups/:groupId/heartbeat&lt;/div&gt;&lt;div&gt;Body: { consumerId, generationId }&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="720" y="90" width="650" height="640" as="geometry"/>
                </mxCell>

                <mxCell id="p1" value="Producer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="780" width="120" height="50" as="geometry"/>
                </mxCell>

                <mxCell id="lb" value="Load Balancer&#10;(control plane bootstrap)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="220" y="775" width="160" height="60" as="geometry"/>
                </mxCell>

                <mxCell id="cp" value="Control Plane (ZooKeeper)&#10;• topic metadata&#10;• partition→leader map&#10;• consumer-group coordination&#10;• leader election (ISR-based)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="440" y="745" width="240" height="120" as="geometry"/>
                </mxCell>

