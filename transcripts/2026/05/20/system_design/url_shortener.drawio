<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="737" dy="376" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a URL Shortener (TinyURL / bit.ly)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="FRs -&amp;gt;&lt;br&gt;1. Shorten URL for given long URL&lt;div&gt;2. Redirect to long URL from shortURL&lt;/div&gt;&lt;div&gt;3. Optional TTL on short url&lt;/div&gt;&lt;div&gt;3. Optional custom alias for long URL support&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Out of scope -&amp;gt;&lt;br&gt;1. Analytics&lt;/div&gt;&lt;div&gt;2. URL versioning&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry y="91" width="360" height="109" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="NFRs -&amp;gt;&lt;br&gt;1. Highly available URL shortening (99.99 % ~ 8.6 hrs downtime per year)&lt;div&gt;2. Low latency redirection (p99 &amp;lt; 100ms)&lt;/div&gt;&lt;div&gt;3. Assuming 10M DAU and read:write ratio of 100:1 for 1 URL. (I URL read 100 times)&lt;/div&gt;&lt;div&gt;There would be 10M URLs/day ~ 100 writes/s and 1000M redirects/day -&amp;gt; 10k reads/s&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="395" y="80" width="465" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="Core Entities -&amp;gt;&lt;br&gt;1. shortUrl&lt;div&gt;2. User&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="10" y="260" width="250" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="APIs -&amp;gt;&lt;br&gt;&lt;br&gt;1. POST /shortUrls -&amp;gt; ShortUrl. Create a new unique short URL for a given long URL.&lt;div&gt;{&lt;/div&gt;&lt;div&gt;longUrl,&lt;/div&gt;&lt;div&gt;customAlias,&lt;/div&gt;&lt;div&gt;expirationTTL&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. GET /shortUrl/:id -&amp;gt; HTTP redirect to long url (302 so that browser caching is avoided).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="380" y="239" width="800" height="150" as="geometry"/>
                </mxCell>
