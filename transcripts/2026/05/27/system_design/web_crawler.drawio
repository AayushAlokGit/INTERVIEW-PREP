<mxfile host="65bd71144e">
    <diagram name="System Design" id="system-design">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Design a Web Crawler" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="FRs -&amp;gt;&lt;br&gt;1. Parse HTML contents of a webpage to extract its text and linked URLS&lt;div&gt;2. Store the extracted text corpus for downstream processing.&lt;/div&gt;&lt;div&gt;3. Periodically refresh the text content of crawled websites&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;Out of scope -&amp;gt;&lt;br&gt;1.Parsing Non HTML pages&lt;/div&gt;&lt;div&gt;2. Parsing media content&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NFRs -&amp;gt;&lt;br&gt;1. Durability for crawled website content - S3 storage&lt;/div&gt;&lt;div&gt;2. A delay of 1 day for freshness of contents&lt;/div&gt;&lt;div&gt;3. Incrementally discover new URLs&lt;/div&gt;&lt;div&gt;4. Assuming 1B pages crawled and each page having 100Kb raw text , total 100TB storage needed.&lt;/div&gt;&lt;div&gt;5. Support throughput of 10,000 pages/s. (assuming 10^5 seconds in a day 10^10 pages/day)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;6. Politness for a domain - Respect the rate Limits of the domains APIs,default - 1 req/s/domain&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;7. 100kb - raw text data , page size ~1Mb . So there is 10GB/s data flowing in&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="10" y="80" width="540" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="CoreEntities -&amp;gt;&lt;br&gt;1. Website (url, s3Url, lastCrawlTime, domain, status)&lt;div&gt;2. ScheduleEntry (time_bucket, shard_id, url)&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="630" y="80" width="340" height="210" as="geometry"/>
                </mxCell>

                <mxCell id="hdr" value="High-Level Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=16;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="470" width="400" height="30" as="geometry"/>
                </mxCell>

                <mxCell id="schedDb" value="Scheduler DynamoDB&#10;PK = (time_bucket, shard_id)&#10;items = URLs due at that bucket" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="40" y="540" width="180" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="scheduler" value="Scheduler Process&#10;(reads current&#10;time-bucket shards,&#10;pushes to Kafka)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="270" y="545" width="170" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="kafka" value="Kafka&#10;(partitioned by domain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="490" y="555" width="170" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="consumer" value="Crawler Consumers&#10;(consumer group)&#10;- fetch HTML&#10;- extract text + links&#10;- update status=queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="720" y="525" width="200" height="140" as="geometry"/>
                </mxCell>

                <mxCell id="ratelimiter" value="Per-Domain&#10;Rate Limiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="750" y="730" width="140" height="70" as="geometry"/>
                </mxCell>

                <mxCell id="web" value="Websites&#10;(external)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="760" y="860" width="120" height="70" as="geometry"/>
                </mxCell>

                <mxCell id="metaDb" value="URL Metadata DynamoDB&#10;(url, s3Url, lastCrawlTime,&#10; domain, status)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="1000" y="730" width="200" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="s3" value="S3&#10;(extracted text blobs)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="1000" y="540" width="180" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="redis" value="Bloom Filter&#10;(seen-URL dedup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="270" y="730" width="170" height="70" as="geometry"/>
                </mxCell>

                <mxCell id="e1" value="read current bucket&#10;(all shards)" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="schedDb" target="scheduler">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="push messages" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="scheduler" target="kafka">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="poll messages" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="kafka" target="consumer">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="e4" value="fetch (rate-limited)" style="endArrow=classic;html=1;exitX=0.4;exitY=1;entryX=0.5;entryY=0;fontSize=10;" edge="1" parent="1" source="consumer" target="ratelimiter">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ratelimiter" target="web">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="e6" value="write extracted text" style="endArrow=classic;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="consumer" target="s3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="e7" value="update metadata&#10;(s3Url, lastCrawlTime, status)" style="endArrow=classic;html=1;exitX=1;exitY=0.8;entryX=0;entryY=0.3;fontSize=10;" edge="1" parent="1" source="consumer" target="metaDb">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="e8" value="insert next-crawl entry" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="consumer" target="schedDb">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="820" y="490"/>
                            <mxPoint x="130" y="490"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <mxCell id="e9" value="dedup check" style="endArrow=classic;html=1;startArrow=classic;startFill=1;fontSize=10;" edge="1" parent="1" source="consumer" target="redis">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="820" y="950"/>
                            <mxPoint x="355" y="950"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
