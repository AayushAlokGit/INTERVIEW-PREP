<mxfile host="app.diagrams.net">
  <diagram name="System Design" id="system-design">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Design a File Storage &amp; Sync System (Dropbox-like)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="700" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Given Facts:&#10;• Files up to 5 GB; avg file ~1 MB&#10;• 100 M total users; 10 M DAU&#10;• Avg user has ~200 files, multiple devices&#10;• Mostly documents, photos, videos&#10;• Read-heavy: ~10:1 reads to writes" style="text;html=1;strokeColor=#9673A6;fillColor=#E1D5E7;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="In Scope (FRs):&#10;• Upload files (up to 5 GB)&#10;• Download files&#10;• Sync changes across user's devices&#10;• Browse files / folder structure&#10;• Delete files" style="text;html=1;strokeColor=#82B366;fillColor=#D5E8D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="70" width="320" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="Out of Scope:&#10;• Versioning / file history&#10;• Sharing with other users&#10;• Realtime collaborative editing&#10;• Full-text search&#10;• Mobile push notifications" style="text;html=1;strokeColor=#B85450;fillColor=#F8CECC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="NFRs:&#10;1. Resumable uploads and downloads&#10;2. Sync interval &lt; 1 min; eventual consistency for viewing&#10;3. Storage: ~20 PB (100M users × 200 files × 1 MB)&#10;4. Throughput: ~1k reads/s avg, ~10k reads/s peak (10x); ~115 writes/s avg&#10;5. Availability: 99.9% for uploads (~8.5 hrs downtime/year)&#10;6. Durability: 11 nines (e.g. backed by S3)&#10;7. Latency: list folder p99 &lt; 500 ms; downloads bandwidth-bound" style="text;html=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="210" width="1040" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="Data Model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="390" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="File&#10;─────────&#10;fileBytes (stored in S3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="420" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="FileMetadata (SQL DB)&#10;─────────&#10;id&#10;name&#10;s3Url&#10;status&#10;chunks: []&#10;isDeleted&#10;updatedAt&#10;createdAt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="420" width="200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="Folder&#10;─────────&#10;id&#10;files: []&#10;name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="User&#10;─────────&#10;id&#10;name&#10;email" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="420" width="200" height="110" as="geometry"/>
